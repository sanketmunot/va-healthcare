{% comment %}
  ============================================================
  SIMILAR PRODUCTS
  - Maximum 5 products
  - Uses the first collection of the current product
  - Excludes the current product
  - Desktop: 5 cards
  - Mobile: horizontal swipe
  ============================================================
{% endcomment %}

{% assign related_collection = product.collections.first %}
{% assign related_count = 0 %}

{% if related_collection != blank and related_collection.products_count > 1 %}

  <section
    class="luxury-related"
    data-related-section
    aria-label="Similar products"
  >

    <div class="luxury-related__container">

      <!-- HEADER -->
      <div class="luxury-related__header">

        <div class="luxury-related__heading-group">

          <span class="luxury-related__eyebrow">
            {{ section.settings.related_eyebrow | default: 'You may also like' }}
          </span>

          <h2 class="luxury-related__title">
            {{ section.settings.related_title | default: 'Similar products' }}
          </h2>

        </div>

        <a
          href="{{ related_collection.url }}"
          class="luxury-related__view-all"
        >
          <span>
            {{ section.settings.related_view_all_label | default: 'View collection' }}
          </span>

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12h14"/>
            <path d="m13 6 6 6-6 6"/>
          </svg>
        </a>

      </div>


      <!-- PRODUCTS -->
      <div class="luxury-related__viewport">

        <div class="luxury-related__grid">

          {% for related_product in related_collection.products %}

            {% if related_product.id != product.id %}

              {% assign related_count = related_count | plus: 1 %}

              <article class="luxury-related__card">

                <a
                  href="{{ related_product.url }}"
                  class="luxury-related__card-link"
                  aria-label="View {{ related_product.title | escape }}"
                >

                  <!-- IMAGE -->
                  <div class="luxury-related__image-wrap">

                    {% if related_product.featured_image != blank %}

                      {{
                        related_product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '320, 480, 640, 800',
                          sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 78vw',
                          class: 'luxury-related__image',
                          alt: related_product.featured_image.alt
                            | default: related_product.title
                      }}

                    {% else %}

                      <div class="luxury-related__image-placeholder">
                        <span>No image</span>
                      </div>

                    {% endif %}


                    <!-- SALE BADGE -->
                    {% assign related_variant = related_product.selected_or_first_available_variant %}

                    {% if related_variant.compare_at_price > related_variant.price %}

                      <span class="luxury-related__badge">
                        Sale
                      </span>

                    {% endif %}


                    <!-- QUICK ARROW -->
                    <span
                      class="luxury-related__arrow"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 24 24"
                      >
                        <path d="M5 12h14"/>
                        <path d="m13 6 6 6-6 6"/>
                      </svg>
                    </span>

                  </div>


                  <!-- CONTENT -->
                  <div class="luxury-related__content">

                    {% if related_product.vendor != blank %}

                      <span class="luxury-related__vendor">
                        {{ related_product.vendor }}
                      </span>

                    {% endif %}


                    <h3 class="luxury-related__product-title">
                      {{ related_product.title }}
                    </h3>


                    <div class="luxury-related__price">

                      <span class="luxury-related__price-current">
                        {{ related_variant.price | money }}
                      </span>

                      {% if related_variant.compare_at_price > related_variant.price %}

                        <span class="luxury-related__price-compare">
                          {{ related_variant.compare_at_price | money }}
                        </span>

                      {% endif %}

                    </div>

                  </div>

                </a>

              </article>


              {% if related_count == 5 %}
                {% break %}
              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      </div>


      <!-- MOBILE SCROLL HINT -->
      {% if related_count > 1 %}

        <div class="luxury-related__mobile-hint">

          <span>
            Swipe to explore
          </span>

          <span class="luxury-related__mobile-line">
            <span></span>
          </span>

        </div>

      {% endif %}

    </div>

  </section>

{% endif %}


{% stylesheet %}

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap');

.luxury-product {

  --lp-black: color-mix(in srgb, var(--color-foreground) 70%, var(--color-accent));
  --lp-dark: color-mix(in srgb, var(--color-foreground) 80%, var(--color-accent));
  --lp-text: var(--color-foreground);
  --lp-muted: var(--color-muted);
  --lp-soft: var(--color-background);
  --lp-border: var(--color-border);
  --lp-white: var(--color-background);
  --lp-accent: var(--color-accent);
  --lp-accent-deep: color-mix(in srgb, var(--color-foreground) 75%, var(--color-accent));

  color: var(--lp-text);

  padding-top: var(--lp-top-space);
  padding-bottom: var(--lp-bottom-space);

  background: var(--lp-white);

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

  -webkit-font-smoothing: antialiased;
}


.luxury-product *,
.luxury-product *::before,
.luxury-product *::after {
  box-sizing: border-box;
}


.luxury-product button,
.luxury-product input,
.luxury-product select {
  font: inherit;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}


.luxury-product button {
  border: 0;
}


.luxury-product__container {
  width: min(1480px, calc(100% - 80px));
  margin-inline: auto;
}


/* ============================================================
   LAYOUT
============================================================ */

.luxury-product__layout {

  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(400px, .75fr);

  gap: clamp(55px, 7vw, 110px);

  align-items: start;
}


/* ============================================================
   GALLERY
============================================================ */

.luxury-product__gallery {
  min-width: 0;
}


.luxury-product__viewer {

  position: relative;

  overflow: hidden;

  background: var(--lp-soft);

  border-radius: var(--lp-radius);

  isolation: isolate;
}


.luxury-product__slides {

  position: relative;

  width: 100%;

  aspect-ratio: 1 / 1.12;
}


.luxury-product__slide {

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.025);

  transition:
    opacity .35s ease,
    transform .6s cubic-bezier(.2,.65,.2,1),
    visibility .35s ease;
}


.luxury-product__slide.is-active {

  opacity: 1;

  visibility: visible;

  transform: scale(1);

  z-index: 2;
}


.luxury-product__image,
.luxury-product__video,
.luxury-product__slide video,
.luxury-product__slide iframe,
.luxury-product__slide model-viewer {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* ============================================================
   GALLERY COUNTER
============================================================ */

.luxury-product__counter {

  position: absolute;

  z-index: 10;

  top: 20px;
  left: 20px;

  display: flex;

  align-items: center;

  gap: 6px;

  padding: 8px 12px;

  color: var(--color-surface);

  background: color-mix(in srgb, var(--color-foreground) 72%, transparent);

  border-radius: 999px;

  font-family: 'IBM Plex Mono', monospace;

  font-size: 10px;

  letter-spacing: .04em;

  backdrop-filter: blur(12px);
}


.luxury-product__counter-separator {
  opacity: .45;
}


/* ============================================================
   ZOOM
============================================================ */

.luxury-product__zoom {

  position: absolute;

  z-index: 10;

  right: 20px;
  bottom: 20px;

  display: flex;

  align-items: center;

  gap: 8px;

  padding: 10px 14px;

  color: var(--lp-black);

  background: color-mix(in srgb, var(--color-background) 95%, transparent);

  border-radius: 999px;

  cursor: pointer;

  font-size: 11px;

  font-weight: 600;

  letter-spacing: .01em;

  box-shadow: 0 8px 30px var(--color-shadow-medium);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background-color .2s ease;
}


.luxury-product__zoom svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__zoom:hover {

  transform: translateY(-2px);

  background: var(--color-surface);

  box-shadow:
    0 12px 35px var(--color-shadow-medium);
}


/* ============================================================
   NAVIGATION
============================================================ */

.luxury-product__navigation {

  position: absolute;

  z-index: 10;

  top: 50%;

  width: 46px;
  height: 46px;

  display: grid;

  place-items: center;

  transform: translateY(-50%);

  color: var(--lp-black);

  background: color-mix(in srgb, var(--color-background) 96%, transparent);

  border-radius: 50%;

  cursor: pointer;

  opacity: 0;

  box-shadow: 0 8px 25px var(--color-shadow-medium);

  transition:
    opacity .2s ease,
    transform .2s ease,
    background-color .2s ease;
}


.luxury-product__viewer:hover
.luxury-product__navigation {

  opacity: 1;
}


.luxury-product__navigation:hover {

  background: var(--color-surface);

  transform:
    translateY(-50%)
    scale(1.08);
}


.luxury-product__navigation--prev {
  left: 18px;
}


.luxury-product__navigation--next {
  right: 18px;
}


.luxury-product__navigation svg {

  width: 18px;
  height: 18px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.5;
}


/* ============================================================
   THUMBNAILS
============================================================ */

.luxury-product__thumbnail-wrap {

  margin-top: 16px;
}


.luxury-product__thumbnails {

  display: flex;

  gap: 9px;

  overflow-x: auto;

  padding: 2px;

  scrollbar-width: none;
}


.luxury-product__thumbnails::-webkit-scrollbar {
  display: none;
}


.luxury-product__thumbnail {

  position: relative;

  flex: 0 0 74px;

  width: 74px;
  height: 74px;

  padding: 0;

  overflow: hidden;

  background: var(--lp-soft);

  border-radius: 7px;

  border: 1px solid transparent;

  cursor: pointer;

  opacity: .55;

  transition:
    opacity .2s ease,
    border-color .2s ease,
    transform .2s ease;
}


.luxury-product__thumbnail:hover {

  opacity: .85;

  transform: translateY(-1px);
}


.luxury-product__thumbnail.is-active {

  opacity: 1;

  border-color: var(--lp-accent);
}


.luxury-product__thumbnail-image {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


.luxury-product__thumbnail-icon {

  width: 100%;
  height: 100%;

  display: grid;

  place-items: center;
}


.luxury-product__thumbnail-icon svg {

  width: 20px;
  height: 20px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


/* ============================================================
   PRODUCT INFORMATION
============================================================ */

.luxury-product__details {
  min-width: 0;
  position: relative;
}


.luxury-product__details::before {

  content: '';

  position: absolute;

  top: 6px;
  bottom: 6px;
  left: -55px;

  width: 1px;

  background: var(--lp-border);
}


.luxury-product__details-inner {

  position: sticky;

  top: 80px;

  max-width: 570px;
}


.luxury-product__vendor {

  margin-bottom: 15px;

  color: var(--lp-accent);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 10px;

  font-weight: 500;

  letter-spacing: .18em;

  text-transform: uppercase;
}


.luxury-product__title {

  margin: 0;

  max-width: 550px;

  color: var(--lp-black);

  font-family: 'Fraunces', Georgia, serif;

  font-size: clamp(34px, 3.6vw, 54px);

  line-height: 1.05;

  letter-spacing: -.02em;

  font-weight: 500;
}


/* ============================================================
   RATING
============================================================ */

.luxury-product__rating {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 18px;

  color: var(--lp-muted);

  font-size: 11px;
}


.luxury-product__stars {

  display: flex;

  gap: 2px;

  color: var(--lp-accent);
}


.luxury-product__stars svg {

  width: 13px;
  height: 13px;

  fill: currentColor;
}


/* ============================================================
   PRICE
============================================================ */

.luxury-product__price {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 24px;

  padding-top: 20px;

  border-top: 1px solid var(--lp-border);
}


.luxury-product__price-current {

  color: var(--lp-black);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 19px;

  font-weight: 500;

  letter-spacing: -.01em;
}


.luxury-product__price-compare {

  color: var(--color-muted);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 13px;

  text-decoration: line-through;
}


.luxury-product__sale {

  padding: 5px 9px;

  color: var(--color-surface);

  background: var(--lp-accent);

  border-radius: 999px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .08em;

  text-transform: uppercase;
}


/* ============================================================
   DESCRIPTION
============================================================ */

.luxury-product__description {

  margin-top: 23px;

  color: var(--color-muted);

  font-size: 14px;

  line-height: 1.8;
}


.luxury-product__description p:first-child {
  margin-top: 0;
}


.luxury-product__description p:last-child {
  margin-bottom: 0;
}


/* ============================================================
   FORM
============================================================ */

.luxury-product__form {

  margin-top: 34px;
}


/* ============================================================
   OPTIONS
============================================================ */

.luxury-product__options {

  display: grid;

  gap: 27px;

  margin-bottom: 30px;
}


.luxury-product__option {

  padding: 0;

  margin: 0;

  border: 0;
}


.luxury-product__option-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  width: 100%;
  margin: 0 0 14px;
  padding: 0;
  font-size: 13px;
  line-height: 1.4;
  font-weight: 600;
}

.luxury-product__option-name {
  color: var(--lp-black);
  letter-spacing: 0;
}

.luxury-product__option-selected {
  color: var(--lp-muted);
  font-size: 13px;
  font-weight: 400;
  text-align: right;
}


.luxury-product__option-values {

  display: flex;

  flex-wrap: wrap;

  gap: 8px;
}


.luxury-product__choice {

  position: relative;

  cursor: pointer;
}


.luxury-product__choice input {

  position: absolute;

  width: 1px;
  height: 1px;

  opacity: 0;

  pointer-events: none;
}


.luxury-product__choice span {
  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 46px;
  min-width: 76px;

  padding: 11px 18px;

  color: var(--color-foreground);
  background: var(--color-surface);

  text-align: center;

  border: 1px solid var(--lp-border);
  border-radius: 6px;

  font-size: 14px;
  line-height: 1.2;
  font-weight: 500;

  transition:
    color .2s ease,
    background-color .2s ease,
    border-color .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}

.luxury-product__choice:hover:not(.is-disabled) span {
  border-color: var(--lp-accent);
  transform: translateY(-1px);
}

.luxury-product__choice input:checked + span {
  color: var(--color-surface);
  background: var(--lp-black);
  border-color: var(--lp-black);

  box-shadow:
    0 4px 14px var(--color-shadow-medium);
}


.luxury-product__choice.is-disabled {

  opacity: .32;

  cursor: not-allowed;
}


.luxury-product__choice.is-disabled span {

  text-decoration: line-through;
}


/* ============================================================
   HIDDEN SELECT
============================================================ */

.luxury-product__variant-select {
  display: none;
}


/* ============================================================
   PURCHASE MODE TOGGLE (Full vs Partial)
============================================================ */

.luxury-product__mode-toggle {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 30px;
  margin-bottom: 18px;
}

.luxury-product__mode-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 118px;
  padding: 18px 14px 16px;
  text-align: center;
  color: var(--lp-black);
  background: var(--color-surface);
  border: 1px solid var(--lp-border);
  border-radius: 10px;
  cursor: pointer;
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    background-color .2s ease;
}

.luxury-product__mode-card:hover {
  border-color: color-mix(in srgb, var(--lp-accent) 45%, var(--lp-border));
}

.luxury-product__mode-card.is-active {
  border: 2px solid var(--lp-accent-deep);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--lp-accent-deep) 12%, transparent);
}

.luxury-product__mode-radio {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border: 2px solid color-mix(in srgb, var(--lp-black) 18%, var(--lp-border));
  border-radius: 50%;
  background: var(--color-surface);
  transition: border-color .2s ease;
}

.luxury-product__mode-radio-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: transparent;
  transform: scale(0);
  transition:
    transform .2s ease,
    background-color .2s ease;
}

.luxury-product__mode-card.is-active .luxury-product__mode-radio {
  border-color: var(--lp-accent-deep);
}

.luxury-product__mode-card.is-active .luxury-product__mode-radio-dot {
  background: var(--lp-accent-deep);
  transform: scale(1);
}

.luxury-product__mode-title {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.25;
  color: var(--lp-black);
}

.luxury-product__mode-subtitle {
  font-size: 13px;
  font-weight: 400;
  line-height: 1.35;
  color: color-mix(in srgb, var(--lp-black) 52%, var(--color-muted));
}


/* ============================================================
   PURCHASE AREA
============================================================ */

.luxury-product__purchase-mode {
  display: grid;
  gap: 9px;
}

.luxury-product__purchase-buy {
  display: grid;
  gap: 9px;
}

.luxury-product__purchase {

  display: grid;

  grid-template-columns: 126px minmax(0,1fr);

  gap: 9px;
}


/* ============================================================
   QUANTITY
============================================================ */

.luxury-product__quantity {
  display: grid;

  grid-template-columns: 38px 1fr 38px;

  min-height: 58px;

  overflow: hidden;

  background: var(--color-surface);

  border: 1px solid var(--lp-border);
  border-radius: 6px;
}

.luxury-product__quantity button {
  display: grid;
  place-items: center;

  color: var(--lp-black);
  background: transparent;

  cursor: pointer;

  transition:
    background-color .2s ease;
}

.luxury-product__quantity button:hover {
  background: var(--lp-soft);
}

.luxury-product__quantity svg {

  width: 14px;
  height: 14px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__quantity input {

  width: 100%;

  min-width: 0;

  padding: 0;

  border: 0;

  outline: 0;

  background: transparent;

  text-align: center;

  color: var(--color-foreground);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 12px;

  appearance: textfield;
}


.luxury-product__quantity input::-webkit-inner-spin-button,
.luxury-product__quantity input::-webkit-outer-spin-button {

  appearance: none;

  margin: 0;
}


/* ============================================================
   ADD TO CART
============================================================ */

.luxury-product__add {
  position: relative;

  min-height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  padding: 0 28px;

  color: var(--color-surface);
  background: var(--lp-black);

  border-radius: 6px;

  cursor: pointer;

  font-size: 14px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0;

  overflow: hidden;

  transition:
    background-color .25s ease,
    transform .25s ease,
    box-shadow .25s ease;
}

.luxury-product__add::before {
  content: '';

  position: absolute;
  inset: 0;

  background: linear-gradient(
    110deg,
    transparent 20%,
    var(--color-glass-bg) 50%,
    transparent 80%
  );

  transform: translateX(-100%);

  transition: transform .65s ease;
}

.luxury-product__add:hover:not(:disabled)::before {
  transform: translateX(100%);
}

.luxury-product__add span,
.luxury-product__add svg {
  position: relative;
  z-index: 1;
}


.luxury-product__add svg {

  width: 16px;
  height: 16px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;

  transition: transform .2s ease;
}


.luxury-product__add:hover:not(:disabled) {

  background: var(--lp-accent-deep);

  transform: translateY(-1px);

  box-shadow:
    0 10px 30px var(--color-shadow-medium);
}


.luxury-product__add:hover:not(:disabled) svg {

  transform: translateX(3px);
}


.luxury-product__add:disabled {

  opacity: .45;

  cursor: not-allowed;
}


/* ============================================================
   DYNAMIC CHECKOUT
============================================================ */

.luxury-product__dynamic-checkout {

  margin-top: 9px;
}
.luxury-product__dynamic-checkout .shopify-payment-button__button {
  display: flex;
}

.luxury-product__dynamic-checkout .shopify-payment-button__button--unbranded {
  min-height: 58px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: 8px !important;
  overflow: hidden;
}

.luxury-product__dynamic-checkout iframe {
  border-radius: 8px !important;
}


/* ============================================================
   PARTIAL PAYMENT / BOOK NOW
============================================================ */

.luxury-product__partial-summary {

  display: grid;

  gap: 10px;

  padding: 16px 18px;

  background: var(--lp-soft);

  border: 1px solid var(--lp-border);

  border-radius: 8px;
}

.luxury-product__partial-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  font-size: 13px;
}

.luxury-product__partial-row span {

  color: var(--lp-muted);
}

.luxury-product__partial-row strong {

  color: var(--lp-black);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 14px;

  font-weight: 500;
}

.luxury-product__partial-row--muted strong {

  color: var(--lp-muted);

  font-size: 12.5px;
}

.luxury-product__partial-note {

  margin: 10px 0 0;

  color: var(--lp-muted);

  font-size: 11.5px;

  line-height: 1.6;
}

.luxury-product__book-now {

  width: 100%;

  min-height: 58px;

  margin-top: 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 0 28px;

  color: var(--color-surface);

  background: var(--lp-accent);

  border-radius: 6px;

  cursor: pointer;

  font-size: 14px;

  font-weight: 600;

  transition:
    background-color .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}

.luxury-product__book-now:hover {

  background: var(--lp-accent-deep);

  transform: translateY(-1px);

  box-shadow: 0 10px 30px var(--color-shadow-medium);
}

.luxury-product__lead-form {

  margin-top: 14px;

  padding: 18px;

  background: var(--lp-soft);

  border: 1px solid var(--lp-border);

  border-radius: 8px;

  display: grid;

  gap: 12px;

  animation: notify-expand .3s ease;
}

.luxury-product__lead-text {

  margin: 0;

  font-size: 12px;

  color: var(--lp-muted);

  line-height: 1.6;
}

.luxury-product__lead-fields {

  display: grid;

  gap: 8px;
}

.luxury-product__lead-fields input {

  width: 100%;

  min-height: 48px;

  padding: 0 14px;

  border: 1px solid var(--lp-border);

  border-radius: 6px;

  font-size: 13px;

  color: var(--color-foreground);

  background: var(--color-surface);

  transition: border-color .2s ease;
}

.luxury-product__lead-fields input:focus-visible {

  outline: none;

  border-color: var(--lp-accent);
}

.luxury-product__lead-error,
.luxury-product__partial-error {

  margin: 0;

  font-size: 11px;

  color: var(--color-error-border);
}


/* ============================================================
   PARTIAL PAYMENT FLOW MODAL
============================================================ */

.luxury-product__partial-modal {

  position: fixed;

  z-index: 99998;

  inset: 0;

  display: grid;

  place-items: center;

  padding: 1rem;

  background: color-mix(in srgb, var(--color-foreground) 55%, transparent);

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 0.25s ease,
    visibility 0.25s ease;
}

.luxury-product__partial-modal.is-open {

  opacity: 1;

  visibility: visible;
}

.luxury-product__partial-modal-dialog {

  position: relative;

  width: min(480px, 100%);

  max-height: min(90vh, 680px);

  overflow: auto;

  padding: 1.5rem;

  color: var(--color-foreground);

  background: var(--color-background);

  border: 1px solid var(--color-border);

  border-radius: var(--lp-radius, 12px);

  box-shadow: 0 20px 50px var(--color-shadow-medium);
}

.luxury-product__partial-modal-close {

  position: absolute;

  top: 0.75rem;

  right: 0.75rem;

  z-index: 1;

  width: 40px;
  height: 40px;

  display: grid;

  place-items: center;

  color: var(--color-foreground);

  background: color-mix(in srgb, var(--color-accent) 8%, var(--color-background));

  border: 1px solid var(--color-border);

  border-radius: 50%;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.luxury-product__partial-modal-close:hover {

  color: var(--color-accent-contrast, var(--color-background));

  background: var(--color-accent);

  transform: scale(1.04);
}

.luxury-product__partial-modal-close svg {

  width: 18px;
  height: 18px;

  stroke: currentColor;

  stroke-width: 1.8;

  fill: none;
}

.luxury-product__partial-modal-header {

  padding-right: 2.5rem;
}

.luxury-product__partial-modal-eyebrow {

  display: block;

  margin-bottom: 0.35rem;

  font-size: 0.72rem;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  color: var(--color-muted);
}

.luxury-product__partial-modal-title {

  margin: 0 0 0.65rem;

  font-size: clamp(1.15rem, 2.5vw, 1.35rem);

  line-height: 1.25;
}

.luxury-product__partial-modal-lead {

  margin: 0;

  font-size: 0.92rem;

  line-height: 1.55;

  color: var(--color-muted);
}

.luxury-product__partial-modal-flow {

  display: grid;

  gap: 0;

  margin: 1.25rem 0 1rem;

  padding: 1rem;

  background: color-mix(in srgb, var(--color-accent) 6%, var(--color-background));

  border: 1px solid var(--color-border);

  border-radius: 8px;
}

.luxury-product__partial-modal-step {

  display: grid;

  grid-template-columns: auto 1fr;

  gap: 0.85rem;

  align-items: start;
}

.luxury-product__partial-modal-step-badge {

  display: grid;

  place-items: center;

  width: 28px;
  height: 28px;

  font-size: 0.78rem;

  font-weight: 600;

  color: var(--color-accent-contrast, var(--color-background));

  background: var(--color-accent);

  border-radius: 50%;
}

.luxury-product__partial-modal-step-body {

  display: grid;

  gap: 0.15rem;
}

.luxury-product__partial-modal-step-label {

  font-size: 0.78rem;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  color: var(--color-muted);
}

.luxury-product__partial-modal-step-body strong {

  font-family: 'IBM Plex Mono', monospace;

  font-size: 1.05rem;

  font-weight: 500;

  color: var(--lp-black);
}

.luxury-product__partial-modal-step-body small {

  font-size: 0.78rem;

  color: var(--color-muted);
}

.luxury-product__partial-modal-connector {

  width: 2px;
  height: 18px;

  margin-left: 13px;

  background: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
}

.luxury-product__partial-modal-note {

  margin: 0 0 1rem;

  font-size: 0.82rem;

  line-height: 1.5;

  color: var(--color-muted);
}

.luxury-product__partial-modal-continue {

  width: 100%;

  padding: 0.9rem 1rem;

  font-size: 0.92rem;

  font-weight: 600;

  color: var(--color-accent-contrast, var(--color-background));

  background: var(--color-accent);

  border: none;

  border-radius: 8px;

  cursor: pointer;

  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.luxury-product__partial-modal-continue:hover {

  opacity: 0.92;

  transform: translateY(-1px);
}


.luxury-product__lead-submit {

  min-height: 48px;

  padding: 0 24px;

  color: var(--color-surface);

  background: var(--lp-black);

  border-radius: 6px;

  font-size: 13px;

  font-weight: 600;

  cursor: pointer;

  transition: background-color .2s ease, transform .2s ease;
}

.luxury-product__lead-submit:hover {

  background: var(--lp-accent-deep);

  transform: translateY(-1px);
}

.luxury-product__lead-submit:disabled {

  opacity: .5;

  cursor: not-allowed;

  transform: none;
}

.luxury-product__lead-success {

  margin: 0;

  font-size: 12px;

  font-weight: 600;

  color: var(--color-accent);
}


/* ============================================================
   NOTIFY ME
============================================================ */

.is-hidden {
  display: none !important;
}

.luxury-product__notify-toggle {
  width: 100%;
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 28px;
  color: var(--lp-black);
  background: var(--color-surface);
  border: 1px solid var(--lp-black);
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background-color .2s ease,
    color .2s ease,
    transform .2s ease;
}

.luxury-product__notify-toggle:hover {
  background: var(--lp-black);
  color: var(--color-surface);
  transform: translateY(-1px);
}

.luxury-product__notify-toggle svg {
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.4;
}

.luxury-product__notify-form {
  margin-top: 14px;
  padding: 18px;
  background: var(--lp-soft);
  border: 1px solid var(--lp-border);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  animation: notify-expand .3s ease;
}

@keyframes notify-expand {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.luxury-product__notify-text {
  margin: 0;
  font-size: 12px;
  color: var(--lp-muted);
  line-height: 1.6;
}

.luxury-product__notify-fields {
  display: grid;
  gap: 8px;
}

.luxury-product__notify-fields input {
  width: 100%;
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid var(--lp-border);
  border-radius: 6px;
  font-size: 13px;
  color: var(--color-foreground);
  background: var(--color-surface);
  transition: border-color .2s ease;
}

.luxury-product__notify-fields input:focus-visible {
  outline: none;
  border-color: var(--lp-accent);
}

.luxury-product__notify-error {
  margin: 0;
  font-size: 11px;
  color: var(--color-error-border);
}

.luxury-product__notify-submit {
  min-height: 48px;
  padding: 0 24px;
  color: var(--color-surface);
  background: var(--lp-black);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color .2s ease, transform .2s ease;
}

.luxury-product__notify-submit:hover {
  background: var(--lp-accent-deep);
  transform: translateY(-1px);
}

.luxury-product__notify-submit:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none;
}

.luxury-product__notify-success {
  margin: 0;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-accent);
}


/* ============================================================
   BENEFITS
============================================================ */

.luxury-product__benefits {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-top: 32px;

  padding: 24px 0;

  border-top: 1px solid var(--lp-border);
  border-bottom: 1px solid var(--lp-border);
}

.luxury-product__benefit {

  display: flex;

  flex-direction: column;

  align-items: flex-start;

  gap: 10px;

  min-width: 0;
}


.luxury-product__benefit-icon {

  width: 32px;
  height: 32px;

  display: grid;

  place-items: center;

  color: var(--lp-accent);

  background: var(--lp-soft);

  border-radius: 50%;
}


.luxury-product__benefit-icon svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__benefit strong,
.luxury-product__benefit small {

  display: block;
}


.luxury-product__benefit strong {

  margin-bottom: 3px;

  color: var(--color-foreground);

  font-size: 10.5px;

  font-weight: 650;
}


.luxury-product__benefit small {

  color: var(--lp-muted);

  font-size: 9.5px;

  line-height: 1.45;
}


/* ============================================================
   ACCORDIONS
============================================================ */


.luxury-product__accordions {
  margin-top: 28px;

  border-top: 1px solid var(--lp-border);
}

.luxury-product__accordion {
  border-bottom: 1px solid var(--lp-border);
}

.luxury-product__accordion summary {
  min-height: 64px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0;

  color: var(--color-foreground);

  cursor: pointer;

  list-style: none;

  font-size: 14px;
  line-height: 1.4;
  font-weight: 600;

  transition: color .2s ease;
}

.luxury-product__accordion summary:hover {
  color: var(--lp-accent);
}

.luxury-product__accordion-content {
  padding: 0 30px 24px 0;

  color: var(--color-muted);

  font-size: 13.5px;
  line-height: 1.8;
}


.luxury-product__accordion summary::-webkit-details-marker {
  display: none;
}


.luxury-product__accordion-icon {

  width: 24px;
  height: 24px;

  display: grid;

  place-items: center;

  color: var(--lp-accent);
}


.luxury-product__accordion-icon svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;

  transition: transform .25s ease;
}


.luxury-product__accordion[open]
.luxury-product__accordion-icon svg {

  transform: rotate(45deg);
}




/* ============================================================
   PLACEHOLDER
============================================================ */

.luxury-product__placeholder {

  min-height: 650px;

  display: grid;

  place-items: center;

  color: var(--lp-muted);

  background: var(--lp-soft);

  border-radius: var(--lp-radius);

  font-size: 12px;
}


/* ============================================================
   LIGHTBOX
============================================================ */

.luxury-product__lightbox {

  position: fixed;

  z-index: 99999;

  inset: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 40px;

  background: color-mix(in srgb, var(--color-foreground) 97%, transparent);

  opacity: 0;

  visibility: hidden;

  transition:
    opacity .25s ease,
    visibility .25s ease;
}


.luxury-product__lightbox.is-open {

  opacity: 1;

  visibility: visible;
}


.luxury-product__lightbox-content {

  width: min(1200px,90vw);

  height: min(850px,88vh);

  display: flex;

  align-items: center;

  justify-content: center;
}


.luxury-product__lightbox-image {

  width: 100%;
  height: 100%;

  display: flex;

  align-items: center;
  justify-content: center;
}


.luxury-product__lightbox-image img {

  max-width: 100%;
  max-height: 100%;

  width: auto;
  height: auto;

  object-fit: contain;
}


.luxury-product__lightbox-close,
.luxury-product__lightbox-nav {

  position: absolute;

  width: 46px;
  height: 46px;

  display: grid;

  place-items: center;

  color: var(--color-surface);

  background: var(--color-glass-bg);

  border-radius: 50%;

  cursor: pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}


.luxury-product__lightbox-close:hover,
.luxury-product__lightbox-nav:hover {

  background: var(--color-glass-glow);
}


.luxury-product__lightbox-close {

  top: 25px;

  right: 25px;
}


.luxury-product__lightbox-nav {

  top: 50%;

  transform: translateY(-50%);
}


.luxury-product__lightbox-nav:hover {

  transform:
    translateY(-50%)
    scale(1.06);
}


.luxury-product__lightbox-nav--prev {

  left: 25px;
}


.luxury-product__lightbox-nav--next {

  right: 25px;
}


.luxury-product__lightbox-close svg,
.luxury-product__lightbox-nav svg {

  width: 20px;
  height: 20px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__lightbox-counter {

  position: absolute;

  bottom: 25px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  gap: 6px;

  color: var(--color-on-dark-muted);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 11px;
}


/* ============================================================
   FOCUS
============================================================ */

.luxury-product button:focus-visible,
.luxury-product input:focus-visible,
.luxury-product summary:focus-visible,
.luxury-reviews *:focus-visible {

  outline: 2px solid var(--lp-accent, var(--color-accent));

  outline-offset: 3px;
}


/* ============================================================================
   CUSTOMER REVIEWS — continuous scrolling ribbon (signature element)
============================================================================ */

.luxury-reviews {

  --rv-ink: color-mix(in srgb, var(--color-foreground) 70%, var(--color-accent));
  --rv-paper: var(--color-background);
  --rv-line: var(--color-border);
  --rv-muted: var(--color-muted);
  --rv-accent: var(--color-accent);

  width:100vw;
    margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: 84px 0 96px;

  background: var(--rv-paper);

  border-top: 1px solid var(--rv-line);

  overflow: hidden;

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

.luxury-reviews__container {

  width: min(1480px, calc(100% - 80px));

  margin-inline: auto;
}

.luxury-reviews__header {

  text-align: center;

  margin-bottom: 48px;
}

.luxury-reviews__eyebrow {

  display: inline-block;

  margin-bottom: 14px;

  color: var(--rv-accent);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 10.5px;

  font-weight: 500;

  letter-spacing: .2em;

  text-transform: uppercase;
}

.luxury-reviews__title {

  margin: 0;

  color: var(--rv-ink);

  font-family: 'Fraunces', Georgia, serif;

  font-size: clamp(28px, 3.2vw, 42px);

  font-weight: 500;

  letter-spacing: -.02em;
  line-height: 1.1;
}

.luxury-reviews__header::after {

  content: '';

  display: block;

  width: 64px;
  height: 3px;

  margin: 22px auto 0;

  background: linear-gradient(135deg, color-mix(in srgb, var(--color-foreground) 70%, var(--color-accent)) 0%, var(--color-accent) 42%, color-mix(in srgb, var(--color-accent) 55%, var(--color-surface)) 100%);

  border-radius: 999px;
}

.luxury-reviews__marquee {

  position: relative;

  width: 100%;

  -webkit-mask-image: linear-gradient(
    90deg,
    transparent 0,
    var(--color-foreground) 6%,
    var(--color-foreground) 94%,
    transparent 100%
  );

  mask-image: linear-gradient(
    90deg,
    transparent 0,
    var(--color-foreground) 6%,
    var(--color-foreground) 94%,
    transparent 100%
  );
}

.luxury-reviews__track {

  display: flex;

  width: max-content;

  animation: reviews-scroll 46s linear infinite;
}

.luxury-reviews__marquee:hover .luxury-reviews__track,
.luxury-reviews__marquee:focus-within .luxury-reviews__track {

  animation-play-state: paused;
}

.luxury-reviews__group {

  display: flex;

  gap: 20px;

  padding: 4px 10px;

  flex-shrink: 0;
}

@keyframes reviews-scroll {

  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }

}

.luxury-reviews__card {

  position: relative;

  flex: 0 0 340px;

  display: flex;

  flex-direction: column;

  gap: 16px;

  padding: 28px 26px 24px;

  background: var(--color-surface);

  border: 1px solid var(--rv-line);
  border-top: 3px solid transparent;

  border-radius: 10px;

  background-image:
    linear-gradient(var(--color-surface), var(--color-surface)),
    linear-gradient(135deg, color-mix(in srgb, var(--color-foreground) 70%, var(--color-accent)) 0%, var(--color-accent) 42%, color-mix(in srgb, var(--color-accent) 55%, var(--color-surface)) 100%);
  background-origin: border-box;
  background-clip: padding-box, border-box;

  box-shadow: 0 14px 34px var(--color-shadow-medium);
}

.luxury-reviews__quote-mark {

  position: absolute;

  top: 10px;
  right: 20px;

  color: var(--rv-line);

  font-family: 'Fraunces', Georgia, serif;

  font-size: 52px;

  line-height: 1;

  user-select: none;
}

.luxury-reviews__stars {

  display: flex;

  gap: 3px;

  color: var(--color-border);
}

.luxury-reviews__stars svg {

  width: 14px;
  height: 14px;

  fill: currentColor;
}

.luxury-reviews__stars svg.is-filled {

  color: var(--rv-accent);
}

.luxury-reviews__text {

  margin: 0;

  color: var(--color-muted);

  font-size: 13.5px;

  line-height: 1.75;

  min-height: 88px;
}

.luxury-reviews__person {

  display: flex;

  align-items: center;

  gap: 12px;

  padding-top: 14px;

  border-top: 1px solid var(--rv-line);
}

.luxury-reviews__avatar {

  flex: 0 0 auto;

  width: 38px;
  height: 38px;

  display: grid;

  place-items: center;

  color: var(--color-surface);

  background: linear-gradient(135deg, color-mix(in srgb, var(--color-foreground) 70%, var(--color-accent)) 0%, var(--color-accent) 42%, color-mix(in srgb, var(--color-accent) 55%, var(--color-surface)) 100%);

  border-radius: 50%;

  font-family: 'IBM Plex Mono', monospace;

  font-size: 11px;

  font-weight: 500;

  letter-spacing: .02em;
}

.luxury-reviews__person-meta {

  display: flex;

  flex-direction: column;

  gap: 2px;

  min-width: 0;
}

.luxury-reviews__person-meta strong {

  color: var(--rv-ink);

  font-size: 12.5px;

  font-weight: 650;
}

.luxury-reviews__person-meta small {

  color: var(--rv-muted);

  font-size: 10.5px;
}

@media (prefers-reduced-motion: reduce) {

  .luxury-reviews__track {

    animation: none;
  }

  .luxury-reviews__marquee {

    overflow-x: auto;

    scroll-snap-type: x proximity;

    -webkit-mask-image: none;

    mask-image: none;
  }

  .luxury-reviews__group[aria-hidden="true"] {

    display: none;
  }

  .luxury-reviews__card {

    scroll-snap-align: start;
  }

}


/* ============================================================
   LARGE TABLET
============================================================ */

@media (max-width: 1199px) {

  .luxury-product__container {

    width: min(100% - 48px, 1000px);
  }


  .luxury-product__layout {

    grid-template-columns:
      minmax(0,1fr)
      minmax(340px,.8fr);

    gap: 45px;
  }

  .luxury-product__details::before {

    left: -23px;
  }

  .luxury-reviews__container {

    width: min(100% - 48px, 1000px);
  }

}


/* ============================================================
   TABLET
============================================================ */

@media (max-width: 899px) {

  .luxury-product__container {

    width: min(100% - 36px, 720px);
  }


  .luxury-product__layout {

    grid-template-columns: 1fr;

    gap: 45px;
  }


  .luxury-product__details-inner {

    position: static;

    max-width: none;
  }

  .luxury-product__details::before {

    display: none;
  }


  .luxury-product__title {

    max-width: 700px;
  }

  .luxury-reviews {

    padding: 64px 0 76px;
  }

  .luxury-reviews__container {

    width: min(100% - 36px, 720px);
  }

}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width: 599px) {

  .luxury-product {

    padding-top: max(20px,var(--lp-top-space));

    padding-bottom: max(30px,var(--lp-bottom-space));
  }


  .luxury-product__container {

    width: 100%;
  }


  .luxury-product__layout {

    gap: 32px;
  }


  .luxury-product__viewer {

    border-radius: 0;
  }


  .luxury-product__slides {

    aspect-ratio: 1 / 1.12;
  }


  .luxury-product__counter {

    top: 14px;

    left: 14px;
  }


  .luxury-product__zoom {

    right: 14px;

    bottom: 14px;

    padding: 9px 11px;
  }


  .luxury-product__zoom span {

    display: none;
  }


  .luxury-product__navigation {

    width: 38px;
    height: 38px;

    opacity: 1;
  }


  .luxury-product__navigation--prev {

    left: 12px;
  }


  .luxury-product__navigation--next {

    right: 12px;
  }


  .luxury-product__thumbnail-wrap {

    padding-inline: 14px;
  }


  .luxury-product__thumbnail {

    flex-basis: 62px;

    width: 62px;
    height: 62px;
  }


  .luxury-product__details {

    padding-inline: 18px;
  }


  .luxury-product__title {

    font-size: 33px;

    line-height: 1.08;
  }


  .luxury-product__price-current {

    font-size: 18px;
  }


  .luxury-product__description {

    font-size: 13px;

    line-height: 1.75;
  }


  .luxury-product__form {

    margin-top: 27px;
  }


  .luxury-product__mode-toggle {
    gap: 10px;
  }

  .luxury-product__mode-card {
    min-height: 108px;
    padding: 16px 10px 14px;
  }

  .luxury-product__mode-title {
    font-size: 14px;
  }

  .luxury-product__mode-subtitle {
    font-size: 12px;
  }


  .luxury-product__purchase {

    grid-template-columns: 100px minmax(0,1fr);
  }


  .luxury-product__quantity {

    grid-template-columns: 27px 1fr 27px;
  }


  .luxury-product__add {

    padding-inline: 12px;
  }


  .luxury-product__benefits {

    gap: 8px;
  }


  .luxury-product__benefit {

    gap: 8px;
  }


  .luxury-product__benefit-icon {

    width: 28px;
    height: 28px;
  }


  .luxury-product__benefit strong {

    font-size: 9px;
  }


  .luxury-product__benefit small {

    font-size: 8px;
  }


  .luxury-product__lightbox {

    padding: 18px;
  }


  .luxury-product__lightbox-content {

    width: 100%;

    height: 80vh;
  }


  .luxury-product__lightbox-close {

    top: 15px;

    right: 15px;

    width: 40px;

    height: 40px;
  }


  .luxury-product__lightbox-nav {

    width: 38px;

    height: 38px;
  }


  .luxury-product__lightbox-nav--prev {

    left: 10px;
  }


  .luxury-product__lightbox-nav--next {

    right: 10px;
  }


  .luxury-product__partial-modal {

    padding: 0.75rem;

    align-items: end;
  }


  .luxury-product__partial-modal-dialog {

    width: 100%;

    max-height: 88vh;

    padding: 1.15rem;

    border-bottom-left-radius: 0;

    border-bottom-right-radius: 0;
  }


  .luxury-product__partial-modal-close {

    top: 0.65rem;

    right: 0.65rem;

    width: 36px;
    height: 36px;
  }


  .luxury-reviews {

    padding: 52px 0 64px;
  }

  .luxury-reviews__container {

    width: min(100% - 32px, 720px);
  }

  .luxury-reviews__header {

    margin-bottom: 28px;

    padding-inline: 0;
  }

  .luxury-reviews__title {

    font-size: clamp(22px, 6vw, 30px);
  }

  .luxury-reviews__header::after {

    width: 48px;

    height: 2px;

    margin-top: 16px;
  }

  .luxury-reviews__group {

    gap: 14px;

    padding-inline: 4px;
  }

  .luxury-reviews__card {

    flex: 0 0 220px;

    gap: 12px;

    padding: 18px 16px 16px;
  }

  .luxury-reviews__quote-mark {

    top: 8px;
    right: 14px;

    font-size: 38px;
  }

  .luxury-reviews__stars svg {

    width: 11px;
    height: 11px;
  }

  .luxury-reviews__text {

    font-size: 12px;

    line-height: 1.6;

    min-height: 72px;
  }

  .luxury-reviews__person {

    gap: 10px;

    padding-top: 10px;
  }

  .luxury-reviews__avatar {

    width: 30px;
    height: 30px;

    font-size: 9px;
  }

  .luxury-reviews__person-meta strong {

    font-size: 11px;
  }

  .luxury-reviews__person-meta small {

    font-size: 9.5px;
  }

  .luxury-reviews__track {

    animation-duration: 34s;
  }

}

/* ============================================================
   SIMILAR PRODUCTS
============================================================ */

.luxury-related {

  --rel-ink:
    color-mix(
      in srgb,
      var(--color-foreground) 72%,
      var(--color-accent)
    );

  --rel-muted: var(--color-muted);
  --rel-paper: var(--color-background);
  --rel-soft: var(--color-background);
  --rel-line: var(--color-border);
  --rel-accent: var(--color-accent);

  padding: 88px 0 100px;

  background: var(--rel-paper);

  font-family:
    'Inter',
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;

  -webkit-font-smoothing: antialiased;
}


.luxury-related *,
.luxury-related *::before,
.luxury-related *::after {
  box-sizing: border-box;
}


/* ============================================================
   CONTAINER
============================================================ */

.luxury-related__container {

  width:
    min(
      1480px,
      calc(100% - 80px)
    );

  margin-inline: auto;
}


/* ============================================================
   HEADER
============================================================ */

.luxury-related__header {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 30px;

  margin-bottom: 38px;

  padding-bottom: 22px;

  border-bottom:
    1px solid var(--rel-line);
}


.luxury-related__heading-group {
  min-width: 0;
}


.luxury-related__eyebrow {

  display: block;

  margin-bottom: 10px;

  color: var(--rel-accent);

  font-family:
    'IBM Plex Mono',
    monospace;

  font-size: 10px;

  font-weight: 500;

  letter-spacing: .18em;

  line-height: 1.4;

  text-transform: uppercase;
}


.luxury-related__title {

  margin: 0;

  color: var(--rel-ink);

  font-family:
    'Fraunces',
    Georgia,
    serif;

  font-size:
    clamp(
      30px,
      3vw,
      46px
    );

  font-weight: 500;

  letter-spacing: -.025em;

  line-height: 1.05;
}


/* ============================================================
   VIEW COLLECTION
============================================================ */

.luxury-related__view-all {

  display: inline-flex;

  align-items: center;

  gap: 9px;

  flex: 0 0 auto;

  padding-bottom: 4px;

  color: var(--rel-ink);

  font-size: 11px;

  font-weight: 600;

  text-decoration: none;

  border-bottom:
    1px solid var(--rel-ink);

  transition:
    gap .2s ease,
    opacity .2s ease;
}


.luxury-related__view-all:hover {

  gap: 13px;

  opacity: .65;
}


.luxury-related__view-all svg {

  width: 15px;

  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


/* ============================================================
   PRODUCT GRID
============================================================ */

.luxury-related__viewport {
  width: 100%;
}


.luxury-related__grid {

  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 18px;
}


/* ============================================================
   CARD
============================================================ */

.luxury-related__card {

  min-width: 0;

  position: relative;
}


.luxury-related__card-link {

  display: block;

  color: inherit;

  text-decoration: none;
}


/* ============================================================
   IMAGE
============================================================ */

.luxury-related__image-wrap {

  position: relative;

  overflow: hidden;

  aspect-ratio: 4 / 5;

  background:
    color-mix(
      in srgb,
      var(--color-background) 92%,
      var(--color-foreground)
    );

  border-radius: 10px;

  isolation: isolate;
}


.luxury-related__image {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  transform: scale(1);

  transition:
    transform .65s
      cubic-bezier(.2,.65,.2,1);
}


.luxury-related__card-link:hover
.luxury-related__image,
.luxury-related__card.is-card-active
.luxury-related__image {

  transform: scale(1.045);
}


/* ============================================================
   IMAGE PLACEHOLDER
============================================================ */

.luxury-related__image-placeholder {

  width: 100%;

  height: 100%;

  display: grid;

  place-items: center;

  color: var(--rel-muted);

  font-size: 11px;

  letter-spacing: .04em;
}


/* ============================================================
   SALE BADGE
============================================================ */

.luxury-related__badge {

  position: absolute;

  z-index: 3;

  top: 13px;

  left: 13px;

  display: inline-flex;

  align-items: center;

  min-height: 25px;

  padding:
    0 9px;

  color: var(--color-surface);

  background: var(--rel-accent);

  border-radius: 999px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .08em;

  text-transform: uppercase;
