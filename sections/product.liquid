{% comment %}
  PREMIUM PRODUCT PAGE — refined edition
  ------------------------------------------------------------
  Visual direction:
  - Boutique atelier / editorial luxury ecommerce
  - Warm ivory + ink palette with an antique-brass accent
  - Fraunces (display serif) + Inter (body) + IBM Plex Mono (labels/price)
  - Large, quiet product imagery with a hairline division from the info panel
  - Professional option selectors, sticky information panel
  - Existing gallery / lightbox / variant / notify-me functionality retained
  - New: an endlessly scrolling customer-review ribbon at the foot of the page
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'product-form-' | append: section.id %}

<section
  class="luxury-product"
  data-add-to-cart-label="{{ section.settings.add_to_cart_label | escape }}"
  style="
    --lp-top-space: {{ section.settings.padding_top }}px;
    --lp-bottom-space: {{ section.settings.padding_bottom }}px;
    --lp-radius: {{ section.settings.image_radius }}px;
  "
>

  <div class="luxury-product__container">

    <div class="luxury-product__layout">

      <!-- =====================================================
           GALLERY
      ====================================================== -->

      <div class="luxury-product__gallery">

        {% if product.media.size > 0 %}

          <div class="luxury-product__viewer">

            <div class="luxury-product__counter">
              <span data-gallery-current>1</span>
              <span class="luxury-product__counter-separator">/</span>
              <span>{{ product.media.size }}</span>
            </div>

            <button
              type="button"
              class="luxury-product__zoom"
              data-product-zoom
              aria-label="View larger image"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
                <path d="M16 3h3a2 2 0 0 1 2 2v3"/>
                <path d="M8 21H5a2 2 0 0 1-2-2v-3"/>
                <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
              </svg>

              <span>View larger</span>
            </button>

            <div
              class="luxury-product__slides"
              data-product-slides
            >

              {% for media in product.media %}

                <div
                  class="luxury-product__slide{% if forloop.first %} is-active{% endif %}"
                  data-product-slide
                  data-media-id="{{ media.id }}"
                  data-media-index="{{ forloop.index0 }}"
                  data-media-type="{{ media.media_type }}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                >

                  {% if media.media_type == 'image' %}

                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '480, 720, 960, 1200, 1500, 1800',
                        sizes: '(min-width: 1000px) 55vw, 100vw',
                        class: 'luxury-product__image',
                        alt: media.alt | default: product.title
                    }}

                  {% elsif media.media_type == 'video' %}

                    {{
                      media
                      | video_tag:
                        controls: true,
                        muted: true,
                        loop: true,
                        playsinline: true,
                        class: 'luxury-product__video'
                    }}

                  {% elsif media.media_type == 'external_video' %}

                    {{ media | external_video_tag }}

                  {% elsif media.media_type == 'model' %}

                    {{ media | model_viewer_tag }}

                  {% endif %}

                </div>

              {% endfor %}

            </div>


            {% if product.media.size > 1 %}

              <button
                type="button"
                class="luxury-product__navigation luxury-product__navigation--prev"
                data-gallery-prev
                aria-label="Previous product image"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 18 9 12l6-6"/>
                </svg>
              </button>

              <button
                type="button"
                class="luxury-product__navigation luxury-product__navigation--next"
                data-gallery-next
                aria-label="Next product image"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>

            {% endif %}

          </div>


          {% if product.media.size > 1 %}

            <div class="luxury-product__thumbnail-wrap">

              <div
                class="luxury-product__thumbnails"
                data-product-thumbnails
                role="tablist"
                aria-label="Product images"
              >

                {% for media in product.media %}

                  <button
                    type="button"
                    class="luxury-product__thumbnail{% if forloop.first %} is-active{% endif %}"
                    data-product-thumbnail
                    data-media-index="{{ forloop.index0 }}"
                    role="tab"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="View product image {{ forloop.index }}"
                  >

                    {% if media.media_type == 'image' %}

                      {{
                        media
                        | image_url: width: 220
                        | image_tag:
                          loading: 'lazy',
                          widths: '100, 160, 220',
                          sizes: '72px',
                          class: 'luxury-product__thumbnail-image',
                          alt: media.alt | default: product.title
                      }}

                    {% else %}

                      <span class="luxury-product__thumbnail-icon">

                        {% if media.media_type == 'video' %}

                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 5v14l11-7z"/>
                          </svg>

                        {% else %}

                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3v18M3 12h18"/>
                          </svg>

                        {% endif %}

                      </span>

                    {% endif %}

                  </button>

                {% endfor %}

              </div>

            </div>

          {% endif %}

        {% else %}

          <div class="luxury-product__placeholder">
            <span>No image available</span>
          </div>

        {% endif %}

      </div>


      <!-- =====================================================
           PRODUCT INFORMATION
      ====================================================== -->

      <div class="luxury-product__details">

        <div class="luxury-product__details-inner">

          {% if section.settings.show_vendor and product.vendor != blank %}

            <div class="luxury-product__vendor">
              {{ product.vendor }}
            </div>

          {% endif %}


          <h1 class="luxury-product__title">
            {{ product.title }}
          </h1>


          {% if section.settings.show_rating %}

            <div class="luxury-product__rating">

              <span class="luxury-product__stars">

                {% for i in (1..5) %}

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/>
                  </svg>

                {% endfor %}

              </span>

              <span>
                {{ section.settings.rating_text }}
              </span>

            </div>

          {% endif %}


          <div class="luxury-product__price">

            {% if current_variant.compare_at_price > current_variant.price %}

              <span
                class="luxury-product__price-current"
                data-price
              >
                {{ current_variant.price | money }}
              </span>

              <span
                class="luxury-product__price-compare"
                data-compare-price
              >
                {{ current_variant.compare_at_price | money }}
              </span>

              <span
                class="luxury-product__sale"
                data-sale-badge
              >
                Sale
              </span>

            {% else %}

              <span
                class="luxury-product__price-current"
                data-price
              >
                {{ current_variant.price | money }}
              </span>

              <span
                class="luxury-product__price-compare"
                data-compare-price
                hidden
              ></span>

              <span
                class="luxury-product__sale"
                data-sale-badge
                hidden
              >
                Sale
              </span>

            {% endif %}

          </div>


          {% if product.description != blank and section.settings.show_description %}

            <div class="luxury-product__description rte">
              {{ product.description }}
            </div>

          {% endif %}


          <!-- PRODUCT FORM -->

          {% form 'product',
            product,
            id: product_form_id,
            class: 'luxury-product__form'
          %}


            {% unless product.has_only_default_variant %}

              <div class="luxury-product__options">

                {% for option in product.options_with_values %}

                  <fieldset
                    class="luxury-product__option"
                    data-option-index="{{ forloop.index0 }}"
                  >

                  <legend class="luxury-product__option-heading">

  <span class="luxury-product__option-name">
    {{ option.name }}
  </span>

  <span
    class="luxury-product__option-selected"
    data-option-value
  >
    {{ option.selected_value }}
  </span>

</legend>


                    <div class="luxury-product__option-values">

                      {% for value in option.values %}

                        {% assign option_disabled = true %}

                        {% for variant in product.variants %}

                          {% case forloop.parentloop.index %}

                            {% when 1 %}

                              {% if variant.option1 == value and variant.available %}
                                {% assign option_disabled = false %}
                              {% endif %}

                            {% when 2 %}

                              {% if variant.option2 == value and variant.available %}
                                {% assign option_disabled = false %}
                              {% endif %}

                            {% when 3 %}

                              {% if variant.option3 == value and variant.available %}
                                {% assign option_disabled = false %}
                              {% endif %}

                          {% endcase %}

                        {% endfor %}


                        <label
                          class="
                            luxury-product__choice
                            {% if option_disabled %}is-disabled{% endif %}
                          "
                        >

                          <input
                            type="radio"
                            name="option{{ option.position }}"
                            value="{{ value | escape }}"
                            data-option-input
                            data-option-position="{{ option.position }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            {% if option_disabled %}disabled{% endif %}
                          >

                          <span>
                            {{ value }}
                          </span>

                        </label>

                      {% endfor %}

                    </div>

                  </fieldset>

                {% endfor %}

              </div>

            {% endunless %}


            <select
              name="id"
              class="luxury-product__variant-select"
              data-product-variant
              aria-label="Product variant"
            >

              {% for variant in product.variants %}

                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                  data-available="{{ variant.available }}"
                  {% if variant == current_variant %}selected{% endif %}
                >
                  {{ variant.title }}
                </option>

              {% endfor %}

            </select>


            <!-- =============================================
                 PURCHASE / NOTIFY ME
            ============================================== -->

            <div class="luxury-product__purchase-wrap" data-purchase-wrap>

              <!-- BUY STATE -->
              <div
                class="luxury-product__purchase-buy {% unless current_variant.available %}is-hidden{% endunless %}"
                data-purchase-buy
              >

                <div class="luxury-product__purchase">

                  <div class="luxury-product__quantity">

                    <button
                      type="button"
                      data-quantity-minus
                      aria-label="Decrease quantity"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14"/>
                      </svg>
                    </button>

                    <input
                      id="Quantity-{{ section.id }}"
                      type="number"
                      name="quantity"
                      min="1"
                      value="1"
                      inputmode="numeric"
                      aria-label="Quantity"
                    >

                    <button
                      type="button"
                      data-quantity-plus
                      aria-label="Increase quantity"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                    </button>

                  </div>


                  <button
                    type="submit"
                    class="luxury-product__add"
                    data-add-to-cart
                  >

                    <span data-add-label>
                      {{ section.settings.add_to_cart_label }}
                    </span>

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14"/>
                      <path d="m13 6 6 6-6 6"/>
                    </svg>

                  </button>

                </div>


                {% if section.settings.show_dynamic_checkout %}

                  <div class="luxury-product__dynamic-checkout">
                    {{ form | payment_button }}
                  </div>

                {% endif %}

              </div>


              <!-- SOLD OUT / NOTIFY STATE -->
              <div
                class="luxury-product__notify {% if current_variant.available %}is-hidden{% endif %}"
                data-purchase-notify
              >

                <button
                  type="button"
                  class="luxury-product__notify-toggle"
                  data-notify-toggle
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                  </svg>
                  <span>{{ section.settings.notify_button_label | default: 'Notify me when available' }}</span>
                </button>

                <div class="luxury-product__notify-form is-hidden" data-notify-form>

                  <p class="luxury-product__notify-text">
                    {{ section.settings.notify_text | default: "Leave your email or phone number and we'll let you know as soon as this is back in stock." }}
                  </p>

                  <div class="luxury-product__notify-fields">

                    <input
                      type="email"
                      inputmode="email"
                      placeholder="Email address"
                      data-notify-email
                      autocomplete="email"
                    >

                    <input
                      type="tel"
                      inputmode="tel"
                      placeholder="Phone number"
                      data-notify-phone
                      autocomplete="tel"
                    >

                  </div>

                  <p class="luxury-product__notify-error is-hidden" data-notify-error>
                    Please enter your email or phone number.
                  </p>

                  <button
                    type="button"
                    class="luxury-product__notify-submit"
                    data-notify-submit
                  >
                    Submit
                  </button>

                  <p class="luxury-product__notify-success is-hidden" data-notify-success>
                    {{ section.settings.notify_success_message | default: "Thanks — we'll notify you as soon as it's back!" }}
                  </p>

                </div>

              </div>

            </div>


          {% endform %}


          <!-- =================================================
               TRUST
          ================================================== -->

          {% if section.settings.show_trust_items %}

            <div class="luxury-product__benefits">

              <div class="luxury-product__benefit">

                <span class="luxury-product__benefit-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 20 6v5c0 4.8-3.1 8.9-8 10-4.9-1.1-8-5.2-8-10V6l8-3Z"/>
                    <path d="m8.5 12 2.2 2.2 4.8-5"/>
                  </svg>

                </span>

                <span>
                  <strong>{{ section.settings.trust_1_title }}</strong>
                  <small>{{ section.settings.trust_1_text }}</small>
                </span>

              </div>


              <div class="luxury-product__benefit">

                <span class="luxury-product__benefit-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 6h11v11H3z"/>
                    <path d="M14 10h4l3 3v4h-7z"/>
                    <circle cx="7" cy="18" r="2"/>
                    <circle cx="18" cy="18" r="2"/>
                  </svg>

                </span>

                <span>
                  <strong>{{ section.settings.trust_2_title }}</strong>
                  <small>{{ section.settings.trust_2_text }}</small>
                </span>

              </div>


              <div class="luxury-product__benefit">

                <span class="luxury-product__benefit-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 11a8 8 0 1 1-2.35-5.66"/>
                    <path d="M20 4v7h-7"/>
                  </svg>

                </span>

                <span>
                  <strong>{{ section.settings.trust_3_title }}</strong>
                  <small>{{ section.settings.trust_3_text }}</small>
                </span>

              </div>

            </div>

          {% endif %}


          <!-- =================================================
               ACCORDIONS
          ================================================== -->

          {% if section.blocks.size > 0 %}

            <div class="luxury-product__accordions">

              {% for block in section.blocks %}

                {% if block.type == 'tab' %}

                <details
                  class="luxury-product__accordion"
                  {{ block.shopify_attributes }}
                  {% if forloop.first %}open{% endif %}
                >

                  <summary>

                    <span>
                      {{ block.settings.title }}
                    </span>

                    <span class="luxury-product__accordion-icon">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                    </span>

                  </summary>

                  <div class="luxury-product__accordion-content rte">
                    {{ block.settings.content }}
                  </div>

                </details>

                {% endif %}

              {% endfor %}

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  </div>


  <!-- =======================================================
       LIGHTBOX
  ======================================================== -->

  {% if product.media.size > 0 %}

    <div
      class="luxury-product__lightbox"
      data-product-lightbox
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Product image viewer"
    >

      <button
        type="button"
        class="luxury-product__lightbox-close"
        data-lightbox-close
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"/>
        </svg>
      </button>


      <button
        type="button"
        class="luxury-product__lightbox-nav luxury-product__lightbox-nav--prev"
        data-lightbox-prev
        aria-label="Previous image"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>


      <div class="luxury-product__lightbox-content">

        <div
          class="luxury-product__lightbox-image"
          data-lightbox-image
        ></div>

      </div>


      <button
        type="button"
        class="luxury-product__lightbox-nav luxury-product__lightbox-nav--next"
        data-lightbox-next
        aria-label="Next image"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>


      <div class="luxury-product__lightbox-counter">

        <span data-lightbox-current>1</span>

        <span>/</span>

        <span>{{ product.media.size }}</span>

      </div>

    </div>

  {% endif %}

</section>


<!-- =========================================================
     CUSTOMER REVIEWS — continuous scrolling ribbon
========================================================== -->

{% if section.settings.show_reviews %}

  <section class="luxury-reviews" aria-label="Customer reviews">

    <div class="luxury-reviews__container">

      <div class="luxury-reviews__header">

        <span class="luxury-reviews__eyebrow">
          {{ section.settings.reviews_eyebrow | default: 'In their words' }}
        </span>

        <h2 class="luxury-reviews__title">
          {{ section.settings.reviews_title | default: 'Loved, in the details' }}
        </h2>

      </div>

    </div>


    <div class="luxury-reviews__marquee" data-reviews-marquee>

      <div class="luxury-reviews__track" data-reviews-track>

        {% comment %} ============ SET A ============ {% endcomment %}
        <div class="luxury-reviews__group" aria-hidden="false">

          <article class="luxury-reviews__card">
            <span class="luxury-reviews__quote-mark" aria-hidden="true">&#8220;</span>
            <div class="luxury-reviews__stars" aria-label="Rated 5 out of 5 stars">
              {% for i in (1..5) %}<svg class="is-filled" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/></svg>{% endfor %}
            </div>
            <p class="luxury-reviews__text">The stitching alone tells you this wasn't rushed. Worn it three weeks straight and it still looks brand new.</p>
            <div class="luxury-reviews__person">
              <span class="luxury-reviews__avatar">AH</span>
              <span class="luxury-reviews__person-meta">
                <strong>Amelia Hartley</strong>
                <small>Verified buyer</small>
              </span>
            </div>
          </article>

          <article class="luxury-reviews__card">
            <span class="luxury-reviews__quote-mark" aria-hidden="true">&#8220;</span>
            <div class="luxury-reviews__stars" aria-label="Rated 5 out of 5 stars">
              {% for i in (1..5) %}<svg class="is-filled" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/></svg>{% endfor %}
            </div>
            <p class="luxury-reviews__text">Ordered expecting "nice." Got something closer to an heirloom. The kind of quality you can feel with your hands before you even read the label.</p>
            <div class="luxury-reviews__person">
              <span class="luxury-reviews__avatar">JC</span>
              <span class="luxury-reviews__person-meta">
                <strong>Julian Cross</strong>
                <small>Verified buyer</small>
              </span>
            </div>
          </article>

          <article class="luxury-reviews__card">
            <span class="luxury-reviews__quote-mark" aria-hidden="true">&#8220;</span>
            <div class="luxury-reviews__stars" aria-label="Rated 4 out of 5 stars">
              {% for i in (1..5) %}<svg class="{% if i <= 4 %}is-filled{% endif %}" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/></svg>{% endfor %}
            </div>
            <p class="luxury-reviews__text">Beautiful piece — sizing ran slightly generous. Reached out and their team sorted an exchange within a day, no hassle at all.</p>
            <div class="luxury-reviews__person">
              <span class="luxury-reviews__avatar">NS</span>
              <span class="luxury-reviews__person-meta">
                <strong>Noor Al-Sayed</strong>
                <small>Verified buyer</small>
              </span>
            </div>
          </article>

          <article class="luxury-reviews__card">
            <span class="luxury-reviews__quote-mark" aria-hidden="true">&#8220;</span>
            <div class="luxury-reviews__stars" aria-label="Rated 5 out of 5 stars">
              {% for i in (1..5) %}<svg class="is-filled" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/></svg>{% endfor %}
            </div>
            <p class="luxury-reviews__text">Understated until you look closely — then every detail makes sense. Worth the wait on backorder, easily.</p>
            <div class="luxury-reviews__person">
              <span class="luxury-reviews__avatar">MW</span>
              <span class="luxury-reviews__person-meta">
                <strong>Marcus Whitfield</strong>
                <small>Verified buyer</small>
              </span>
            </div>
          </article>

          <article class="luxury-reviews__card">
            <span class="luxury-reviews__quote-mark" aria-hidden="true">&#8220;</span>
            <div class="luxury-reviews__stars" aria-label="Rated 5 out of 5 stars">
              {% for i in (1..5) %}<svg class="is-filled" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/></svg>{% endfor %}
            </div>
            <p class="luxury-reviews__text">This is the third piece I've bought from them, and the consistency is exactly what keeps me coming back.</p>
            <div class="luxury-reviews__person">
              <span class="luxury-reviews__avatar">PD</span>
              <span class="luxury-reviews__person-meta">
                <strong>Priya Devan</strong>
                <small>Verified buyer</small>
              </span>
            </div>
          </article>

          <article class="luxury-reviews__card">
            <span class="luxury-reviews__quote-mark" aria-hidden="true">&#8220;</span>
            <div class="luxury-reviews__stars" aria-label="Rated 4 out of 5 stars">
              {% for i in (1..5) %}<svg class="{% if i <= 4 %}is-filled{% endif %}" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/></svg>{% endfor %}
            </div>
