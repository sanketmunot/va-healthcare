{% endstylesheet %}


{% javascript %}

(() => {

  const root = document.querySelector('.luxury-product');

  if (!root) return;


  /* ==========================================================
     GALLERY
  ========================================================== */

  const slides = Array.from(
    root.querySelectorAll('[data-product-slide]')
  );

  const thumbnails = Array.from(
    root.querySelectorAll('[data-product-thumbnail]')
  );

  const previousButton =
    root.querySelector('[data-gallery-prev]');

  const nextButton =
    root.querySelector('[data-gallery-next]');

  const currentCounter =
    root.querySelector('[data-gallery-current]');

  const zoomButton =
    root.querySelector('[data-product-zoom]');

  let activeIndex = 0;


  const setActiveSlide = (index) => {

    if (!slides.length) return;

    activeIndex =
      (index + slides.length) % slides.length;


    slides.forEach((slide, slideIndex) => {

      const isActive =
        slideIndex === activeIndex;

      slide.classList.toggle(
        'is-active',
        isActive
      );

      slide.setAttribute(
        'aria-hidden',
        isActive ? 'false' : 'true'
      );

    });


    thumbnails.forEach(
      (thumbnail, thumbnailIndex) => {

        const isActive =
          thumbnailIndex === activeIndex;

        thumbnail.classList.toggle(
          'is-active',
          isActive
        );

        thumbnail.setAttribute(
          'aria-selected',
          isActive ? 'true' : 'false'
        );


        if (isActive) {

          thumbnail.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
          });

        }

      }
    );


    if (currentCounter) {

      currentCounter.textContent =
        String(activeIndex + 1);

    }

  };


  thumbnails.forEach((thumbnail) => {

    thumbnail.addEventListener(
      'click',
      () => {

        setActiveSlide(
          Number(
            thumbnail.dataset.mediaIndex
          )
        );

      }
    );

  });


  previousButton?.addEventListener(
    'click',
    () => setActiveSlide(activeIndex - 1)
  );


  nextButton?.addEventListener(
    'click',
    () => setActiveSlide(activeIndex + 1)
  );


  /* ==========================================================
     SWIPE
  ========================================================== */

  const slidesContainer =
    root.querySelector('[data-product-slides]');

  let touchStartX = 0;

  slidesContainer?.addEventListener(
    'touchstart',
    (event) => {

      touchStartX =
        event.changedTouches[0].screenX;

    },
    { passive: true }
  );


  slidesContainer?.addEventListener(
    'touchend',
    (event) => {

      const touchEndX =
        event.changedTouches[0].screenX;

      const distance =
        touchEndX - touchStartX;

      if (Math.abs(distance) < 45) return;

      if (distance < 0) {

        setActiveSlide(
          activeIndex + 1
        );

      } else {

        setActiveSlide(
          activeIndex - 1
        );

      }

    },
    { passive: true }
  );


  /* ==========================================================
     LIGHTBOX
  ========================================================== */

  const lightbox =
    root.querySelector('[data-product-lightbox]');

  const lightboxImage =
    root.querySelector('[data-lightbox-image]');

  const lightboxCurrent =
    root.querySelector('[data-lightbox-current]');

  const lightboxClose =
    root.querySelector('[data-lightbox-close]');

  const lightboxPrevious =
    root.querySelector('[data-lightbox-prev]');

  const lightboxNext =
    root.querySelector('[data-lightbox-next]');


  const openLightbox = () => {

    if (!lightbox || !lightboxImage) return;

    const slide =
      slides[activeIndex];

    const image =
      slide?.querySelector('img');

    if (!image) return;


    const fullImage =
      document.createElement('img');

    fullImage.src =
      image.currentSrc || image.src;

    fullImage.alt =
      image.alt || '';

    fullImage.decoding = 'async';


    lightboxImage.replaceChildren(
      fullImage
    );


    if (lightboxCurrent) {

      lightboxCurrent.textContent =
        String(activeIndex + 1);

    }


    lightbox.classList.add('is-open');

    lightbox.setAttribute(
      'aria-hidden',
      'false'
    );


    document.documentElement.style.overflow =
      'hidden';

  };


  const closeLightbox = () => {

    if (!lightbox) return;

    lightbox.classList.remove(
      'is-open'
    );

    lightbox.setAttribute(
      'aria-hidden',
      'true'
    );

    document.documentElement.style.overflow =
      '';

  };


  zoomButton?.addEventListener(
    'click',
    openLightbox
  );


  lightboxClose?.addEventListener(
    'click',
    closeLightbox
  );


  lightbox?.addEventListener(
    'click',
    (event) => {

      if (event.target === lightbox) {

        closeLightbox();

      }

    }
  );


  lightboxPrevious?.addEventListener(
    'click',
    () => {

      setActiveSlide(
        activeIndex - 1
      );

      openLightbox();

    }
  );


  lightboxNext?.addEventListener(
    'click',
    () => {

      setActiveSlide(
        activeIndex + 1
      );

      openLightbox();

    }
  );


  document.addEventListener(
    'keydown',
    (event) => {

      if (
        !lightbox?.classList.contains(
          'is-open'
        )
      ) {
        return;
      }


      if (event.key === 'Escape') {

        closeLightbox();

      }


      if (event.key === 'ArrowLeft') {

        setActiveSlide(
          activeIndex - 1
        );

        openLightbox();

      }


      if (event.key === 'ArrowRight') {

        setActiveSlide(
          activeIndex + 1
        );

        openLightbox();

      }

    }
  );


  /* ==========================================================
     QUANTITY
  ========================================================== */

  const quantityInput =
    root.querySelector(
      'input[name="quantity"]'
    );

  const quantityMinus =
    root.querySelector(
      '[data-quantity-minus]'
    );

  const quantityPlus =
    root.querySelector(
      '[data-quantity-plus]'
    );


  quantityMinus?.addEventListener(
    'click',
    () => {

      if (!quantityInput) return;

      quantityInput.value =
        Math.max(
          1,
          Number(
            quantityInput.value || 1
          ) - 1
        );

      quantityInput.dispatchEvent(
        new Event(
          'change',
          { bubbles: true }
        )
      );

    }
  );


  quantityPlus?.addEventListener(
    'click',
    () => {

      if (!quantityInput) return;

      quantityInput.value =
        Number(
          quantityInput.value || 1
        ) + 1;

      quantityInput.dispatchEvent(
        new Event(
          'change',
          { bubbles: true }
        )
      );

    }
  );


  const setElementHidden = (element, hidden) => {

    if (!element) return;

    element.classList.toggle('is-hidden', hidden);

    if (hidden) {
      element.setAttribute('hidden', '');
    } else {
      element.removeAttribute('hidden');
    }

  };


  /* ==========================================================
     PURCHASE MODE TOGGLE (Full vs Partial)
  ========================================================== */

  const modeToggle =
    root.querySelector('[data-purchase-mode-toggle]');

  const modeButtons =
    Array.from(root.querySelectorAll('[data-mode-btn]'));

  const modePanels =
    Array.from(root.querySelectorAll('[data-purchase-mode]'));

  const setActiveMode = (mode) => {

    modeButtons.forEach((btn) => {

      const isActive = btn.dataset.modeBtn === mode;

      btn.classList.toggle('is-active', isActive);

      btn.setAttribute('aria-checked', isActive ? 'true' : 'false');

    });

    modePanels.forEach((panel) => {

      const isThisPanel = panel.dataset.purchaseMode === mode;

      // Don't override the sold-out hidden state — that's controlled by updateVariant()
      if (panel.dataset.soldOutLocked === 'true') return;

      setElementHidden(panel, !isThisPanel);

    });

  };

  modeButtons.forEach((btn) => {

    btn.addEventListener('click', () => {

      setActiveMode(btn.dataset.modeBtn);

      if (btn.dataset.modeBtn === 'partial') {

        root.dispatchEvent(
          new CustomEvent('partial-mode-selected')
        );

      }

    });

  });


  /* ==========================================================
     VARIANTS
  ========================================================== */

  const variantSelect =
    root.querySelector(
      '[data-product-variant]'
    );

  const optionInputs =
    Array.from(
      root.querySelectorAll(
        '[data-option-input]'
      )
    );

  const priceElement =
    root.querySelector('[data-price]');

  const compareElement =
    root.querySelector('[data-compare-price]');

  const saleBadge =
    root.querySelector('[data-sale-badge]');

  const addButton =
    root.querySelector('[data-add-to-cart]');

  const addLabel =
    root.querySelector('[data-add-label]');

  const purchaseWrap =
    root.querySelector('[data-purchase-wrap]');

  const purchaseFullPanel =
    root.querySelector('[data-purchase-mode="full"]');

  const purchasePartialPanel =
    root.querySelector('[data-purchase-mode="partial"]');

  const purchaseNotify =
    root.querySelector('[data-purchase-notify]');

  const bookingAmountEl =
    root.querySelector('[data-partial-booking-amount]');

  const remainingAmountEl =
    root.querySelector('[data-partial-remaining-amount]');

  const partialFlowModal =
    root.querySelector('[data-partial-flow-modal]');

  const partialModalPayNow =
    root.querySelector('[data-partial-modal-pay-now]');

  const partialModalBalance =
    root.querySelector('[data-partial-modal-balance]');

  const partialModeSubtitle =
    root.querySelector('[data-mode-subtitle="partial"]');

  const fullModeSubtitle =
    root.querySelector('[data-mode-subtitle="full"]');

  const partialFlowCloseButtons =
    Array.from(
      root.querySelectorAll('[data-partial-flow-close]')
    );

  const partialFlowContinue =
    root.querySelector('[data-partial-flow-continue]');


  const formatMoney = (cents) => {

    if (
      window.Shopify &&
      typeof Shopify.formatMoney ===
        'function'
    ) {

      return Shopify.formatMoney(
        cents,
        Shopify.money_format
      );

    }

    const currency =
      root.dataset.shopCurrency ||
      window.Shopify?.currency?.active ||
      'USD';

    return (
      Number(cents) / 100
    ).toLocaleString(
      undefined,
      {
        style: 'currency',
        currency
      }
    );

  };


  const updatePartialAmounts = (priceCents) => {

    const bookingCents = Number(
      root.dataset.depositVariantPrice || 0
    );

    const remainingCents = Math.max(
      priceCents - bookingCents,
      0
    );

    const payNowText = formatMoney(bookingCents);

    const balanceText = formatMoney(remainingCents);


    if (bookingAmountEl) {
      bookingAmountEl.textContent = payNowText;
    }

    if (remainingAmountEl) {
      remainingAmountEl.textContent = balanceText;
    }

    if (partialModalPayNow) {
      partialModalPayNow.textContent = payNowText;
    }

    if (partialModalBalance) {
      partialModalBalance.textContent = balanceText;
    }

    if (partialModeSubtitle && bookingCents > 0) {
      partialModeSubtitle.textContent = `${payNowText} now`;
    }

    root.dataset.bookingCents = String(bookingCents);

    root.dataset.remainingCents = String(remainingCents);

    root.dataset.fullPriceCents = String(priceCents);

    if (fullModeSubtitle) {
      fullModeSubtitle.textContent = `${formatMoney(priceCents)} now`;
    }

  };


  const updatePartialAvailability = (mainAvailable) => {

    const partialConfigured =
      root.dataset.partialConfigured === 'true';

    const depositAvailable =
      root.dataset.depositAvailable === 'true';

    const showPartial =
      partialConfigured &&
      depositAvailable &&
      mainAvailable;


    setElementHidden(
      modeToggle,
      !mainAvailable || !partialConfigured || !depositAvailable
    );


    if (partialAddToCartButton) {
      partialAddToCartButton.disabled = !showPartial;
    }


    const partialModeButton =
      modeButtons.find(
        (btn) => btn.dataset.modeBtn === 'partial'
      );

    if (partialModeButton) {
      partialModeButton.disabled = !showPartial;
    }


    if (
      !showPartial &&
      partialModeButton?.classList.contains('is-active')
    ) {
      setActiveMode('full');
    }

  };


  const openPartialFlowModal = () => {

    if (!partialFlowModal) return;

    const selectedOption =
      variantSelect?.options[
        variantSelect.selectedIndex
      ];

    const priceCents = Number(
      selectedOption?.dataset.price || 0
    );

    updatePartialAmounts(priceCents);

    partialFlowModal.classList.add('is-open');

    partialFlowModal.setAttribute(
      'aria-hidden',
      'false'
    );

    document.documentElement.style.overflow =
      'hidden';

  };


  const closePartialFlowModal = () => {

    if (!partialFlowModal) return;

    partialFlowModal.classList.remove('is-open');

    partialFlowModal.setAttribute(
      'aria-hidden',
      'true'
    );

    document.documentElement.style.overflow =
      '';

  };


  root.addEventListener(
    'partial-mode-selected',
    openPartialFlowModal
  );


  partialFlowCloseButtons.forEach((button) => {

    button.addEventListener(
      'click',
      closePartialFlowModal
    );

  });


  partialFlowContinue?.addEventListener(
    'click',
    () => {

      closePartialFlowModal();

      root.querySelector('[data-partial-add-to-cart]')?.focus();

    }
  );


  partialFlowModal?.addEventListener(
    'click',
    (event) => {

      if (event.target === partialFlowModal) {
        closePartialFlowModal();
      }

    }
  );


  document.addEventListener(
    'keydown',
    (event) => {

      if (
        event.key !== 'Escape' ||
        !partialFlowModal?.classList.contains('is-open')
      ) {
        return;
      }

      closePartialFlowModal();

    }
  );


  const updateVariant = () => {

    if (!variantSelect) return;


    const selectedValues =
      optionInputs
        .filter(
          input => input.checked
        )
        .map(
          input => input.value
        );


    let matchingVariant = null;


    Array.from(
      variantSelect.options
    ).forEach((option) => {

      const title =
        option.textContent
          .split(' — ')[0]
          .trim();

      const values =
        title
          .split(' / ')
          .map(
            value => value.trim()
          );


      const matches =
        selectedValues.every(
          (value, index) =>
            values[index] === value
        );


      if (matches) {

        matchingVariant =
          option;

      }

    });


    if (!matchingVariant) return;


    variantSelect.value =
      matchingVariant.value;


    const price =
      Number(
        matchingVariant.dataset.price || 0
      );

    const comparePrice =
      Number(
        matchingVariant.dataset.comparePrice || 0
      );

    const available =
      matchingVariant.dataset.available ===
      'true';


    if (priceElement) {

      priceElement.textContent =
        formatMoney(price);

    }


    if (compareElement) {

      if (comparePrice > price) {

        compareElement.hidden = false;

        compareElement.textContent =
          formatMoney(comparePrice);

      } else {

        compareElement.hidden = true;

      }

    }


    if (saleBadge) {

      saleBadge.hidden =
        !(comparePrice > price);

    }


    if (addButton) {

      addButton.disabled =
        !available;

    }


    if (addLabel) {

      const defaultAddLabel =
        root.dataset.addToCartLabel || 'Add to cart';

      addLabel.textContent =
        defaultAddLabel;

    }


    updatePartialAmounts(price);

    updatePartialAvailability(available);


    if (purchaseNotify) {

      // Mark panels so the mode toggle doesn't fight this state
      [purchaseFullPanel, purchasePartialPanel].forEach((panel) => {

        if (!panel) return;

        panel.dataset.soldOutLocked = available ? 'false' : 'true';

        if (!available) setElementHidden(panel, true);

      });


      setElementHidden(purchaseNotify, available);


      if (available) {

        // Restore whichever mode is currently active
        const activeBtn =
          modeButtons.find((btn) => btn.classList.contains('is-active'));

        setActiveMode(activeBtn ? activeBtn.dataset.modeBtn : 'full');

      } else {

        notifyFormPanel?.classList.add('is-hidden');
        notifySuccess?.classList.add('is-hidden');
        notifyError?.classList.add('is-hidden');

        if (notifyEmail) notifyEmail.value = '';
        if (notifyPhone) notifyPhone.value = '';

      }

    }

  };


  optionInputs.forEach((input) => {

    input.addEventListener(
      'change',
      updateVariant
    );

  });


  /* ==========================================================
     PARTIAL PAYMENT — ADD TO CART
  ========================================================== */

  const partialAddToCartButton =
    root.querySelector('[data-partial-add-to-cart]');

  const partialAddToCartError =
    root.querySelector('[data-partial-add-to-cart-error]');

  const cartRoot =
    window.Shopify?.routes?.root || '/';


  partialAddToCartButton?.addEventListener(
    'click',
    async () => {

      if (!variantSelect?.value) return;

      partialAddToCartError?.classList.add('is-hidden');

      partialAddToCartButton.disabled = true;

      const originalLabel =
        partialAddToCartButton.textContent;

      partialAddToCartButton.textContent = 'Adding…';


      const selectedOption =
        variantSelect.options[
          variantSelect.selectedIndex
        ];

      const priceCents = Number(
        selectedOption?.dataset.price || 0
      );

      updatePartialAmounts(priceCents);

      const quantity = Math.max(
        1,
        Number(quantityInput?.value || 1)
      );

      const mainVariantId =
        variantSelect.value;

      const depositVariantId = Number(
        root.dataset.depositVariantId || 0
      );

      const depositVariantPrice = Number(
        root.dataset.depositVariantPrice || 0
      );


      if (!depositVariantId) {

        if (partialAddToCartError) {
          partialAddToCartError.textContent =
            'Set custom.deposit_product on this product in admin.';
        }

        partialAddToCartError?.classList.remove('is-hidden');
        partialAddToCartButton.disabled = false;
        partialAddToCartButton.textContent = originalLabel;

        return;

      }

      if (root.dataset.depositAvailable !== 'true') {

        if (partialAddToCartError) {
          partialAddToCartError.textContent =
            'Deposit product is out of stock.';
        }

        partialAddToCartError?.classList.remove('is-hidden');
        partialAddToCartButton.disabled = false;
        partialAddToCartButton.textContent = originalLabel;

        return;

      }

      const bookingCents = depositVariantPrice;

      const remainingCents = Math.max(
        priceCents - bookingCents,
        0
      );


      if (bookingCents <= 0) {

        if (partialAddToCartError) {
          partialAddToCartError.textContent =
            'Deposit product must have a price greater than zero.';
        }

        partialAddToCartError?.classList.remove('is-hidden');
        partialAddToCartButton.disabled = false;
        partialAddToCartButton.textContent = originalLabel;

        return;

      }

      try {

        await fetch(`${cartRoot}cart/clear.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          }
        });


        const lineProperties = {
          payment_type: 'partial',
          'Pay now': formatMoney(bookingCents),
          'Balance due': formatMoney(remainingCents),
          'Remaining to collect': formatMoney(remainingCents),
          'Original product': root.dataset.productTitle || '',
          'Original variant ID': String(mainVariantId),
          _booking_amount_cents: String(bookingCents),
          _remaining_amount_cents: String(remainingCents),
          _original_variant_id: String(mainVariantId),
          _original_product_handle: root.dataset.productHandle || ''
        };


        const addResponse = await fetch(
          `${cartRoot}cart/add.js`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({
              items: [
                {
                  id: depositVariantId,
                  quantity,
                  properties: lineProperties
                }
              ]
            })
          }
        );


        if (!addResponse.ok) {
          throw new Error('Unable to add item to cart');
        }


        await fetch(`${cartRoot}cart/update.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({
            attributes: {
              payment_type: 'partial',
              remaining_to_collect: formatMoney(remainingCents),
              original_product: root.dataset.productTitle || ''
            }
          })
        });


        window.location.href = `${cartRoot}cart`;

      } catch (error) {

        partialAddToCartError?.classList.remove('is-hidden');

      } finally {

        partialAddToCartButton.disabled = false;

        partialAddToCartButton.textContent = originalLabel;

      }

    }
  );


  /* ==========================================================
     NOTIFY ME
  ========================================================== */

  const notifyToggle =
    root.querySelector('[data-notify-toggle]');

  const notifyFormPanel =
    root.querySelector('[data-notify-form]');

  const notifyEmail =
    root.querySelector('[data-notify-email]');

  const notifyPhone =
    root.querySelector('[data-notify-phone]');

  const notifyError =
    root.querySelector('[data-notify-error]');

  const notifySubmit =
    root.querySelector('[data-notify-submit]');

  const notifySuccess =
    root.querySelector('[data-notify-success]');


  notifyToggle?.addEventListener(
    'click',
    () => {

      notifyFormPanel?.classList.toggle(
        'is-hidden'
      );

    }
  );


  notifySubmit?.addEventListener(
    'click',
    async () => {

      const email =
        notifyEmail?.value.trim() || '';

      const phone =
        notifyPhone?.value.trim() || '';


      if (!email && !phone) {

        notifyError.textContent =
          'Please enter your email or phone number.';

        notifyError?.classList.remove(
          'is-hidden'
        );

        return;

      }


      notifyError?.classList.add(
        'is-hidden'
      );

      notifySubmit.disabled = true;

      notifySubmit.textContent =
        'Submitting…';


      try {

        const selectedVariant =
          variantSelect?.options[
            variantSelect.selectedIndex
          ];

        const variantTitle =
          selectedVariant?.textContent.trim() ||
          '';

        const body =
          new URLSearchParams();

        body.append(
          'form_type',
          'contact'
        );

        body.append(
          'utf8',
          '✓'
        );

        body.append(
          'contact[email]',
          email
        );

        body.append(
          'contact[phone]',
          phone
        );

        body.append(
          'contact[body]',
          `Back-in-stock request — Product: ${document.title} | Variant: ${variantTitle} | Variant ID: ${variantSelect?.value || 'n/a'} | Email: ${email || 'n/a'} | Phone: ${phone || 'n/a'}`
        );


        await fetch(
          '/contact',
          {
            method: 'POST',
            headers: {
              'Content-Type':
                'application/x-www-form-urlencoded'
            },
            body: body.toString()
          }
        );


        notifyFormPanel?.classList.add(
          'is-hidden'
        );

        notifySuccess?.classList.remove(
          'is-hidden'
        );

        notifyEmail.value = '';

        notifyPhone.value = '';


      } catch (error) {

        notifyError.textContent =
          'Something went wrong. Please try again.';

        notifyError?.classList.remove(
          'is-hidden'
        );


      } finally {

        notifySubmit.disabled = false;

        notifySubmit.textContent =
          'Submit';

      }

    }
  );


  updateVariant();

})();


(() => {

  const relatedSection =
    document.querySelector('[data-related-section]');

  if (!relatedSection) return;

  const cards = Array.from(
    relatedSection.querySelectorAll('.luxury-related__card')
  );

  if (cards.length < 2) return;

  const hoverMedia = window.matchMedia(
    '(hover: hover) and (pointer: fine)'
  );

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let activeIndex = 0;
  let cycleTimer = null;
  let observer = null;

  const setActive = (index) => {

    cards.forEach((card, cardIndex) => {

      card.classList.toggle(
        'is-card-active',
        cardIndex === index
      );

    });

    if (index >= 0) {
      activeIndex = index;
    }

  };

  const stopCycle = () => {

    if (cycleTimer) {
      window.clearInterval(cycleTimer);
      cycleTimer = null;
    }

  };

  const startCycle = () => {

    if (
      reduceMotion ||
      hoverMedia.matches ||
      cards.length < 2
    ) {
      return;
    }

    stopCycle();

    cycleTimer = window.setInterval(() => {

      setActive(
        (activeIndex + 1) % cards.length
      );

    }, 2800);

  };

  const initRelatedAnimation = () => {

    stopCycle();

    if (observer) {
      observer.disconnect();
      observer = null;
    }

    if (hoverMedia.matches) {
      setActive(-1);
      return;
    }

    setActive(0);

    observer = new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {
            startCycle();
          } else {
            stopCycle();
            setActive(0);
          }

        });

      },
      { threshold: 0.35 }
    );

    observer.observe(relatedSection);

  };

  cards.forEach((card, index) => {

    card.addEventListener(
      'touchstart',
      () => {

        stopCycle();

        setActive(index);

      },
      { passive: true }
    );

  });

  initRelatedAnimation();

  hoverMedia.addEventListener(
    'change',
    initRelatedAnimation
  );

})();

