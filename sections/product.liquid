{% stylesheet %}

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap');

/* ============================================================
   DESIGN SYSTEM
   Ink        #1f4d3f  — deep pine, near-black with a cool green cast
   Paper      #f6f8f4  — soft sage-tinted ivory ground
   Surface    #eef2ed  — recessed panels, swatches, thumbnails
   Line       #dbe4dd  — hairline rules
   Muted      #6b7a72  — secondary text
   Accent     #2f6b57  — emerald (CTAs, focus, signature marks)
   Accent-deep#1a3f34  — accent hover / pressed
   Signature  linear-gradient(135deg, #1f4d3f 0%, #2f6b57 42%, #8fb9a8 100%)
              — the house gradient, used on review avatars + the reviews rule
   Display    'Fraunces' — editorial serif, used sparingly for voice
   Body       'Inter'    — neutral workhorse for reading + UI
   Mono       'IBM Plex Mono' — catalog-style labels, price, counters
============================================================ */

.luxury-product {

  --lp-black: #1f4d3f;
  --lp-dark: #163b30;
  --lp-text: #1c2e28;
  --lp-muted: #6b7a72;
  --lp-soft: #eef2ed;
  --lp-border: #dbe4dd;
  --lp-white: #f6f8f4;
  --lp-accent: #2f6b57;
  --lp-accent-deep: #1a3f34;

  color: var(--lp-text);

  padding-top: var(--lp-top-space);
  padding-bottom: var(--lp-bottom-space);

  background: var(--lp-white);

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

  -webkit-font-smoothing: antialiased;
}


.luxury-product *,
.luxury-product *::before,
.luxury-product *::after {
  box-sizing: border-box;
}


.luxury-product button,
.luxury-product input,
.luxury-product select {
  font: inherit;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}


.luxury-product button {
  border: 0;
}


.luxury-product__container {
  width: min(1480px, calc(100% - 80px));
  margin-inline: auto;
}


/* ============================================================
   LAYOUT
============================================================ */

.luxury-product__layout {

  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(400px, .75fr);

  gap: clamp(55px, 7vw, 110px);

  align-items: start;
}


/* ============================================================
   GALLERY
============================================================ */

.luxury-product__gallery {
  min-width: 0;
}


.luxury-product__viewer {

  position: relative;

  overflow: hidden;

  background: var(--lp-soft);

  border-radius: var(--lp-radius);

  isolation: isolate;
}


.luxury-product__slides {

  position: relative;

  width: 100%;

  aspect-ratio: 1 / 1.12;
}


.luxury-product__slide {

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.025);

  transition:
    opacity .35s ease,
    transform .6s cubic-bezier(.2,.65,.2,1),
    visibility .35s ease;
}


.luxury-product__slide.is-active {

  opacity: 1;

  visibility: visible;

  transform: scale(1);

  z-index: 2;
}


.luxury-product__image,
.luxury-product__video,
.luxury-product__slide video,
.luxury-product__slide iframe,
.luxury-product__slide model-viewer {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* ============================================================
   GALLERY COUNTER
============================================================ */

.luxury-product__counter {

  position: absolute;

  z-index: 10;

  top: 20px;
  left: 20px;

  display: flex;

  align-items: center;

  gap: 6px;

  padding: 8px 12px;

  color: #fff;

  background: rgba(32,28,22,.72);

  border-radius: 999px;

  font-family: 'IBM Plex Mono', monospace;

  font-size: 10px;

  letter-spacing: .04em;

  backdrop-filter: blur(12px);
}


.luxury-product__counter-separator {
  opacity: .45;
}


/* ============================================================
   ZOOM
============================================================ */

.luxury-product__zoom {

  position: absolute;

  z-index: 10;

  right: 20px;
  bottom: 20px;

  display: flex;

  align-items: center;

  gap: 8px;

  padding: 10px 14px;

  color: var(--lp-black);

  background: rgba(250,248,243,.95);

  border-radius: 999px;

  cursor: pointer;

  font-size: 11px;

  font-weight: 600;

  letter-spacing: .01em;

  box-shadow: 0 8px 30px rgba(32,28,22,.1);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background-color .2s ease;
}


.luxury-product__zoom svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__zoom:hover {

  transform: translateY(-2px);

  background: #fff;

  box-shadow:
    0 12px 35px rgba(32,28,22,.16);
}


/* ============================================================
   NAVIGATION
============================================================ */

.luxury-product__navigation {

  position: absolute;

  z-index: 10;

  top: 50%;

  width: 46px;
  height: 46px;

  display: grid;

  place-items: center;

  transform: translateY(-50%);

  color: var(--lp-black);

  background: rgba(250,248,243,.96);

  border-radius: 50%;

  cursor: pointer;

  opacity: 0;

  box-shadow: 0 8px 25px rgba(32,28,22,.12);

  transition:
    opacity .2s ease,
    transform .2s ease,
    background-color .2s ease;
}


.luxury-product__viewer:hover
.luxury-product__navigation {

  opacity: 1;
}


.luxury-product__navigation:hover {

  background: #fff;

  transform:
    translateY(-50%)
    scale(1.08);
}


.luxury-product__navigation--prev {
  left: 18px;
}


.luxury-product__navigation--next {
  right: 18px;
}


.luxury-product__navigation svg {

  width: 18px;
  height: 18px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.5;
}


/* ============================================================
   THUMBNAILS
============================================================ */

.luxury-product__thumbnail-wrap {

  margin-top: 16px;
}


.luxury-product__thumbnails {

  display: flex;

  gap: 9px;

  overflow-x: auto;

  padding: 2px;

  scrollbar-width: none;
}


.luxury-product__thumbnails::-webkit-scrollbar {
  display: none;
}


.luxury-product__thumbnail {

  position: relative;

  flex: 0 0 74px;

  width: 74px;
  height: 74px;

  padding: 0;

  overflow: hidden;

  background: var(--lp-soft);

  border-radius: 7px;

  border: 1px solid transparent;

  cursor: pointer;

  opacity: .55;

  transition:
    opacity .2s ease,
    border-color .2s ease,
    transform .2s ease;
}


.luxury-product__thumbnail:hover {

  opacity: .85;

  transform: translateY(-1px);
}


.luxury-product__thumbnail.is-active {

  opacity: 1;

  border-color: var(--lp-accent);
}


.luxury-product__thumbnail-image {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


.luxury-product__thumbnail-icon {

  width: 100%;
  height: 100%;

  display: grid;

  place-items: center;
}


.luxury-product__thumbnail-icon svg {

  width: 20px;
  height: 20px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


/* ============================================================
   PRODUCT INFORMATION
============================================================ */

.luxury-product__details {
  min-width: 0;
  position: relative;
}


.luxury-product__details::before {

  content: '';

  position: absolute;

  top: 6px;
  bottom: 6px;
  left: -55px;

  width: 1px;

  background: var(--lp-border);
}


.luxury-product__details-inner {

  position: sticky;

  top: 80px;

  max-width: 570px;
}


.luxury-product__vendor {

  margin-bottom: 15px;

  color: var(--lp-accent);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 10px;

  font-weight: 500;

  letter-spacing: .18em;

  text-transform: uppercase;
}


.luxury-product__title {

  margin: 0;

  max-width: 550px;

  color: var(--lp-black);

  font-family: 'Fraunces', Georgia, serif;

  font-size: clamp(34px, 3.6vw, 54px);

  line-height: 1.05;

  letter-spacing: -.02em;

  font-weight: 500;
}


/* ============================================================
   RATING
============================================================ */

.luxury-product__rating {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 18px;

  color: var(--lp-muted);

  font-size: 11px;
}


.luxury-product__stars {

  display: flex;

  gap: 2px;

  color: var(--lp-accent);
}


.luxury-product__stars svg {

  width: 13px;
  height: 13px;

  fill: currentColor;
}


/* ============================================================
   PRICE
============================================================ */

.luxury-product__price {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 24px;

  padding-top: 20px;

  border-top: 1px solid var(--lp-border);
}


.luxury-product__price-current {

  color: var(--lp-black);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 19px;

  font-weight: 500;

  letter-spacing: -.01em;
}


.luxury-product__price-compare {

  color: #8a978e;

  font-family: 'IBM Plex Mono', monospace;

  font-size: 13px;

  text-decoration: line-through;
}


.luxury-product__sale {

  padding: 5px 9px;

  color: #fff;

  background: var(--lp-accent);

  border-radius: 999px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .08em;

  text-transform: uppercase;
}


/* ============================================================
   DESCRIPTION
============================================================ */

.luxury-product__description {

  margin-top: 23px;

  color: #445048;

  font-size: 14px;

  line-height: 1.8;
}


.luxury-product__description p:first-child {
  margin-top: 0;
}


.luxury-product__description p:last-child {
  margin-bottom: 0;
}


/* ============================================================
   FORM
============================================================ */

.luxury-product__form {

  margin-top: 34px;
}


/* ============================================================
   OPTIONS
============================================================ */

.luxury-product__options {

  display: grid;

  gap: 27px;

  margin-bottom: 30px;
}


.luxury-product__option {

  padding: 0;

  margin: 0;

  border: 0;
}


.luxury-product__option-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  width: 100%;
  margin: 0 0 14px;
  padding: 0;
  font-size: 13px;
  line-height: 1.4;
  font-weight: 600;
}

.luxury-product__option-name {
  color: var(--lp-black);
  letter-spacing: 0;
}

.luxury-product__option-selected {
  color: var(--lp-muted);
  font-size: 13px;
  font-weight: 400;
  text-align: right;
}


.luxury-product__option-values {

  display: flex;

  flex-wrap: wrap;

  gap: 8px;
}


.luxury-product__choice {

  position: relative;

  cursor: pointer;
}


.luxury-product__choice input {

  position: absolute;

  width: 1px;
  height: 1px;

  opacity: 0;

  pointer-events: none;
}


.luxury-product__choice span {
  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 46px;
  min-width: 76px;

  padding: 11px 18px;

  color: #1c2e28;
  background: #fff;

  text-align: center;

  border: 1px solid var(--lp-border);
  border-radius: 6px;

  font-size: 14px;
  line-height: 1.2;
  font-weight: 500;

  transition:
    color .2s ease,
    background-color .2s ease,
    border-color .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}

.luxury-product__choice:hover:not(.is-disabled) span {
  border-color: var(--lp-accent);
  transform: translateY(-1px);
}

.luxury-product__choice input:checked + span {
  color: #fff;
  background: var(--lp-black);
  border-color: var(--lp-black);

  box-shadow:
    0 4px 14px rgba(32,28,22,.16);
}


.luxury-product__choice.is-disabled {

  opacity: .32;

  cursor: not-allowed;
}


.luxury-product__choice.is-disabled span {

  text-decoration: line-through;
}


/* ============================================================
   HIDDEN SELECT
============================================================ */

.luxury-product__variant-select {
  display: none;
}


/* ============================================================
   PURCHASE AREA
============================================================ */

.luxury-product__purchase-buy {
  display: grid;
  gap: 9px;
}

.luxury-product__purchase {

  display: grid;

  grid-template-columns: 126px minmax(0,1fr);

  gap: 9px;
}


/* ============================================================
   QUANTITY
============================================================ */

.luxury-product__quantity {
  display: grid;

  grid-template-columns: 38px 1fr 38px;

  min-height: 58px;

  overflow: hidden;

  background: #fff;

  border: 1px solid var(--lp-border);
  border-radius: 6px;
}

.luxury-product__quantity button {
  display: grid;
  place-items: center;

  color: var(--lp-black);
  background: transparent;

  cursor: pointer;

  transition:
    background-color .2s ease;
}

.luxury-product__quantity button:hover {
  background: var(--lp-soft);
}

.luxury-product__quantity svg {

  width: 14px;
  height: 14px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__quantity input {

  width: 100%;

  min-width: 0;

  padding: 0;

  border: 0;

  outline: 0;

  background: transparent;

  text-align: center;

  color: #1c2e28;

  font-family: 'IBM Plex Mono', monospace;

  font-size: 12px;

  appearance: textfield;
}


.luxury-product__quantity input::-webkit-inner-spin-button,
.luxury-product__quantity input::-webkit-outer-spin-button {

  appearance: none;

  margin: 0;
}


/* ============================================================
   ADD TO CART
============================================================ */

.luxury-product__add {
  position: relative;

  min-height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  padding: 0 28px;

  color: #fff;
  background: var(--lp-black);

  border-radius: 6px;

  cursor: pointer;

  font-size: 14px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0;

  overflow: hidden;

  transition:
    background-color .25s ease,
    transform .25s ease,
    box-shadow .25s ease;
}

.luxury-product__add::before {
  content: '';

  position: absolute;
  inset: 0;

  background: linear-gradient(
    110deg,
    transparent 20%,
    rgba(255,255,255,.1) 50%,
    transparent 80%
  );

  transform: translateX(-100%);

  transition: transform .65s ease;
}

.luxury-product__add:hover:not(:disabled)::before {
  transform: translateX(100%);
}

.luxury-product__add span,
.luxury-product__add svg {
  position: relative;
  z-index: 1;
}


.luxury-product__add svg {

  width: 16px;
  height: 16px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;

  transition: transform .2s ease;
}


.luxury-product__add:hover:not(:disabled) {

  background: var(--lp-accent-deep);

  transform: translateY(-1px);

  box-shadow:
    0 10px 30px rgba(32,28,22,.2);
}


.luxury-product__add:hover:not(:disabled) svg {

  transform: translateX(3px);
}


.luxury-product__add:disabled {

  opacity: .45;

  cursor: not-allowed;
}


/* ============================================================
   DYNAMIC CHECKOUT
============================================================ */

.luxury-product__dynamic-checkout {

  margin-top: 9px;
}


/* ============================================================
   NOTIFY ME
============================================================ */

.is-hidden {
  display: none !important;
}

.luxury-product__notify-toggle {
  width: 100%;
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 28px;
  color: var(--lp-black);
  background: #fff;
  border: 1px solid var(--lp-black);
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background-color .2s ease,
    color .2s ease,
    transform .2s ease;
}

.luxury-product__notify-toggle:hover {
  background: var(--lp-black);
  color: #fff;
  transform: translateY(-1px);
}

.luxury-product__notify-toggle svg {
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.4;
}

.luxury-product__notify-form {
  margin-top: 14px;
  padding: 18px;
  background: var(--lp-soft);
  border: 1px solid var(--lp-border);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  animation: notify-expand .3s ease;
}

@keyframes notify-expand {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.luxury-product__notify-text {
  margin: 0;
  font-size: 12px;
  color: var(--lp-muted);
  line-height: 1.6;
}

.luxury-product__notify-fields {
  display: grid;
  gap: 8px;
}

.luxury-product__notify-fields input {
  width: 100%;
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid var(--lp-border);
  border-radius: 6px;
  font-size: 13px;
  color: #1c2e28;
  background: #fff;
  transition: border-color .2s ease;
}

.luxury-product__notify-fields input:focus-visible {
  outline: none;
  border-color: var(--lp-accent);
}

.luxury-product__notify-error {
  margin: 0;
  font-size: 11px;
  color: #b3261e;
}

.luxury-product__notify-submit {
  min-height: 48px;
  padding: 0 24px;
  color: #fff;
  background: var(--lp-black);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color .2s ease, transform .2s ease;
}

.luxury-product__notify-submit:hover {
  background: var(--lp-accent-deep);
  transform: translateY(-1px);
}

.luxury-product__notify-submit:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none;
}

.luxury-product__notify-success {
  margin: 0;
  font-size: 12px;
  font-weight: 600;
  color: #1a7a3c;
}


/* ============================================================
   BENEFITS
============================================================ */

.luxury-product__benefits {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-top: 32px;

  padding: 24px 0;

  border-top: 1px solid var(--lp-border);
  border-bottom: 1px solid var(--lp-border);
}

.luxury-product__benefit {

  display: flex;

  flex-direction: column;

  align-items: flex-start;

  gap: 10px;

  min-width: 0;
}


.luxury-product__benefit-icon {

  width: 32px;
  height: 32px;

  display: grid;

  place-items: center;

  color: var(--lp-accent);

  background: var(--lp-soft);

  border-radius: 50%;
}


.luxury-product__benefit-icon svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__benefit strong,
.luxury-product__benefit small {

  display: block;
}


.luxury-product__benefit strong {

  margin-bottom: 3px;

  color: #1c2e28;

  font-size: 10.5px;

  font-weight: 650;
}


.luxury-product__benefit small {

  color: var(--lp-muted);

  font-size: 9.5px;

  line-height: 1.45;
}


/* ============================================================
   ACCORDIONS
============================================================ */


.luxury-product__accordions {
  margin-top: 28px;

  border-top: 1px solid var(--lp-border);
}

.luxury-product__accordion {
  border-bottom: 1px solid var(--lp-border);
}

.luxury-product__accordion summary {
  min-height: 64px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0;

  color: #1c2e28;

  cursor: pointer;

  list-style: none;

  font-size: 14px;
  line-height: 1.4;
  font-weight: 600;

  transition: color .2s ease;
}

.luxury-product__accordion summary:hover {
  color: var(--lp-accent);
}

.luxury-product__accordion-content {
  padding: 0 30px 24px 0;

  color: #445048;

  font-size: 13.5px;
  line-height: 1.8;
}


.luxury-product__accordion summary::-webkit-details-marker {
  display: none;
}


.luxury-product__accordion-icon {

  width: 24px;
  height: 24px;

  display: grid;

  place-items: center;

  color: var(--lp-accent);
}


.luxury-product__accordion-icon svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;

  transition: transform .25s ease;
}


.luxury-product__accordion[open]
.luxury-product__accordion-icon svg {

  transform: rotate(45deg);
}




/* ============================================================
   PLACEHOLDER
============================================================ */

.luxury-product__placeholder {

  min-height: 650px;

  display: grid;

  place-items: center;

  color: var(--lp-muted);

  background: var(--lp-soft);

  border-radius: var(--lp-radius);

  font-size: 12px;
}


/* ============================================================
   LIGHTBOX
============================================================ */

.luxury-product__lightbox {

  position: fixed;

  z-index: 99999;

  inset: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 40px;

  background: rgba(15,13,10,.97);

  opacity: 0;

  visibility: hidden;

  transition:
    opacity .25s ease,
    visibility .25s ease;
}


.luxury-product__lightbox.is-open {

  opacity: 1;

  visibility: visible;
}


.luxury-product__lightbox-content {

  width: min(1200px,90vw);

  height: min(850px,88vh);

  display: flex;

  align-items: center;

  justify-content: center;
}


.luxury-product__lightbox-image {

  width: 100%;
  height: 100%;

  display: flex;

  align-items: center;
  justify-content: center;
}


.luxury-product__lightbox-image img {

  max-width: 100%;
  max-height: 100%;

  width: auto;
  height: auto;

  object-fit: contain;
}


.luxury-product__lightbox-close,
.luxury-product__lightbox-nav {

  position: absolute;

  width: 46px;
  height: 46px;

  display: grid;

  place-items: center;

  color: #fff;

  background: rgba(255,255,255,.1);

  border-radius: 50%;

  cursor: pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}


.luxury-product__lightbox-close:hover,
.luxury-product__lightbox-nav:hover {

  background: rgba(255,255,255,.2);
}


.luxury-product__lightbox-close {

  top: 25px;

  right: 25px;
}


.luxury-product__lightbox-nav {

  top: 50%;

  transform: translateY(-50%);
}


.luxury-product__lightbox-nav:hover {

  transform:
    translateY(-50%)
    scale(1.06);
}


.luxury-product__lightbox-nav--prev {

  left: 25px;
}


.luxury-product__lightbox-nav--next {

  right: 25px;
}


.luxury-product__lightbox-close svg,
.luxury-product__lightbox-nav svg {

  width: 20px;
  height: 20px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__lightbox-counter {

  position: absolute;

  bottom: 25px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  gap: 6px;

  color: rgba(255,255,255,.7);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 11px;
}


/* ============================================================
   FOCUS
============================================================ */

.luxury-product button:focus-visible,
.luxury-product input:focus-visible,
.luxury-product summary:focus-visible,
.luxury-reviews *:focus-visible {

  outline: 2px solid var(--lp-accent, #2f6b57);

  outline-offset: 3px;
}


/* ============================================================================
   CUSTOMER REVIEWS — continuous scrolling ribbon (signature element)
============================================================================ */

.luxury-reviews {

  --rv-ink: #1f4d3f;
  --rv-paper: #eef2ed;
  --rv-line: #dbe4dd;
  --rv-muted: #6b7a72;
  --rv-accent: #2f6b57;

  padding: 84px 0 96px;

  background: var(--rv-paper);

  border-top: 1px solid var(--rv-line);

  overflow: hidden;

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

.luxury-reviews__container {

  width: min(1480px, calc(100% - 80px));

  margin-inline: auto;
}

.luxury-reviews__header {

  text-align: center;

  margin-bottom: 48px;
}

.luxury-reviews__eyebrow {

  display: inline-block;

  margin-bottom: 14px;

  color: var(--rv-accent);

  font-family: 'IBM Plex Mono', monospace;

  font-size: 10.5px;

  font-weight: 500;

  letter-spacing: .2em;

  text-transform: uppercase;
}

.luxury-reviews__title {

  margin: 0;

  color: var(--rv-ink);

  font-family: 'Fraunces', Georgia, serif;

  font-size: clamp(28px, 3.2vw, 42px);

  font-weight: 500;

  letter-spacing: -.02em;
  line-height: 1.1;
}

.luxury-reviews__header::after {

  content: '';

  display: block;

  width: 64px;
  height: 3px;

  margin: 22px auto 0;

  background: linear-gradient(135deg, #1f4d3f 0%, #2f6b57 42%, #8fb9a8 100%);

  border-radius: 999px;
}

/* Marquee viewport */

.luxury-reviews__marquee {

  position: relative;

  width: 100%;

  -webkit-mask-image: linear-gradient(
    90deg,
    transparent 0,
    #000 6%,
    #000 94%,
    transparent 100%
  );

  mask-image: linear-gradient(
    90deg,
    transparent 0,
    #000 6%,
    #000 94%,
    transparent 100%
  );
}

.luxury-reviews__track {

  display: flex;

  width: max-content;

  animation: reviews-scroll 46s linear infinite;
}

.luxury-reviews__marquee:hover .luxury-reviews__track,
.luxury-reviews__marquee:focus-within .luxury-reviews__track {

  animation-play-state: paused;
}

.luxury-reviews__group {

  display: flex;

  gap: 20px;

  padding: 4px 10px;

  flex-shrink: 0;
}

@keyframes reviews-scroll {

  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }

}

/* Cards */

.luxury-reviews__card {

  position: relative;

  flex: 0 0 340px;

  display: flex;

  flex-direction: column;

  gap: 16px;

  padding: 28px 26px 24px;

  background: #fff;

  border: 1px solid var(--rv-line);
  border-top: 3px solid transparent;

  border-radius: 10px;

  background-image:
    linear-gradient(#fff, #fff),
    linear-gradient(135deg, #1f4d3f 0%, #2f6b57 42%, #8fb9a8 100%);
  background-origin: border-box;
  background-clip: padding-box, border-box;

  box-shadow: 0 14px 34px rgba(31,77,63,.08);
}

.luxury-reviews__quote-mark {

  position: absolute;

  top: 10px;
  right: 20px;

  color: var(--rv-line);

  font-family: 'Fraunces', Georgia, serif;

  font-size: 52px;

  line-height: 1;

  user-select: none;
}

.luxury-reviews__stars {

  display: flex;

  gap: 3px;

  color: #d7ddd4;
}

.luxury-reviews__stars svg {

  width: 14px;
  height: 14px;

  fill: currentColor;
}

.luxury-reviews__stars svg.is-filled {

  color: var(--rv-accent);
}

.luxury-reviews__text {

  margin: 0;

  color: #3a453e;

  font-size: 13.5px;

  line-height: 1.75;

  min-height: 88px;
}

.luxury-reviews__person {

  display: flex;

  align-items: center;

  gap: 12px;

  padding-top: 14px;

  border-top: 1px solid var(--rv-line);
}

.luxury-reviews__avatar {

  flex: 0 0 auto;

  width: 38px;
  height: 38px;

  display: grid;

  place-items: center;

  color: #fff;

  background: linear-gradient(135deg, #1f4d3f 0%, #2f6b57 42%, #8fb9a8 100%);

  border-radius: 50%;

  font-family: 'IBM Plex Mono', monospace;

  font-size: 11px;

  font-weight: 500;

  letter-spacing: .02em;
}

.luxury-reviews__person-meta {

  display: flex;

  flex-direction: column;

  gap: 2px;

  min-width: 0;
}

.luxury-reviews__person-meta strong {

  color: var(--rv-ink);

  font-size: 12.5px;

  font-weight: 650;
}

.luxury-reviews__person-meta small {

  color: var(--rv-muted);

  font-size: 10.5px;
}

@media (prefers-reduced-motion: reduce) {

  .luxury-reviews__track {

    animation: none;
  }

  .luxury-reviews__marquee {

    overflow-x: auto;

    scroll-snap-type: x proximity;

    -webkit-mask-image: none;

    mask-image: none;
  }

  .luxury-reviews__group[aria-hidden="true"] {

    display: none;
  }

  .luxury-reviews__card {

    scroll-snap-align: start;
  }

}


/* ============================================================
   LARGE TABLET
============================================================ */

@media (max-width: 1199px) {

  .luxury-product__container {

    width: min(100% - 48px, 1000px);
  }


  .luxury-product__layout {

    grid-template-columns:
      minmax(0,1fr)
      minmax(340px,.8fr);

    gap: 45px;
  }

  .luxury-product__details::before {

    left: -23px;
  }

  .luxury-reviews__container {

    width: min(100% - 48px, 1000px);
  }

}


/* ============================================================
   TABLET
============================================================ */

@media (max-width: 899px) {

  .luxury-product__container {

    width: min(100% - 36px, 720px);
  }


  .luxury-product__layout {

    grid-template-columns: 1fr;

    gap: 45px;
  }


  .luxury-product__details-inner {

    position: static;

    max-width: none;
  }

  .luxury-product__details::before {

    display: none;
  }


  .luxury-product__title {

    max-width: 700px;
  }

  .luxury-reviews {

    padding: 64px 0 76px;
  }

  .luxury-reviews__container {

    width: min(100% - 36px, 720px);
  }

}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width: 599px) {

  .luxury-product {

    padding-top: max(20px,var(--lp-top-space));

    padding-bottom: max(30px,var(--lp-bottom-space));
  }


  .luxury-product__container {

    width: 100%;
  }


  .luxury-product__layout {

    gap: 32px;
  }


  .luxury-product__viewer {

    border-radius: 0;
  }


  .luxury-product__slides {

    aspect-ratio: 1 / 1.12;
  }


  .luxury-product__counter {

    top: 14px;

    left: 14px;
  }


  .luxury-product__zoom {

    right: 14px;

    bottom: 14px;

    padding: 9px 11px;
  }


  .luxury-product__zoom span {

    display: none;
  }


  .luxury-product__navigation {

    width: 38px;
    height: 38px;

    opacity: 1;
  }


  .luxury-product__navigation--prev {

    left: 12px;
  }


  .luxury-product__navigation--next {

    right: 12px;
  }


  .luxury-product__thumbnail-wrap {

    padding-inline: 14px;
  }


  .luxury-product__thumbnail {

    flex-basis: 62px;

    width: 62px;
    height: 62px;
  }


  .luxury-product__details {

    padding-inline: 18px;
  }


  .luxury-product__title {

    font-size: 33px;

    line-height: 1.08;
  }


  .luxury-product__price-current {

    font-size: 18px;
  }


  .luxury-product__description {

    font-size: 13px;

    line-height: 1.75;
  }


  .luxury-product__form {

    margin-top: 27px;
  }


  .luxury-product__purchase {

    grid-template-columns: 100px minmax(0,1fr);
  }


  .luxury-product__quantity {

    grid-template-columns: 27px 1fr 27px;
  }


  .luxury-product__add {

    padding-inline: 12px;
  }


  .luxury-product__benefits {

    gap: 8px;
  }


  .luxury-product__benefit {

    gap: 8px;
  }


  .luxury-product__benefit-icon {

    width: 28px;
    height: 28px;
  }


  .luxury-product__benefit strong {

    font-size: 9px;
  }


  .luxury-product__benefit small {

    font-size: 8px;
  }


  .luxury-product__lightbox {

    padding: 18px;
  }


  .luxury-product__lightbox-content {

    width: 100%;

    height: 80vh;
  }


  .luxury-product__lightbox-close {

    top: 15px;

    right: 15px;

    width: 40px;

    height: 40px;
  }


  .luxury-product__lightbox-nav {

    width: 38px;

    height: 38px;
  }


  .luxury-product__lightbox-nav--prev {

    left: 10px;
  }


  .luxury-product__lightbox-nav--next {

    right: 10px;
  }

  .luxury-reviews {

    padding: 52px 0 64px;
  }

  .luxury-reviews__header {

    margin-bottom: 34px;

    padding-inline: 18px;
  }

  .luxury-reviews__card {

    flex-basis: 270px;

    padding: 22px 20px 20px;
  }

  .luxury-reviews__text {

    font-size: 13px;

    min-height: 108px;
  }

  .luxury-reviews__track {

    animation-duration: 34s;
  }

}


/* ============================================================
   REDUCED MOTION (product gallery)
============================================================ */

@media (prefers-reduced-motion: reduce) {

  .luxury-product *,
  .luxury-product *::before,
  .luxury-product *::after {

    transition-duration: .01ms !important;

    animation-duration: .01ms !important;
  }

}

{% endstylesheet %}


{% javascript %}

(() => {

  const root = document.querySelector('.luxury-product');

  if (!root) return;


  /* ==========================================================
     GALLERY
  ========================================================== */

  const slides = Array.from(
    root.querySelectorAll('[data-product-slide]')
  );

  const thumbnails = Array.from(
    root.querySelectorAll('[data-product-thumbnail]')
  );

  const previousButton =
    root.querySelector('[data-gallery-prev]');

  const nextButton =
    root.querySelector('[data-gallery-next]');

  const currentCounter =
    root.querySelector('[data-gallery-current]');

  const zoomButton =
    root.querySelector('[data-product-zoom]');

  let activeIndex = 0;


  const setActiveSlide = (index) => {

    if (!slides.length) return;

    activeIndex =
      (index + slides.length) % slides.length;


    slides.forEach((slide, slideIndex) => {

      const isActive =
        slideIndex === activeIndex;

      slide.classList.toggle(
        'is-active',
        isActive
      );

      slide.setAttribute(
        'aria-hidden',
        isActive ? 'false' : 'true'
      );

    });


    thumbnails.forEach(
      (thumbnail, thumbnailIndex) => {

        const isActive =
          thumbnailIndex === activeIndex;

        thumbnail.classList.toggle(
          'is-active',
          isActive
        );

        thumbnail.setAttribute(
          'aria-selected',
          isActive ? 'true' : 'false'
        );


        if (isActive) {

          thumbnail.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
          });

        }

      }
    );


    if (currentCounter) {

      currentCounter.textContent =
        String(activeIndex + 1);

    }

  };


  thumbnails.forEach((thumbnail) => {

    thumbnail.addEventListener(
      'click',
      () => {

        setActiveSlide(
          Number(
            thumbnail.dataset.mediaIndex
          )
        );

      }
    );

  });


  previousButton?.addEventListener(
    'click',
    () => setActiveSlide(activeIndex - 1)
  );


  nextButton?.addEventListener(
    'click',
    () => setActiveSlide(activeIndex + 1)
  );


  /* ==========================================================
     SWIPE
  ========================================================== */

  const slidesContainer =
    root.querySelector('[data-product-slides]');

  let touchStartX = 0;

  slidesContainer?.addEventListener(
    'touchstart',
    (event) => {

      touchStartX =
        event.changedTouches[0].screenX;

    },
    { passive: true }
  );


  slidesContainer?.addEventListener(
    'touchend',
    (event) => {

      const touchEndX =
        event.changedTouches[0].screenX;

      const distance =
        touchEndX - touchStartX;

      if (Math.abs(distance) < 45) return;

      if (distance < 0) {

        setActiveSlide(
          activeIndex + 1
        );

      } else {

        setActiveSlide(
          activeIndex - 1
        );

      }

    },
    { passive: true }
  );


  /* ==========================================================
     LIGHTBOX
  ========================================================== */

  const lightbox =
    root.querySelector('[data-product-lightbox]');

  const lightboxImage =
    root.querySelector('[data-lightbox-image]');

  const lightboxCurrent =
    root.querySelector('[data-lightbox-current]');

  const lightboxClose =
    root.querySelector('[data-lightbox-close]');

  const lightboxPrevious =
    root.querySelector('[data-lightbox-prev]');

  const lightboxNext =
    root.querySelector('[data-lightbox-next]');


  const openLightbox = () => {

    if (!lightbox || !lightboxImage) return;

    const slide =
      slides[activeIndex];

    const image =
      slide?.querySelector('img');

    if (!image) return;


    const fullImage =
      document.createElement('img');

    fullImage.src =
      image.currentSrc || image.src;

    fullImage.alt =
      image.alt || '';

    fullImage.decoding = 'async';


    lightboxImage.replaceChildren(
      fullImage
    );


    if (lightboxCurrent) {

      lightboxCurrent.textContent =
        String(activeIndex + 1);

    }


    lightbox.classList.add('is-open');

    lightbox.setAttribute(
      'aria-hidden',
      'false'
    );


    document.documentElement.style.overflow =
      'hidden';

  };


  const closeLightbox = () => {

    if (!lightbox) return;

    lightbox.classList.remove(
      'is-open'
    );

    lightbox.setAttribute(
      'aria-hidden',
      'true'
    );

    document.documentElement.style.overflow =
      '';

  };


  zoomButton?.addEventListener(
    'click',
    openLightbox
  );


  lightboxClose?.addEventListener(
    'click',
    closeLightbox
  );


  lightbox?.addEventListener(
    'click',
    (event) => {

      if (event.target === lightbox) {

        closeLightbox();

      }

    }
  );


  lightboxPrevious?.addEventListener(
    'click',
    () => {

      setActiveSlide(
        activeIndex - 1
      );

      openLightbox();

    }
  );


  lightboxNext?.addEventListener(
    'click',
    () => {

      setActiveSlide(
        activeIndex + 1
      );

      openLightbox();

    }
  );


  document.addEventListener(
    'keydown',
    (event) => {

      if (
        !lightbox?.classList.contains(
          'is-open'
        )
      ) {
        return;
      }


      if (event.key === 'Escape') {

        closeLightbox();

      }


      if (event.key === 'ArrowLeft') {

        setActiveSlide(
          activeIndex - 1
        );

        openLightbox();

      }


      if (event.key === 'ArrowRight') {

        setActiveSlide(
          activeIndex + 1
        );

        openLightbox();

      }

    }
  );


  /* ==========================================================
     QUANTITY
  ========================================================== */

  const quantityInput =
    root.querySelector(
      'input[name="quantity"]'
    );

  const quantityMinus =
    root.querySelector(
      '[data-quantity-minus]'
    );

  const quantityPlus =
    root.querySelector(
      '[data-quantity-plus]'
    );


  quantityMinus?.addEventListener(
    'click',
    () => {

      if (!quantityInput) return;

      quantityInput.value =
        Math.max(
          1,
          Number(
            quantityInput.value || 1
          ) - 1
        );

      quantityInput.dispatchEvent(
        new Event(
          'change',
          { bubbles: true }
        )
      );

    }
  );


  quantityPlus?.addEventListener(
    'click',
    () => {

      if (!quantityInput) return;

      quantityInput.value =
        Number(
          quantityInput.value || 1
        ) + 1;

      quantityInput.dispatchEvent(
        new Event(
          'change',
          { bubbles: true }
        )
      );

    }
  );


  /* ==========================================================
     VARIANTS
  ========================================================== */

  const variantSelect =
    root.querySelector(
      '[data-product-variant]'
    );

  const optionInputs =
    Array.from(
      root.querySelectorAll(
        '[data-option-input]'
      )
    );

  const priceElement =
    root.querySelector('[data-price]');

  const compareElement =
    root.querySelector('[data-compare-price]');

  const saleBadge =
    root.querySelector('[data-sale-badge]');

  const addButton =
    root.querySelector('[data-add-to-cart]');

  const addLabel =
    root.querySelector('[data-add-label]');

  const purchaseBuy =
    root.querySelector('[data-purchase-buy]');

  const purchaseNotify =
    root.querySelector('[data-purchase-notify]');


  const formatMoney = (cents) => {

    if (
      window.Shopify &&
      typeof Shopify.formatMoney ===
        'function'
    ) {

      return Shopify.formatMoney(
        cents,
        Shopify.money_format
      );

    }

    return (
      Number(cents) / 100
    ).toLocaleString(
      undefined,
      {
        style: 'currency',
        currency: 'INR'
      }
    );

  };


  const updateVariant = () => {

    if (!variantSelect) return;


    const selectedValues =
      optionInputs
        .filter(
          input => input.checked
        )
        .map(
          input => input.value
        );


    let matchingVariant = null;


    Array.from(
      variantSelect.options
    ).forEach((option) => {

      const title =
        option.textContent
          .split(' — ')[0]
          .trim();

      const values =
        title
          .split(' / ')
          .map(
            value => value.trim()
          );


      const matches =
        selectedValues.every(
          (value, index) =>
            values[index] === value
        );


      if (matches) {

        matchingVariant =
          option;

      }

    });


    if (!matchingVariant) return;


    variantSelect.value =
      matchingVariant.value;


    const price =
      Number(
        matchingVariant.dataset.price || 0
      );

    const comparePrice =
      Number(
        matchingVariant.dataset.comparePrice || 0
      );

    const available =
      matchingVariant.dataset.available ===
      'true';


    if (priceElement) {

      priceElement.textContent =
        formatMoney(price);

    }


    if (compareElement) {

      if (comparePrice > price) {

        compareElement.hidden = false;

        compareElement.textContent =
          formatMoney(comparePrice);

      } else {

        compareElement.hidden = true;

      }

    }


    if (saleBadge) {

      saleBadge.hidden =
        !(comparePrice > price);

    }


    if (addButton) {

      addButton.disabled =
        !available;

    }


    if (addLabel) {

      const defaultAddLabel =
        root.dataset.addToCartLabel || 'Add to cart';

      addLabel.textContent =
        defaultAddLabel;

    }


    if (purchaseBuy && purchaseNotify) {

      purchaseBuy.classList.toggle(
        'is-hidden',
        !available
      );

      purchaseNotify.classList.toggle(
        'is-hidden',
        available
      );


      if (!available) {

        notifyFormPanel?.classList.add('is-hidden');
        notifySuccess?.classList.add('is-hidden');
        notifyError?.classList.add('is-hidden');

        if (notifyEmail) notifyEmail.value = '';
        if (notifyPhone) notifyPhone.value = '';

      }

    }

  };


  optionInputs.forEach((input) => {

    input.addEventListener(
      'change',
      updateVariant
    );

  });


  /* ==========================================================
     NOTIFY ME
  ========================================================== */

  const notifyToggle =
    root.querySelector('[data-notify-toggle]');

  const notifyFormPanel =
    root.querySelector('[data-notify-form]');

  const notifyEmail =
    root.querySelector('[data-notify-email]');

  const notifyPhone =
    root.querySelector('[data-notify-phone]');

  const notifyError =
    root.querySelector('[data-notify-error]');

  const notifySubmit =
    root.querySelector('[data-notify-submit]');

  const notifySuccess =
    root.querySelector('[data-notify-success]');


  notifyToggle?.addEventListener(
    'click',
    () => {

      notifyFormPanel?.classList.toggle(
        'is-hidden'
      );

    }
  );


  notifySubmit?.addEventListener(
    'click',
    async () => {

      const email =
        notifyEmail?.value.trim() || '';

      const phone =
        notifyPhone?.value.trim() || '';


      if (!email && !phone) {

        notifyError.textContent =
          'Please enter your email or phone number.';

        notifyError?.classList.remove(
          'is-hidden'
        );

        return;

      }


      notifyError?.classList.add(
        'is-hidden'
      );

      notifySubmit.disabled = true;

      notifySubmit.textContent =
        'Submitting…';


      try {

        const selectedVariant =
          variantSelect?.options[
            variantSelect.selectedIndex
          ];

        const variantTitle =
          selectedVariant?.textContent.trim() ||
          '';

        const body =
          new URLSearchParams();

        body.append(
          'form_type',
          'contact'
        );

        body.append(
          'utf8',
          '✓'
        );

        body.append(
          'contact[email]',
          email
        );

        body.append(
          'contact[phone]',
          phone
        );

        body.append(
          'contact[body]',
          `Back-in-stock request — Product: ${document.title} | Variant: ${variantTitle} | Variant ID: ${variantSelect?.value || 'n/a'} | Email: ${email || 'n/a'} | Phone: ${phone || 'n/a'}`
        );


        await fetch(
          '/contact',
          {
            method: 'POST',
            headers: {
              'Content-Type':
                'application/x-www-form-urlencoded'
            },
            body: body.toString()
          }
        );


        notifyFormPanel?.classList.add(
          'is-hidden'
        );

        notifySuccess?.classList.remove(
          'is-hidden'
        );

        notifyEmail.value = '';

        notifyPhone.value = '';


      } catch (error) {

        notifyError.textContent =
          'Something went wrong. Please try again.';

        notifyError?.classList.remove(
          'is-hidden'
        );


      } finally {

        notifySubmit.disabled = false;

        notifySubmit.textContent =
          'Submit';

      }

    }
  );


  updateVariant();

})();

{% endjavascript %}


