  margin-top: 18px;

  color: var(--rel-muted);

  font-family:
    'IBM Plex Mono',
    monospace;

  font-size: 9px;

  letter-spacing: .08em;

  text-transform: uppercase;
}


.luxury-related__mobile-line {

  position: relative;

  width: 48px;

  height: 1px;

  overflow: hidden;

  background: var(--rel-line);
}


.luxury-related__mobile-line span {

