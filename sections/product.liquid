{% comment %}
  PREMIUM PRODUCT PAGE
  ------------------------------------------------------------
  Visual direction:
  - Luxury / premium ecommerce
  - Minimal borders
  - Editorial typography
  - Large product imagery
  - Clean thumbnails
  - Professional option selectors
  - Sticky information panel
  - Responsive mobile layout
  - Existing gallery/lightbox/variant functionality retained
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'product-form-' | append: section.id %}

<section
  class="luxury-product"
  data-add-to-cart-label="{{ section.settings.add_to_cart_label | escape }}"
  style="
    --lp-top-space: {{ section.settings.padding_top }}px;
    --lp-bottom-space: {{ section.settings.padding_bottom }}px;
    --lp-radius: {{ section.settings.image_radius }}px;
  "
>

  <div class="luxury-product__container">

    <div class="luxury-product__layout">

      <!-- =====================================================
           GALLERY
      ====================================================== -->

      <div class="luxury-product__gallery">

        {% if product.media.size > 0 %}

          <div class="luxury-product__viewer">

            <div class="luxury-product__counter">
              <span data-gallery-current>1</span>
              <span class="luxury-product__counter-separator">/</span>
              <span>{{ product.media.size }}</span>
            </div>

            <button
              type="button"
              class="luxury-product__zoom"
              data-product-zoom
              aria-label="View larger image"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
                <path d="M16 3h3a2 2 0 0 1 2 2v3"/>
                <path d="M8 21H5a2 2 0 0 1-2-2v-3"/>
                <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
              </svg>

              <span>View larger</span>
            </button>

            <div
              class="luxury-product__slides"
              data-product-slides
            >

              {% for media in product.media %}

                <div
                  class="luxury-product__slide{% if forloop.first %} is-active{% endif %}"
                  data-product-slide
                  data-media-id="{{ media.id }}"
                  data-media-index="{{ forloop.index0 }}"
                  data-media-type="{{ media.media_type }}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                >

                  {% if media.media_type == 'image' %}

                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '480, 720, 960, 1200, 1500, 1800',
                        sizes: '(min-width: 1000px) 55vw, 100vw',
                        class: 'luxury-product__image',
                        alt: media.alt | default: product.title
                    }}

                  {% elsif media.media_type == 'video' %}

                    {{
                      media
                      | video_tag:
                        controls: true,
                        muted: true,
                        loop: true,
                        playsinline: true,
                        class: 'luxury-product__video'
                    }}

                  {% elsif media.media_type == 'external_video' %}

                    {{ media | external_video_tag }}

                  {% elsif media.media_type == 'model' %}

                    {{ media | model_viewer_tag }}

                  {% endif %}

                </div>

              {% endfor %}

            </div>


            {% if product.media.size > 1 %}

              <button
                type="button"
                class="luxury-product__navigation luxury-product__navigation--prev"
                data-gallery-prev
                aria-label="Previous product image"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 18 9 12l6-6"/>
                </svg>
              </button>

              <button
                type="button"
                class="luxury-product__navigation luxury-product__navigation--next"
                data-gallery-next
                aria-label="Next product image"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>

            {% endif %}

          </div>


          {% if product.media.size > 1 %}

            <div class="luxury-product__thumbnail-wrap">

              <div
                class="luxury-product__thumbnails"
                data-product-thumbnails
                role="tablist"
                aria-label="Product images"
              >

                {% for media in product.media %}

                  <button
                    type="button"
                    class="luxury-product__thumbnail{% if forloop.first %} is-active{% endif %}"
                    data-product-thumbnail
                    data-media-index="{{ forloop.index0 }}"
                    role="tab"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="View product image {{ forloop.index }}"
                  >

                    {% if media.media_type == 'image' %}

                      {{
                        media
                        | image_url: width: 220
                        | image_tag:
                          loading: 'lazy',
                          widths: '100, 160, 220',
                          sizes: '72px',
                          class: 'luxury-product__thumbnail-image',
                          alt: media.alt | default: product.title
                      }}

                    {% else %}

                      <span class="luxury-product__thumbnail-icon">

                        {% if media.media_type == 'video' %}

                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 5v14l11-7z"/>
                          </svg>

                        {% else %}

                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3v18M3 12h18"/>
                          </svg>

                        {% endif %}

                      </span>

                    {% endif %}

                  </button>

                {% endfor %}

              </div>

            </div>

          {% endif %}

        {% else %}

          <div class="luxury-product__placeholder">
            <span>No image available</span>
          </div>

        {% endif %}

      </div>


      <!-- =====================================================
           PRODUCT INFORMATION
      ====================================================== -->

      <div class="luxury-product__details">

        <div class="luxury-product__details-inner">

          {% if section.settings.show_vendor and product.vendor != blank %}

            <div class="luxury-product__vendor">
              {{ product.vendor }}
            </div>

          {% endif %}


          <h1 class="luxury-product__title">
            {{ product.title }}
          </h1>


          {% if section.settings.show_rating %}

            <div class="luxury-product__rating">

              <span class="luxury-product__stars">

                {% for i in (1..5) %}

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 3.8 2.58 5.23 5.77.84-4.18 4.08.99 5.75L12 16.98l-5.16 2.72.99-5.75-4.18-4.08 5.77-.84L12 3.8Z"/>
                  </svg>

                {% endfor %}

              </span>

              <span>
                {{ section.settings.rating_text }}
              </span>

            </div>

          {% endif %}


          <div class="luxury-product__price">

            {% if current_variant.compare_at_price > current_variant.price %}

              <span
                class="luxury-product__price-current"
                data-price
              >
                {{ current_variant.price | money }}
              </span>

              <span
                class="luxury-product__price-compare"
                data-compare-price
              >
                {{ current_variant.compare_at_price | money }}
              </span>

              <span
                class="luxury-product__sale"
                data-sale-badge
              >
                Sale
              </span>

            {% else %}

              <span
                class="luxury-product__price-current"
                data-price
              >
                {{ current_variant.price | money }}
              </span>

              <span
                class="luxury-product__price-compare"
                data-compare-price
                hidden
              ></span>

              <span
                class="luxury-product__sale"
                data-sale-badge
                hidden
              >
                Sale
              </span>

            {% endif %}

          </div>


          {% if product.description != blank and section.settings.show_description %}

            <div class="luxury-product__description rte">
              {{ product.description }}
            </div>

          {% endif %}


          <!-- PRODUCT FORM -->

          {% form 'product',
            product,
            id: product_form_id,
            class: 'luxury-product__form'
          %}


            {% unless product.has_only_default_variant %}

              <div class="luxury-product__options">

                {% for option in product.options_with_values %}

                  <fieldset
                    class="luxury-product__option"
                    data-option-index="{{ forloop.index0 }}"
                  >

                  <legend class="luxury-product__option-heading">

  <span class="luxury-product__option-name">
    {{ option.name }}
  </span>

  <span
    class="luxury-product__option-selected"
    data-option-value
  >
    {{ option.selected_value }}
  </span>

</legend>


                    <div class="luxury-product__option-values">

                      {% for value in option.values %}

                        {% assign option_disabled = true %}

                        {% for variant in product.variants %}

                          {% case forloop.parentloop.index %}

                            {% when 1 %}

                              {% if variant.option1 == value and variant.available %}
                                {% assign option_disabled = false %}
                              {% endif %}

                            {% when 2 %}

                              {% if variant.option2 == value and variant.available %}
                                {% assign option_disabled = false %}
                              {% endif %}

                            {% when 3 %}

                              {% if variant.option3 == value and variant.available %}
                                {% assign option_disabled = false %}
                              {% endif %}

                          {% endcase %}

                        {% endfor %}


                        <label
                          class="
                            luxury-product__choice
                            {% if option_disabled %}is-disabled{% endif %}
                          "
                        >

                          <input
                            type="radio"
                            name="option{{ option.position }}"
                            value="{{ value | escape }}"
                            data-option-input
                            data-option-position="{{ option.position }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            {% if option_disabled %}disabled{% endif %}
                          >

                          <span>
                            {{ value }}
                          </span>

                        </label>

                      {% endfor %}

                    </div>

                  </fieldset>

                {% endfor %}

              </div>

            {% endunless %}


            <select
              name="id"
              class="luxury-product__variant-select"
              data-product-variant
              aria-label="Product variant"
            >

              {% for variant in product.variants %}

                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                  data-available="{{ variant.available }}"
                  {% if variant == current_variant %}selected{% endif %}
                >
                  {{ variant.title }}
                </option>

              {% endfor %}

            </select>


            <!-- PURCHASE -->

            <div class="luxury-product__purchase">

              <div class="luxury-product__quantity">

                <button
                  type="button"
                  data-quantity-minus
                  aria-label="Decrease quantity"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14"/>
                  </svg>
                </button>

                <input
                  id="Quantity-{{ section.id }}"
                  type="number"
                  name="quantity"
                  min="1"
                  value="1"
                  inputmode="numeric"
                  aria-label="Quantity"
                >

                <button
                  type="button"
                  data-quantity-plus
                  aria-label="Increase quantity"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"/>
                  </svg>
                </button>

              </div>


              <button
                type="submit"
                class="luxury-product__add"
                data-add-to-cart
                {% unless current_variant.available %}disabled{% endunless %}
              >

                <span data-add-label>

                  {% if current_variant.available %}
                    {{ section.settings.add_to_cart_label }}
                  {% else %}
                    Sold out
                  {% endif %}

                </span>

                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14"/>
                  <path d="m13 6 6 6-6 6"/>
                </svg>

              </button>

            </div>


            {% if section.settings.show_dynamic_checkout %}

              <div class="luxury-product__dynamic-checkout">
                {{ form | payment_button }}
              </div>

            {% endif %}


          {% endform %}


          <!-- =================================================
               TRUST
          ================================================== -->

          {% if section.settings.show_trust_items %}

            <div class="luxury-product__benefits">

              <div class="luxury-product__benefit">

                <span class="luxury-product__benefit-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 20 6v5c0 4.8-3.1 8.9-8 10-4.9-1.1-8-5.2-8-10V6l8-3Z"/>
                    <path d="m8.5 12 2.2 2.2 4.8-5"/>
                  </svg>

                </span>

                <span>
                  <strong>{{ section.settings.trust_1_title }}</strong>
                  <small>{{ section.settings.trust_1_text }}</small>
                </span>

              </div>


              <div class="luxury-product__benefit">

                <span class="luxury-product__benefit-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 6h11v11H3z"/>
                    <path d="M14 10h4l3 3v4h-7z"/>
                    <circle cx="7" cy="18" r="2"/>
                    <circle cx="18" cy="18" r="2"/>
                  </svg>

                </span>

                <span>
                  <strong>{{ section.settings.trust_2_title }}</strong>
                  <small>{{ section.settings.trust_2_text }}</small>
                </span>

              </div>


              <div class="luxury-product__benefit">

                <span class="luxury-product__benefit-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 11a8 8 0 1 1-2.35-5.66"/>
                    <path d="M20 4v7h-7"/>
                  </svg>

                </span>

                <span>
                  <strong>{{ section.settings.trust_3_title }}</strong>
                  <small>{{ section.settings.trust_3_text }}</small>
                </span>

              </div>

            </div>

          {% endif %}


          <!-- =================================================
               ACCORDIONS
          ================================================== -->

          {% if section.blocks.size > 0 %}

            <div class="luxury-product__accordions">

              {% for block in section.blocks %}

                <details
                  class="luxury-product__accordion"
                  {{ block.shopify_attributes }}
                  {% if forloop.first %}open{% endif %}
                >

                  <summary>

                    <span>
                      {{ block.settings.title }}
                    </span>

                    <span class="luxury-product__accordion-icon">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                    </span>

                  </summary>

                  <div class="luxury-product__accordion-content rte">
                    {{ block.settings.content }}
                  </div>

                </details>

              {% endfor %}

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  </div>


  <!-- =======================================================
       LIGHTBOX
  ======================================================== -->

  {% if product.media.size > 0 %}

    <div
      class="luxury-product__lightbox"
      data-product-lightbox
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Product image viewer"
    >

      <button
        type="button"
        class="luxury-product__lightbox-close"
        data-lightbox-close
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"/>
        </svg>
      </button>


      <button
        type="button"
        class="luxury-product__lightbox-nav luxury-product__lightbox-nav--prev"
        data-lightbox-prev
        aria-label="Previous image"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>


      <div class="luxury-product__lightbox-content">

        <div
          class="luxury-product__lightbox-image"
          data-lightbox-image
        ></div>

      </div>


      <button
        type="button"
        class="luxury-product__lightbox-nav luxury-product__lightbox-nav--next"
        data-lightbox-next
        aria-label="Next image"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>


      <div class="luxury-product__lightbox-counter">

        <span data-lightbox-current>1</span>

        <span>/</span>

        <span>{{ product.media.size }}</span>

      </div>

    </div>

  {% endif %}

</section>


{% stylesheet %}

/* ============================================================
   DESIGN SYSTEM
============================================================ */

.luxury-product {

  --lp-black: #151515;
  --lp-dark: #242424;
  --lp-text: #242424;
  --lp-muted: #777;
  --lp-soft: #f7f6f3;
  --lp-border: #e9e7e3;
  --lp-white: #fff;

  color: var(--lp-text);

  padding-top: var(--lp-top-space);
  padding-bottom: var(--lp-bottom-space);

  background: #fff;

  -webkit-font-smoothing: antialiased;
}


.luxury-product *,
.luxury-product *::before,
.luxury-product *::after {
  box-sizing: border-box;
}


.luxury-product button,
.luxury-product input,
.luxury-product select {
  font: inherit;
}


.luxury-product button {
  border: 0;
}


.luxury-product__container {
  width: min(1480px, calc(100% - 80px));
  margin-inline: auto;
}


/* ============================================================
   LAYOUT
============================================================ */

.luxury-product__layout {

  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(400px, .75fr);

  gap: clamp(55px, 7vw, 110px);

  align-items: start;
}


/* ============================================================
   GALLERY
============================================================ */

.luxury-product__gallery {
  min-width: 0;
}


.luxury-product__viewer {

  position: relative;

  overflow: hidden;

  background: #f5f4f1;

  border-radius: var(--lp-radius);

  isolation: isolate;
}


.luxury-product__slides {

  position: relative;

  width: 100%;

  aspect-ratio: 1 / 1.12;
}


.luxury-product__slide {

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.025);

  transition:
    opacity .35s ease,
    transform .6s cubic-bezier(.2,.65,.2,1),
    visibility .35s ease;
}


.luxury-product__slide.is-active {

  opacity: 1;

  visibility: visible;

  transform: scale(1);

  z-index: 2;
}


.luxury-product__image,
.luxury-product__video,
.luxury-product__slide video,
.luxury-product__slide iframe,
.luxury-product__slide model-viewer {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* ============================================================
   GALLERY COUNTER
============================================================ */

.luxury-product__counter {

  position: absolute;

  z-index: 10;

  top: 20px;
  left: 20px;

  display: flex;

  align-items: center;

  gap: 6px;

  padding: 8px 11px;

  color: #fff;

  background: rgba(20,20,20,.68);

  border-radius: 999px;

  font-size: 10px;

  letter-spacing: .04em;

  backdrop-filter: blur(12px);
}


.luxury-product__counter-separator {
  opacity: .45;
}


/* ============================================================
   ZOOM
============================================================ */

.luxury-product__zoom {

  position: absolute;

  z-index: 10;

  right: 20px;
  bottom: 20px;

  display: flex;

  align-items: center;

  gap: 8px;

  padding: 10px 14px;

  color: var(--lp-black);

  background: rgba(255,255,255,.94);

  border-radius: 999px;

  cursor: pointer;

  font-size: 11px;

  font-weight: 600;

  letter-spacing: .01em;

  box-shadow: 0 8px 30px rgba(0,0,0,.08);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


.luxury-product__zoom svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


.luxury-product__zoom:hover {

  transform: translateY(-2px);

  box-shadow:
    0 12px 35px rgba(0,0,0,.13);
}


/* ============================================================
   NAVIGATION
============================================================ */

.luxury-product__navigation {

  position: absolute;

  z-index: 10;

  top: 50%;

  width: 46px;
  height: 46px;

  display: grid;

  place-items: center;

  transform: translateY(-50%);

  color: var(--lp-black);

  background: rgba(255,255,255,.95);

  border-radius: 50%;

  cursor: pointer;

  opacity: 0;

  box-shadow: 0 8px 25px rgba(0,0,0,.1);

  transition:
    opacity .2s ease,
    transform .2s ease;
}


.luxury-product__viewer:hover
.luxury-product__navigation {

  opacity: 1;
}


.luxury-product__navigation:hover {

  transform:
    translateY(-50%)
    scale(1.08);
}


.luxury-product__navigation--prev {
  left: 18px;
}


.luxury-product__navigation--next {
  right: 18px;
}


.luxury-product__navigation svg {

  width: 18px;
  height: 18px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.5;
}


/* ============================================================
   THUMBNAILS
============================================================ */

.luxury-product__thumbnail-wrap {

  margin-top: 16px;
}


.luxury-product__thumbnails {

  display: flex;

  gap: 9px;

  overflow-x: auto;

  padding: 2px;

  scrollbar-width: none;
}


.luxury-product__thumbnails::-webkit-scrollbar {
  display: none;
}


.luxury-product__thumbnail {

  position: relative;

  flex: 0 0 74px;

  width: 74px;
  height: 74px;

  padding: 0;

  overflow: hidden;

  background: #f4f3f0;

  border-radius: 7px;

  border: 1px solid transparent;

  cursor: pointer;

  opacity: .58;

  transition:
    opacity .2s ease,
    border-color .2s ease,
    transform .2s ease;
}


.luxury-product__thumbnail:hover {

  opacity: .85;

  transform: translateY(-1px);
}


.luxury-product__thumbnail.is-active {

  opacity: 1;

  border-color: var(--lp-black);
}


.luxury-product__thumbnail-image {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


.luxury-product__thumbnail-icon {

  width: 100%;
  height: 100%;

  display: grid;

  place-items: center;
}


.luxury-product__thumbnail-icon svg {

  width: 20px;
  height: 20px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.4;
}


/* ============================================================
   PRODUCT INFORMATION
============================================================ */

.luxury-product__details {
  min-width: 0;
}


.luxury-product__details-inner {

  position: sticky;

  top: 80px;

  max-width: 570px;
}


.luxury-product__vendor {

  margin-bottom: 15px;

  color: var(--lp-muted);

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .18em;

  text-transform: uppercase;
}


.luxury-product__title {

  margin: 0;

  max-width: 550px;

  color: var(--lp-black);

  font-size: clamp(34px, 3.8vw, 58px);

  line-height: 1.02;

  letter-spacing: -.045em;

  font-weight: 500;
}


/* ============================================================
   RATING
============================================================ */

.luxury-product__rating {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 18px;

  color: var(--lp-muted);

  font-size: 11px;
}


.luxury-product__stars {

  display: flex;

  gap: 2px;
}


.luxury-product__stars svg {

  width: 13px;
  height: 13px;

  fill: currentColor;
}


/* ============================================================
   PRICE
============================================================ */

.luxury-product__price {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 24px;
}


.luxury-product__price-current {

  color: var(--lp-black);

  font-size: 21px;

  font-weight: 600;

  letter-spacing: -.02em;
}


.luxury-product__price-compare {

  color: #999;

  font-size: 14px;

  text-decoration: line-through;
}


.luxury-product__sale {

  padding: 5px 8px;

  color: #fff;

  background: var(--lp-black);

  border-radius: 999px;

