{% comment %}
  Full search results page. Used on the search template.
{% endcomment %}

<div class="search-page">
  <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      class="search-form__input"
    >
    <button type="submit" class="search-form__submit">{{ 'search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="search-page__empty">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p class="search-page__count">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      <div class="search-results">
        {% paginate search.results by 20 %}
          {% for result in search.results %}
            <div class="search-result">
              {% assign featured_image = result.featured_image | default: result.image %}
              {% if featured_image %}
                <a href="{{ result.url }}" class="search-result__image-link">
                  {{
                    featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 500, 700',
                      sizes: '(min-width: 750px) 25vw, 50vw',
                      class: 'search-result__image',
                      alt: featured_image.alt | default: result.title
                  }}
                </a>
              {% else %}
                <div class="search-result__image-link search-result__image-link--placeholder" aria-hidden="true"></div>
              {% endif %}

              <div class="search-result__content">
                <p class="search-result__title">
                  <a href="{{ result.url }}">{{ result.title }}</a>
                </p>
                {% if result.price %}
                  <p class="search-result__price">{{ result.price | money_with_currency }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endpaginate %}
      </div>

      <div class="search-pagination">
        {% paginate search.results by 20 %}
          {{ paginate | default_pagination }}
        {% endpaginate %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .search-page {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .search-page__title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .search-form {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0.5rem;
    margin: 0 auto 2rem;
    width: min(500px, 100%);
  }

  .search-form__input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-form__input:focus {
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 3px var(--color-focus-outline);
  }

  .search-form__submit {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-surface);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
  }

  .search-form__submit:hover {
    background: var(--color-foreground);
  }

  .search-form__submit:active {
    transform: scale(0.97);
  }

  .search-page__count,
  .search-page__empty {
    text-align: center;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .search-result {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 1px 3px var(--color-shadow-medium);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .search-result:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px var(--color-shadow-medium);
  }

  .search-result__image-link {
    display: block;
    flex-shrink: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background:
      color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }

  .search-result__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
  }

  .search-result:hover .search-result__image {
    transform: scale(1.05);
  }

  .search-result__image-link--placeholder {
    background: repeating-linear-gradient(
      45deg,
      var(--color-background),
      var(--color-background) 10px,
      var(--color-border) 10px,
      var(--color-border) 20px
    );
  }

  .search-result__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem 1.1rem;
  }

  .search-result__title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result__title a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .search-result__title a:hover {
    text-decoration: underline;
  }

  .search-result__price {
    margin: auto 0 0;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .search-pagination {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  @media (max-width: 749px) {
    .search-page {
      padding: 1.25rem 0 2.5rem;
    }

    .search-page__title {
      font-size: 1.5rem;
      margin-bottom: 1.15rem;
    }

    .search-form__input,
    .search-form__submit {
      min-height: 2.75rem;
    }

    .search-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .search-result__content {
      padding: 0.7rem 0.75rem 0.9rem;
    }

    .search-result__title {
      font-size: 0.86rem;
    }
  }

  @media (max-width: 480px) {
    .search-form {
      flex-direction: column;
    }

    .search-form__submit {
      width: 100%;
    }

    .search-page__count,
    .search-page__empty {
      font-size: 0.9rem;
      padding-inline: 0.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
