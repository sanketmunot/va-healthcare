<section
  class="image-text"
  style="padding-block: {{ section.settings.padding }}px; --image-text-order: {% if section.settings.layout == 'text_first' %}row-reverse{% else %}row{% endif %};"
>
  <div class="image-text__grid">
    <div class="image-text__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400', sizes: '(min-width: 900px) 45vw, 100vw', class: 'image-text__image'
        }}
      {% else %}
        <div class="image-text__placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
    <div class="image-text__content animate-in">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="image-text__text rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .image-text__grid {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .image-text__media,
  .image-text__placeholder {
    min-height: 18rem;
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
  }

  .image-text__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 18rem;
  }

  .image-text__placeholder {
    background:
      var(--color-image-tint);
  }

  .image-text__text {
    color: var(--color-muted);
    margin: 0.85rem 0 1.4rem;
  }

  .image-text__text p + p {
    margin-top: 0.75rem;
  }

  @media (min-width: 900px) {
    .image-text__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
      direction: ltr;
    }

    .image-text {
      --unused: var(--image-text-order);
    }

    .image-text__grid {
      display: flex;
      flex-direction: var(--image-text-order);
    }

    .image-text__media,
    .image-text__content {
      flex: 1;
    }

    .image-text__image,
    .image-text__placeholder {
      min-height: 28rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our approach"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulated for everyday recovery"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Soft textures, clean ingredients, and routines that fit real life — without the clinical coldness.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
