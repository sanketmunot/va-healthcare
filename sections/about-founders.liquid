{% liquid
  assign about_page = false
  assign page_handle = page.handle | default: '' | downcase
  assign page_title_down = page.title | default: '' | downcase
  if template.suffix == 'about'
    assign about_page = true
  endif
  if page_handle contains 'about'
    assign about_page = true
  endif
  if page_title_down contains 'about'
    assign about_page = true
  endif
%}

{% if about_page %}
<section class="about-founders" style="padding-block: {{ section.settings.padding }}px;">
  <div class="about-founders__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <p class="section-subheading">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <ul class="about-founders__grid" role="list">
      {% for block in section.blocks %}
        <li class="about-founders__card" {{ block.shopify_attributes }}>
          <div class="about-founders__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 480
                | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480',
                  sizes: '(min-width: 800px) 192px, 120px',
                  class: 'about-founders__image',
                  alt: block.settings.name
              }}
            {% elsif block.settings.fallback_image != blank %}
              <img
                class="about-founders__image"
                src="{{ block.settings.fallback_image | asset_url }}"
                alt="{{ block.settings.name | escape }}"
                width="192"
                height="256"
                loading="lazy"
              >
            {% else %}
              <div class="about-founders__placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>

          <div class="about-founders__body">
            {% if block.settings.role != blank %}
              <p class="about-founders__role">{{ block.settings.role }}</p>
            {% endif %}

            {% if block.settings.name != blank %}
              <h3 class="about-founders__name">{{ block.settings.name }}</h3>
            {% endif %}

            {% if block.settings.credential != blank %}
              <p class="about-founders__credential">{{ block.settings.credential }}</p>
            {% endif %}

            {% if block.settings.bio != blank %}
              <p class="about-founders__bio">{{ block.settings.bio }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
{% endif %}

{% stylesheet %}
  .about-founders__intro {
    max-width: 40rem;
    margin-bottom: 2.25rem;
  }

  .about-founders__grid {
    display: grid;
    gap: 1.15rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-founders__card {
    display: flex;
    align-items: center;
    gap: 1.15rem 1.35rem;
    padding: 1rem 1.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 12px);
    box-shadow: var(--shadow-soft);
  }

  .about-founders__card:nth-child(even) {
    flex-direction: row-reverse;
  }

  .about-founders__media,
  .about-founders__placeholder {
    flex: 0 0 7.5rem;
    width: 7.5rem;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: calc(var(--radius) + 6px);
    background: var(--color-image-tint);
  }

  .about-founders__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-founders__body {
    flex: 1;
    min-width: 0;
    padding: 0.1rem 0;
  }

  .about-founders__role {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
  }

  .about-founders__name {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    margin-bottom: 0.35rem;
  }

  .about-founders__credential {
    color: var(--color-foreground);
    font-size: 0.92rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .about-founders__bio {
    color: var(--color-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  @media (min-width: 800px) {
    .about-founders__grid {
      gap: 1.5rem;
    }

    .about-founders__card {
      gap: 1.75rem 2.25rem;
      padding: 1.35rem 1.6rem;
    }

    .about-founders__media,
    .about-founders__placeholder {
      flex: 0 0 12rem;
      width: 12rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founders",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Founders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinic care, meet India sales"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A physiotherapist and a medical-sales operator — building the products and the reach India actually needs."
    },
    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme asset filename",
          "info": "Used when no photo is uploaded. Example: founder-ananya.png"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Ananya Rao"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Co-founder & Clinical Lead"
        },
        {
          "type": "text",
          "id": "credential",
          "label": "Education / credential",
          "default": "MPT, Manipal College of Health Professions"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "Twelve years treating musculoskeletal and sports injuries in Bengaluru hospitals. Ran community physio camps in rural Karnataka before starting VA Healthcare."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Founders",
      "blocks": [
        {
          "type": "founder",
          "settings": {
            "fallback_image": "founder-ananya.png",
            "name": "Ananya Rao",
            "role": "Co-founder & Clinical Lead",
            "credential": "MPT, Manipal College of Health Professions",
            "bio": "Twelve years treating musculoskeletal and sports injuries in Bengaluru hospitals. Ran community physio camps in rural Karnataka before starting VA Healthcare to put rehab tools in more hands."
          }
        },
        {
          "type": "founder",
          "settings": {
            "fallback_image": "founder-vikram.png",
            "name": "Vikram Mehta",
            "role": "Co-founder & Commercial Lead",
            "credential": "MBA, IIM Ahmedabad · B.Pharm, Manipal Academy of Higher Education",
            "bio": "Fourteen years in medical-device and hospital sales across South and West India. Built rehab-equipment distribution through 120+ clinics before partnering to grow VA Healthcare’s India network."
          }
        }
      ]
    }
  ]
}
{% endschema %}
