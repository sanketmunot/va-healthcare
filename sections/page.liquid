{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  Query form opens as an overlay when "Get in Touch" is clicked.
{% endcomment %}

<div class="vah-page">

  <!-- HERO -->
  <div
    class="vah-hero"
    {% if section.settings.hero_image %}
      style="background-image: linear-gradient(180deg, rgba(12, 24, 20, 0.15) 0%, rgba(12, 24, 20, 0.62) 100%), url('{{ section.settings.hero_image | image_url: width: 1600 }}'); background-size: cover; background-position: center;"
    {% endif %}
  >
    <div class="vah-hero__glow"></div>

    <p class="vah-hero__eyebrow">
      {{ section.settings.eyebrow | default: 'Welcome to' }}
    </p>

    <h1 class="vah-hero__title">
      {{ section.settings.company_name | default: 'VA Health Care' }}
    </h1>

    {% if section.settings.tagline != blank %}
      <p class="vah-hero__tagline">
        {{ section.settings.tagline }}
      </p>
    {% endif %}
  </div>


  <!-- PAGE CONTENT -->
  <div class="vah-content">
    <h1 class="vah-page__title">
      {{ page.title }}
    </h1>

    <div class="vah-page__body">
      {{ page.content }}
    </div>
  </div>


  <!-- CONTACT CARD -->
  <div class="vah-card">

    <div class="vah-card__header">

      <div class="vah-card__badge">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none">
          <path
            d="M12 2L3 7v6c0 5 4 8.5 9 9 5-.5 9-4 9-9V7l-9-5z"
            fill="#1FB6A7"
          />
          <path
            d="M9.5 12.2l1.8 1.8 3.7-4"
            stroke="#fff"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <div>
        <h2 class="vah-card__title">
          {{ section.settings.company_name | default: 'VA Health Care' }}
        </h2>

        <p class="vah-card__subtitle">
          {{ section.settings.subtitle | default: 'Get in touch with us' }}
        </p>
      </div>

    </div>


    <!-- CONTACT DETAILS -->
    <div class="vah-grid">

      <!-- ADDRESS -->
      <a
        href="https://maps.google.com/?q={{ section.settings.address | default: 'Block 3, Office No. 98, Shanti Nagar, Delhi' | url_encode }}"
        target="_blank"
        rel="noopener"
        class="vah-item"
      >
        <span class="vah-item__icon vah-icon--location">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path
              d="M12 22s7-7.2 7-12.6A7 7 0 105 9.4C5 14.8 12 22 12 22z"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <circle
              cx="12"
              cy="9.4"
              r="2.4"
              stroke="currentColor"
              stroke-width="1.7"
            />
          </svg>
        </span>

        <span class="vah-item__text">
          <span class="vah-item__label">Address</span>

          <span class="vah-item__value">
            {{ section.settings.address | default: 'Block 3, Office No. 98, Shanti Nagar, Delhi' }}
          </span>
        </span>
      </a>


      <!-- PHONE -->
      <a
        href="tel:{{ section.settings.phone | default: '+919876543210' }}"
        class="vah-item"
      >
        <span class="vah-item__icon vah-icon--phone">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path
              d="M6.6 10.8c1.3 2.6 3.4 4.7 6 6l2-2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.9c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2 2z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
        </span>

        <span class="vah-item__text">
          <span class="vah-item__label">Call us</span>

          <span class="vah-item__value">
            {{ section.settings.phone | default: '+91 98765 43210' }}
          </span>
        </span>
      </a>


      <!-- EMAIL -->
      <a
        href="mailto:{{ section.settings.email | default: 'contact@vahealthcare.com' }}"
        class="vah-item"
      >
        <span class="vah-item__icon vah-icon--mail">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <rect
              x="3"
              y="5"
              width="18"
              height="14"
              rx="2"
              stroke="currentColor"
              stroke-width="1.6"
            />

            <path
              d="M3.5 6.5L12 13l8.5-6.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </span>

        <span class="vah-item__text">
          <span class="vah-item__label">Email</span>

          <span class="vah-item__value">
            {{ section.settings.email | default: 'contact@vahealthcare.com' }}
          </span>
        </span>
      </a>


      <!-- HOURS -->
      {% if section.settings.hours != blank %}
        <div class="vah-item vah-item--static">

          <span class="vah-item__icon vah-icon--clock">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                stroke-width="1.6"
              />

              <path
                d="M12 7v5l3.5 2"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </span>

          <span class="vah-item__text">
            <span class="vah-item__label">Working hours</span>

            <span class="vah-item__value">
              {{ section.settings.hours }}
            </span>
          </span>

        </div>
      {% endif %}

    </div>


    <!-- SOCIAL LINKS -->
    {% render 'social-links',
      instagram: section.settings.instagram,
      twitter: section.settings.twitter,
      facebook: section.settings.facebook,
      whatsapp: section.settings.whatsapp
    %}

    <!-- GET IN TOUCH -->
    <button
      type="button"
      class="vah-cta"
      id="vah-open-form"
      data-open-lead-form
    >
      {{ section.settings.cta_text | default: 'Get in Touch' }}

      <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
        <path
          d="M5 12h14M13 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

  </div>
</div>


<style>
  .vah-page {
    --vah-primary: #0c1814;
    --vah-primary-hover: #18352d;

    --vah-ink: #0c1814;
    --vah-muted: #5c6865;

    --vah-bg: #f5f8f7;
    --vah-card-bg: #ffffff;

    --vah-border: rgba(12, 24, 20, 0.12);

    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px 64px;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Helvetica,
      Arial,
      sans-serif;

    color: var(--vah-ink);
  }


  /* =========================================
     HERO
  ========================================= */

  .vah-hero {
    position: relative;
    overflow: hidden;

    text-align: center;

    padding: 64px 24px 56px;
    margin: 24px 0 8px;

    border-radius: 24px;

    background:
      linear-gradient(
        180deg,
        rgba(12, 24, 20, 0.15) 0%,
        rgba(12, 24, 20, 0.62) 100%
      ),
      #18352d;

    background-size: cover;
    background-position: center;

    color: #ffffff;
  }


  .vah-hero__glow {
    position: absolute;

    inset: -40% -20% auto -20%;

    height: 220px;

    background:
      radial-gradient(
        60% 60% at 50% 0%,
        rgba(255, 255, 255, 0.18),
        transparent 70%
      );

    pointer-events: none;
  }


  .vah-hero__eyebrow,
  .vah-hero__title,
  .vah-hero__tagline {
    position: relative;
    z-index: 2;
  }


  .vah-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;

    font-size: 12px;
    font-weight: 600;

    opacity: 0.82;

    margin: 0 0 10px;

    color: #ffffff;
  }


  .vah-hero__title {
    font-size: clamp(28px, 5vw, 44px);

    font-weight: 800;

    letter-spacing: -0.02em;

    margin: 0 0 12px;

    color: #ffffff;
  }


  .vah-hero__tagline {
    font-size: 16px;

    max-width: 520px;

    margin: 0 auto;

    opacity: 0.9;

    line-height: 1.5;

    color: #ffffff;
  }


  /* =========================================
     CONTENT
  ========================================= */

  .vah-content {
    padding: 40px 4px 8px;
  }


  .vah-page__title {
    font-size: 26px;

    font-weight: 700;

    margin: 0 0 16px;

    color: var(--vah-ink);
  }


  .vah-page__body {
    font-size: 16px;

    line-height: 1.7;

    color: var(--vah-muted);
  }


  /* =========================================
     CARD
  ========================================= */

  .vah-card {
    background: var(--vah-card-bg);

    border: 1px solid var(--vah-border);

    border-radius: 22px;

    padding: 32px;

    margin-top: 24px;

    box-shadow:
      0 20px 45px -25px
      rgba(12, 24, 20, 0.35);
  }


  .vah-card__header {
    display: flex;

    align-items: center;

    gap: 14px;

    margin-bottom: 24px;
  }


  .vah-card__badge {
    width: 48px;
    height: 48px;

    flex-shrink: 0;

    border-radius: 14px;

    display: flex;

    align-items: center;
    justify-content: center;

    background:
      rgba(12, 24, 20, 0.06);

    border: 1px solid
      rgba(12, 24, 20, 0.08);
  }


  .vah-card__badge svg {
    display: block;
  }


  .vah-card__title {
    font-size: 20px;

    font-weight: 700;

    margin: 0 0 2px;

    color: var(--vah-ink);
  }


  .vah-card__subtitle {
    font-size: 14px;

    color: var(--vah-muted);

    margin: 0;
  }


  /* =========================================
     CONTACT GRID
  ========================================= */

  .vah-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 14px;
  }


  .vah-item {
    display: flex;

    align-items: flex-start;

    gap: 12px;

    padding: 16px;

    border-radius: 16px;

    background: var(--vah-bg);

    border: 1px solid var(--vah-border);

    text-decoration: none;

    color: inherit;

    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }


  a.vah-item:hover {
    transform: translateY(-2px);

    border-color:
      rgba(12, 24, 20, 0.28);

    background: #ffffff;

    box-shadow:
      0 12px 24px -16px
      rgba(12, 24, 20, 0.45);
  }


  .vah-item__icon {
    width: 36px;
    height: 36px;

    flex-shrink: 0;

    border-radius: 10px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #ffffff;

    color: var(--vah-primary);

    box-shadow:
      inset 0 0 0 1px
      var(--vah-border);
  }


  .vah-item__text {
    display: flex;

    flex-direction: column;

    gap: 3px;

    min-width: 0;
  }


  .vah-item__label {
    font-size: 12px;

    text-transform: uppercase;

    letter-spacing: 0.06em;

    color: var(--vah-muted);

    font-weight: 600;
  }


  .vah-item__value {
    font-size: 15px;

    font-weight: 600;

    color: var(--vah-ink);

    word-break: break-word;
  }


  /* =========================================
     SOCIAL
  ========================================= */

  .vah-socials {
    margin-top: 26px;

    padding-top: 22px;

    border-top: 1px solid var(--vah-border);

    display: flex;

    align-items: center;

    justify-content: space-between;

    flex-wrap: wrap;

    gap: 14px;
  }


  .vah-socials__label {
    font-size: 13px;

    font-weight: 700;

    letter-spacing: 0.04em;

    text-transform: uppercase;

    color: var(--vah-muted);
  }


  .vah-socials__list {
    display: flex;

    gap: 10px;
  }


  .vah-social {
    width: 40px;
    height: 40px;

    border-radius: 12px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: var(--vah-bg);

    color: var(--vah-primary);

    border: 1px solid var(--vah-border);

    transition:
      transform 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }


  .vah-social:hover {
    transform: translateY(-2px);

    color: #ffffff;

    background: var(--vah-primary);
  }


  .vah-social--instagram:hover {
    background:
      linear-gradient(
        135deg,
        #f58529,
        #dd2a7b,
        #8134af,
        #515bd4
      );
  }


  .vah-social--twitter:hover {
    background: #0c1814;
  }


  .vah-social--facebook:hover {
    background: #1877f2;
  }


  .vah-social--whatsapp:hover {
    background: #25d366;
  }


  /* =========================================
     CTA BUTTON
  ========================================= */

  .vah-cta {
    margin-top: 28px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 13px 24px;

    border-radius: 999px;

    background: #0c1814;

    color: #ffffff;

    font-weight: 700;

    font-size: 15px;

    text-decoration: none;

    border: none;

    cursor: pointer;

    font-family: inherit;

    appearance: none;
    -webkit-appearance: none;

    transition:
      background 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }


  .vah-cta:hover,
  .vah-cta:focus-visible {
    background: #18352d;

    color: #ffffff;

    transform: translateY(-1px);

    box-shadow:
      0 10px 25px
      rgba(12, 24, 20, 0.25);
  }


  .vah-cta:focus {
    outline: none;
  }


  .vah-cta:focus-visible {
    outline: 3px solid
      rgba(12, 24, 20, 0.18);

    outline-offset: 3px;
  }


  /* =========================================
     FORM OVERLAY

     EXACT COLOR COMBINATION REQUESTED:
     rgba(12, 24, 20, 0.15) 0%
     rgba(12, 24, 20, 0.62) 100%
  ========================================= */

  .vah-form-overlay {
    position: fixed;

    inset: 0;

    z-index: 2147483647;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 100%;
    height: 100%;

    padding: 20px;

    box-sizing: border-box;

    background:
      linear-gradient(
        180deg,
        rgba(12, 24, 20, 0.15) 0%,
        rgba(12, 24, 20, 0.62) 100%
      );

    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);

    visibility: hidden;

    opacity: 0;

    pointer-events: none;

    transition:
      opacity 0.2s ease,
      visibility 0s linear 0.2s;
  }


  .vah-form-overlay.is-open {
    visibility: visible;

    opacity: 1;

    pointer-events: auto;

    transition:
      opacity 0.2s ease,
      visibility 0s linear 0s;
  }


  /* =========================================
     FORM MODAL
  ========================================= */

  .vah-form-modal {
    position: relative;

    width: 100%;

    max-width: 620px;

    max-height: 90vh;

    overflow-y: auto;

    box-sizing: border-box;

    transform:
      translateY(15px)
      scale(0.98);

    opacity: 0;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }


  .vah-form-overlay.is-open
  .vah-form-modal {
    transform:
      translateY(0)
      scale(1);

    opacity: 1;
  }


  .vah-form-modal .vah-form-card {
    position: relative;

    background: #ffffff;

    border:
      1px solid
      rgba(12, 24, 20, 0.12);

    border-radius: 22px;

    margin: 0;

    box-shadow:
      0 30px 80px
      rgba(12, 24, 20, 0.35);
  }


  /* =========================================
     CLOSE BUTTON
  ========================================= */

  .vah-form-close {
    position: absolute;

    top: 14px;
    right: 14px;

    z-index: 10;

    width: 36px;
    height: 36px;

    padding: 0;

    border: 0;

    border-radius: 50%;

    background:
      rgba(12, 24, 20, 0.08);

    color: #0c1814;

    font-size: 26px;

    line-height: 1;

    cursor: pointer;

    display: flex;

    align-items: center;
    justify-content: center;

    appearance: none;
    -webkit-appearance: none;

    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }


  .vah-form-close:hover,
  .vah-form-close:focus-visible {
    background: #0c1814;

    color: #ffffff;

    transform: rotate(90deg);
  }


  .vah-form-close:focus {
    outline: none;
  }


  /* =========================================
     FORM
  ========================================= */

  .vah-form {
    display: flex;

    flex-direction: column;

    gap: 16px;
  }


  .vah-form__row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 16px;
  }


  .vah-form__field {
    display: flex;

    flex-direction: column;

    gap: 6px;
  }


  .vah-form__field label {
    font-size: 12px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.06em;

    color: var(--vah-muted);
  }


  .vah-form__field input,
  .vah-form__field textarea {
    width: 100%;

    box-sizing: border-box;

    border:
      1px solid
      rgba(12, 24, 20, 0.12);

    background: #f5f8f7;

    border-radius: 12px;

    padding: 12px 14px;

    font-size: 15px;

    color: var(--vah-ink);

    font-family: inherit;

    resize: vertical;

    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }


  .vah-form__field input::placeholder,
  .vah-form__field textarea::placeholder {
    color:
      rgba(12, 24, 20, 0.42);
  }


  .vah-form__field input:focus,
  .vah-form__field textarea:focus {
    outline: none;

    border-color:
      rgba(12, 24, 20, 0.45);

    background: #ffffff;

    box-shadow:
      0 0 0 3px
      rgba(12, 24, 20, 0.08);
  }


  .vah-cta--form {
    align-self: flex-start;

    margin-top: 4px;
  }


  .vah-form__note {
    margin: 0;

    font-size: 12.5px;

    line-height: 1.5;

    color: var(--vah-muted);
  }


  /* =========================================
     SUCCESS
  ========================================= */

  .vah-form__success {
    display: flex;

    align-items: center;

    gap: 10px;

    padding: 18px 16px;

    border-radius: 12px;

    background:
      rgba(12, 24, 20, 0.06);

    color: #0c1814;

    border:
      1px solid
      rgba(12, 24, 20, 0.14);

    font-size: 14.5px;

    font-weight: 600;

    animation:
      vahSuccessIn 0.3s ease;
  }


  @keyframes vahSuccessIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  /* =========================================
     ERROR
  ========================================= */

  .vah-form__error {
    padding: 14px 16px;

    border-radius: 12px;

    background:
      rgba(12, 24, 20, 0.06);

    color: #0c1814;

    border:
      1px solid
      rgba(12, 24, 20, 0.16);

    font-size: 14px;

    line-height: 1.5;
  }


  /* =========================================
     BODY LOCK
  ========================================= */

  body.vah-form-open {
    overflow: hidden;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media (max-width: 640px) {

    .vah-page {
      padding-left: 14px;
      padding-right: 14px;
    }


    .vah-grid {
      grid-template-columns: 1fr;
    }


    .vah-form__row {
      grid-template-columns: 1fr;
    }


    .vah-hero {
      padding:
        48px 20px 40px;
    }


    .vah-card {
      padding: 22px;
    }


    .vah-form-overlay {
      padding: 12px;
    }


    .vah-form-modal {
      max-height: 94vh;
    }


    .vah-form-modal .vah-card {
      padding: 22px;
    }


    .vah-form-close {
      top: 10px;
      right: 10px;
    }

  }
</style>


{% schema %}
{
  "name": "t:general.page",
  "settings": [

    {
      "type": "header",
      "content": "Company info"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Welcome to"
    },

    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "default": "VA Health Care"
    },

    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Compassionate care, trusted every step of the way."
    },

    {
      "type": "text",
      "id": "subtitle",
      "label": "Card subtitle",
      "default": "Get in touch with us"
    },

    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image (optional)"
    },


    {
      "type": "header",
      "content": "Contact details"
    },

    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Shanti Nagar Bengaluru Karnataka"
    },

    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+91 98765 43210"
    },

    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@vahealthcare.com"
