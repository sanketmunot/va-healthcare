{% liquid
  assign about_page = false
  assign page_handle = page.handle | default: '' | downcase
  assign page_title_down = page.title | default: '' | downcase
  if template.suffix == 'about'
    assign about_page = true
  endif
  if page_handle contains 'about'
    assign about_page = true
  endif
  if page_title_down contains 'about'
    assign about_page = true
  endif
%}

{% if about_page %}
<section class="about-vision" style="padding-block: {{ section.settings.padding }}px;">
 

  <div class="about-vision__layout">

    <div>
    <div class="about-vision__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.lead != blank %}
        <p class="about-vision__lead">{{ section.settings.lead }}</p>
      {% endif %}
    </div>

    {% if section.settings.text != blank %}
        <div class="about-vision__narrative rte">
          {{ section.settings.text }}
        </div>
    {% endif %}
    </div>

    {% assign impact_blocks = section.blocks | where: 'type', 'impact' %}
    {% if impact_blocks.size > 0 %}
      <ul class="about-vision__impact" role="list">
        {% for block in impact_blocks %}
          <li class="about-vision__stat" {{ block.shopify_attributes }}>
            {% if block.settings.number != blank %}
              <p class="about-vision__number">{{ block.settings.number }}</p>
            {% endif %}
            {% if block.settings.label != blank %}
              <p class="about-vision__label">{{ block.settings.label }}</p>
            {% endif %}
            {% if block.settings.note != blank %}
              <p class="about-vision__note">{{ block.settings.note }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    
  </div>

  {% assign help_blocks = section.blocks | where: 'type', 'help' %}
  {% if help_blocks.size > 0 %}
    <div class="about-vision__help">
      {% if section.settings.help_heading != blank %}
        <h3 class="about-vision__help-heading">{{ section.settings.help_heading }}</h3>
      {% endif %}

      <ul class="about-vision__help-grid" role="list">
        {% for block in help_blocks %}
          <li class="about-vision__help-item" {{ block.shopify_attributes }}>
            <span class="about-vision__help-index" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {% if block.settings.title != blank %}
              <h4 class="about-vision__help-title">{{ block.settings.title }}</h4>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="about-vision__help-text">{{ block.settings.text }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if section.settings.caption != blank %}
    <p class="about-vision__caption">{{ section.settings.caption }}</p>
  {% endif %}
</section>
{% endif %}

{% stylesheet %}
  .about-vision__intro {
    max-width: 44rem;
    margin-bottom: 2.25rem;
  }

  .about-vision__lead {
    margin-top: 0.85rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-foreground);
  }

  .about-vision__layout {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }

  .about-vision__narrative {
    color: var(--color-muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .about-vision__narrative p + p {
    margin-top: 0.9rem;
  }

  .about-vision__impact {
    display: grid;
    gap: 0.85rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-self: center;
  }

  .about-vision__stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 10px);
    padding: 1.2rem 1.25rem;
    box-shadow: var(--shadow-soft);
  }

  .about-vision__number {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .about-vision__label {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .about-vision__note {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .about-vision__help {
    margin-top: 2.75rem;
  }

  .about-vision__help-heading {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    margin-bottom: 1.25rem;
  }

  .about-vision__help-grid {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-vision__help-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 10px);
    padding: 1.35rem 1.3rem;
  }

  .about-vision__help-index {
    display: inline-block;
    margin-bottom: 0.65rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .about-vision__help-title {
    font-size: 1.08rem;
    margin-bottom: 0.4rem;
  }

  .about-vision__help-text {
    color: var(--color-muted);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .about-vision__caption {
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .about-vision__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 3rem;
    }

    .about-vision__impact {
      grid-column: 2;
      grid-row: 1;
    }

    .about-vision__help-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our vision",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our vision"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shops that only exist on this page"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Northvale Supply, Harbor & Pine, and Maple Finch Market are placeholder businesses. Use this section to describe your real company later."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Vision text",
      "default": "<p>This theme is filled with invented companies so you can judge layout without real brand copy. Northvale Supply sells imaginary housewares. Harbor & Pine is a made-up studio shop. Maple Finch Market is a fictional seasonal stall.</p><p>None of the numbers below are research. They are demo figures so the cards have something to show. Replace them in the theme editor when you have your own story.</p><p>The goal of this preview is simple: see headings, photos, and buttons working together. When you are ready to launch, swap every sentence for your own.</p>"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help heading",
      "default": "What these demo shops pretend to do"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Source note",
      "default": "Sample figures only. They are not statistics from a real market or study."
    },
    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "impact",
      "name": "Impact stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "12k+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Demo catalog views this week"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Note",
          "default": "A made-up number so this card is not empty."
        }
      ]
    },
    {
      "type": "help",
      "name": "How we help",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ship sample orders"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Placeholder shops pack imaginary boxes and print fictional packing slips."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Our vision",
      "blocks": [
        {
          "type": "impact",
          "settings": {
            "number": "12k+",
            "label": "Demo catalog views",
            "note": "A made-up weekly total for layout only."
          }
        },
        {
          "type": "impact",
          "settings": {
            "number": "48",
            "label": "Fictional SKUs",
            "note": "How many placeholder products this story pretends to carry."
          }
        },
        {
          "type": "impact",
          "settings": {
            "number": "3",
            "label": "Imaginary brands",
            "note": "Northvale, Harbor & Pine, and Maple Finch."
          }
        },
        {
          "type": "help",
          "settings": {
            "title": "Fill the homepage",
            "text": "Hero slides, badges, and tiles need copy. This is that copy."
          }
        },
        {
          "type": "help",
          "settings": {
            "title": "Show a catalog",
            "text": "Sample products stand in until you connect a real collection."
          }
        },
        {
          "type": "help",
          "settings": {
            "title": "Keep details generic",
            "text": "No real clinics, cities, or phone numbers belong in this preview."
          }
        },
        {
          "type": "help",
          "settings": {
            "title": "Hand it over later",
            "text": "When the design is approved, replace every sentence with your brand."
          }
        }
      ]
    }
  ]
}
{% endschema %}
