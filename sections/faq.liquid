{% comment %}
  FAQ — stable smooth accordion
  - Prevents layout flicker/jumping
  - Smooth open/close animation
  - Only one question open at a time
  - Uses JavaScript to animate actual content height
{% endcomment %}

<section class="faq" style="padding-block: {{ section.settings.padding }}px;">
  <div class="faq__layout">

    <div class="faq__intro">

      {% if section.settings.eyebrow != blank %}
        <p class="faq__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="faq__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="faq__text">{{ section.settings.text }}</p>
      {% endif %}

      {% if section.settings.show_contact_cta %}
        <a
          href="{{ section.settings.contact_cta_url | default: '/pages/contact' }}"
          class="faq__cta"
        >
          <span>
            {{ section.settings.contact_cta_label | default: 'Still have questions? Contact us' }}
          </span>

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m13 6 6 6-6 6"/>
          </svg>
        </a>
      {% endif %}

    </div>

    <div class="faq__list" data-faq-list>

      {% for block in section.blocks %}

        <details
          class="faq__item"
          data-faq-item
          {{ block.shopify_attributes }}
          {% if forloop.first %}open{% endif %}
        >

          <summary class="faq__summary">

            <span class="faq__question">
              {{ block.settings.question }}
            </span>

            <span class="faq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>

          </summary>

          <div class="faq__answer-wrap">
            <div class="faq__answer rte">
              {{ block.settings.answer }}
            </div>
          </div>

        </details>

      {% endfor %}

    </div>

  </div>
</section>


{% stylesheet %}

.faq {
  --faq-accent: var(--color-accent, #2f6b57);
  --faq-surface: var(--color-surface, #f4f6f4);
  --faq-border: var(--color-border, #e1e6e0);
  --faq-muted: var(--color-muted, #6b7a72);
  --faq-ink: var(--color-text, #1c2e28);
}

.faq__layout {
  display: grid;
  gap: 2.5rem;
  width: min(1200px, calc(100% - 48px));
  margin-inline: auto;
}

/* INTRO */

.faq__eyebrow {
  margin: 0 0 12px;
  color: var(--faq-accent);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.faq__heading {
  margin: 0 0 16px;
  color: var(--faq-ink);
  font-family: var(--font-heading--family, inherit);
  font-size: clamp(28px, 3vw, 40px);
  line-height: 1.1;
  letter-spacing: -0.01em;
}

.faq__text {
  margin: 0;
  max-width: 40ch;
  color: var(--faq-muted);
  font-size: 15px;
  line-height: 1.7;
}

.faq__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 28px;
  padding: 13px 20px;
  color: var(--faq-ink);
  background: var(--faq-surface);
  border: 1px solid var(--faq-border);
  border-radius: var(--radius, 8px);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition:
    background-color .2s ease,
    border-color .2s ease,
    transform .2s ease,
    gap .2s ease;
}

.faq__cta svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  transition: transform .2s ease;
}

.faq__cta:hover {
  gap: 12px;
  background: var(--faq-accent);
  border-color: var(--faq-accent);
  color: #fff;
  transform: translateY(-1px);
}

/* LIST */

.faq__list {
  display: grid;
  gap: 10px;
}

/* ITEM */

.faq__item {
  position: relative;
  background: #fff;
  border: 1px solid var(--faq-border);
  border-radius: var(--radius, 10px);
  padding-inline: 20px;
  overflow: hidden;
  transition: border-color .2s ease;
}

.faq__item:hover {
  border-color: var(--faq-accent);
}

/* SUMMARY */

.faq__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 0;
  cursor: pointer;
  list-style: none;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

.faq__summary::-webkit-details-marker {
  display: none;
}

.faq__summary::marker {
  content: '';
}

.faq__question {
  color: var(--faq-ink);
  font-family: var(--font-heading--family, inherit);
  font-size: 15.5px;
  font-weight: 600;
  line-height: 1.4;
}

/* ICON */

.faq__icon {
  display: grid;
  place-items: center;
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--faq-muted);
  transition:
    transform .25s ease,
    color .2s ease;
}

.faq__icon svg {
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.75;
}

.faq__item[open] .faq__icon {
  color: var(--faq-accent);
  transform: rotate(180deg);
}

/* ANSWER */

.faq__answer-wrap {
  height: 0;
  overflow: hidden;
  transition: height .3s ease;
}

.faq__answer {
  padding: 0 0 22px;
  color: var(--faq-muted);
  font-size: 14.5px;
  line-height: 1.75;
}

.faq__answer p:first-child {
  margin-top: 0;
}

.faq__answer p:last-child {
  margin-bottom: 0;
}

/* FOCUS */

.faq__item:focus-within {
  outline: 2px solid var(--faq-accent);
  outline-offset: 2px;
}

.faq__summary:focus-visible {
  outline: none;
}

/* DESKTOP */

@media (min-width: 900px) {

  .faq__layout {
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3.5rem;
    align-items: start;
  }

}

/* MOBILE */

@media (max-width: 599px) {

  .faq__layout {
    width: min(100% - 32px, 600px);
    gap: 1.75rem;
  }

  .faq__item {
    padding-inline: 16px;
  }

  .faq__summary {
    padding: 15px 0;
    gap: 12px;
  }

  .faq__question {
    font-size: 14.5px;
  }

  .faq__answer {
    padding-bottom: 18px;
    font-size: 13.5px;
  }

  .faq__cta {
    width: 100%;
    justify-content: center;
  }

}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  .faq__answer-wrap,
  .faq__icon,
  .faq__item,
  .faq__cta {
    transition: none !important;
  }

}

{% endstylesheet %}


{% javascript %}

(() => {

  const initFAQ = () => {

    const lists = document.querySelectorAll('[data-faq-list]');

    lists.forEach((list) => {

      const items = Array.from(
        list.querySelectorAll('[data-faq-item]')
      );

      items.forEach((item) => {

        const summary = item.querySelector('.faq__summary');
        const wrapper = item.querySelector('.faq__answer-wrap');

        if (!summary || !wrapper) return;

        /*
         * Prevent the browser's native details animation.
         * We control the height ourselves.
         */
        summary.addEventListener('click', (event) => {

          event.preventDefault();

          const isOpen = item.hasAttribute('open');

          /*
           * Close all other FAQ items first.
           */
          items.forEach((other) => {

            if (other !== item && other.hasAttribute('open')) {

              const otherWrapper =
                other.querySelector('.faq__answer-wrap');

              if (otherWrapper) {

                otherWrapper.style.height =
                  otherWrapper.scrollHeight + 'px';

                requestAnimationFrame(() => {
                  otherWrapper.style.height = '0px';
                });

                const closeHandler = () => {

                  other.removeAttribute('open');

                  otherWrapper.removeEventListener(
                    'transitionend',
                    closeHandler
                  );

                };

                otherWrapper.addEventListener(
                  'transitionend',
                  closeHandler
                );

              } else {

                other.removeAttribute('open');

              }

            }

          });

          /*
           * If already open, close it.
           */
          if (isOpen) {

            wrapper.style.height =
              wrapper.scrollHeight + 'px';

            requestAnimationFrame(() => {
              wrapper.style.height = '0px';
            });

            const closeHandler = () => {

              item.removeAttribute('open');

              wrapper.removeEventListener(
                'transitionend',
                closeHandler
              );

            };

            wrapper.addEventListener(
              'transitionend',
              closeHandler
            );

            return;
          }

          /*
           * Open the selected item.
           */
          item.setAttribute('open', '');

          wrapper.style.height = '0px';

          requestAnimationFrame(() => {

            wrapper.style.height =
              wrapper.scrollHeight + 'px';

          });

          const openHandler = () => {

            wrapper.style.height = 'auto';

            wrapper.removeEventListener(
              'transitionend',
              openHandler
            );

          };

          wrapper.addEventListener(
            'transitionend',
            openHandler
          );

        });

      });

      /*
       * Make the first question open on initial load.
       */
      const firstItem = items[0];

      if (firstItem) {

        const firstWrapper =
          firstItem.querySelector('.faq__answer-wrap');

        if (firstItem.hasAttribute('open') && firstWrapper) {
          firstWrapper.style.height = 'auto';
        }

      }

    });

  };

  /*
   * Prevent duplicate initialization in Shopify theme editor.
   */
  if (!window.__stableFAQInitialized) {

    window.__stableFAQInitialized = true;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFAQ);
    } else {
      initFAQ();
    }

  } else {

    initFAQ();

  }

})();

{% endjavascript %}


{% schema %}

{
  "name": "FAQ",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Support"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common questions"
    },

    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answers about shipping, ingredients, and everyday use."
    },

    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact link below the text",
      "default": false
    },

    {
      "type": "text",
      "id": "contact_cta_label",
      "label": "Contact link label",
      "default": "Still have questions? Contact us"
    },

    {
      "type": "url",
      "id": "contact_cta_url",
      "label": "Contact link URL"
    },

    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 64
    }

  ],

  "blocks": [

    {
      "type": "question",
      "name": "Question",

      "settings": [

        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },

        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Most orders ship within 1–2 business days and arrive in 3–5 days.</p>"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "FAQ",

      "blocks": [

        {
          "type": "question",
          "settings": {
            "question": "Are your products suitable for sensitive skin?",
            "answer": "<p>Many formulas are designed for gentle daily use. Always check the ingredient list for your needs.</p>"
          }
        },

        {
          "type": "question",
          "settings": {
            "question": "Do you offer free shipping?",
            "answer": "<p>Yes — free standard shipping on orders over $75.</p>"
          }
        },

        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Unused items can be returned within 30 days of delivery.</p>"
          }
        }

      ]

    }

  ]

}

{% endschema %}