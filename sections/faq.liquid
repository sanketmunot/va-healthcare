<section class="faq" style="padding-block: {{ section.settings.padding }}px;">
  <div class="faq__layout">
    <div class="faq__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="section-subheading">{{ section.settings.text }}</p>
      {% endif %}
    </div>
    <div class="faq__list">
      {% for block in section.blocks %}
        <details class="faq__item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq__layout {
    display: grid;
    gap: 2rem;
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.2rem 1rem;
  }

  .faq__item summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 0;
    font-weight: 650;
    font-family: var(--font-heading--family);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__answer {
    padding: 0 0 1rem;
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .faq__layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common questions"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answers about shipping, ingredients, and everyday use."
    },
    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Most orders ship within 1–2 business days and arrive in 3–5 days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Are your products suitable for sensitive skin?",
            "answer": "<p>Many formulas are designed for gentle daily use. Always check the ingredient list for your needs.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you offer free shipping?",
            "answer": "<p>Yes — free standard shipping on orders over $75.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Unused items can be returned within 30 days of delivery.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
