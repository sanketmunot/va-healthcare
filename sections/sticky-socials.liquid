{% if template.name == 'index' %}
  {% render 'social-links',
    sticky: true,
    instagram: section.settings.instagram,
    twitter: section.settings.twitter,
    facebook: section.settings.facebook,
    whatsapp: section.settings.whatsapp
  %}
{% endif %}

{% stylesheet %}
  .vah-socials--sticky {
    --vah-primary: var(--color-foreground, #0c1814);
    --vah-bg: var(--color-surface, #ffffff);
    --vah-border: var(--color-border, rgba(12, 24, 20, 0.12));
    --vah-muted: var(--color-muted, #5c6865);

    position: fixed;
    left: 0.85rem;
    top: 50%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.85rem 0.55rem;
    transform: translateY(-50%);
    border: 1px solid var(--vah-border);
    border-radius: 1.35rem;
    background: color-mix(in srgb, var(--vah-bg) 92%, transparent);
    box-shadow: var(--shadow-soft, 0 8px 24px rgba(12, 24, 20, 0.08));
    backdrop-filter: blur(10px);
  }

  .vah-socials--sticky .vah-socials__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vah-muted);
  }

  .vah-socials--sticky .vah-socials__list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .vah-socials--sticky .vah-social {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--vah-bg);
    color: var(--vah-primary);
    border: 1px solid var(--vah-border);
    transition:
      transform 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .vah-socials--sticky .vah-social:hover {
    transform: translateY(-2px);
    color: #ffffff;
    background: var(--vah-primary);
  }

  .vah-socials--sticky .vah-social--instagram:hover {
    background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af, #515bd4);
  }

  .vah-socials--sticky .vah-social--twitter:hover {
    background: #0c1814;
  }

  .vah-socials--sticky .vah-social--facebook:hover {
    background: #1877f2;
  }

  .vah-socials--sticky .vah-social--whatsapp:hover {
    background: #25d366;
  }

  @media (max-width: 899px) {
    .vah-socials--sticky {
      left: 0.45rem;
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
      flex-direction: column;
      padding: 0.5rem 0.35rem;
      gap: 0.45rem;
      border-radius: 1.1rem;
    }

    .vah-socials--sticky .vah-socials__label {
      display: none;
    }

    .vah-socials--sticky .vah-socials__list {
      flex-direction: column;
      gap: 0.4rem;
    }

    .vah-socials--sticky .vah-social {
      width: 2.15rem;
      height: 2.15rem;
      border-radius: 10px;
    }

    .vah-socials--sticky .vah-social svg {
      width: 15px;
      height: 15px;
    }
  }

  @media (max-width: 420px) {
    .vah-socials--sticky {
      left: 0.3rem;
      padding: 0.4rem 0.28rem;
    }

    .vah-socials--sticky .vah-social {
      width: 1.95rem;
      height: 1.95rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky socials",
  "tag": "aside",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter",
      "label": "Twitter / X URL"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp number (digits only, with country code)",
      "default": "919876543210"
    }
  ],
  "presets": [
    {
      "name": "Sticky socials"
    }
  ]
}
{% endschema %}
