<section class="hero full-width" style="--hero-min-height: {{ section.settings.height }}vh;">
  <div class="hero__media">

    {% if section.blocks.size > 0 %}

      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div
            class="hero__slide {% if forloop.first %}is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'hero__image',
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: '100vw',
                loading: 'eager',
                fetchpriority: 'high'
            }}
          </div>
        {% endif %}
      {% endfor %}

    {% else %}
      <div class="hero__fallback" aria-hidden="true"></div>
    {% endif %}

    <div
      class="hero__overlay"
      style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>

  </div>

  <div class="hero__content page-width animate-in">

    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <p class="hero__text">{{ section.settings.text }}</p>
    {% endif %}

    <div class="hero__actions">

      {% if section.settings.button_label != blank %}
        <a
          class="button"
          href="{{ section.settings.button_link }}"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

      {% if section.settings.button_label_2 != blank %}
        <a
          class="button button--secondary hero__button-secondary"
          href="{{ section.settings.button_link_2 }}"
        >
          {{ section.settings.button_label_2 }}
        </a>
      {% endif %}

    </div>

  </div>
</section>


{% stylesheet %}

  .hero {
    position: relative;
    min-height: var(--hero-min-height);
    display: grid;
    align-items: end;
    color: #f7faf8;
    overflow: hidden;
  }

  /*
   * Hero image container
   */
  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /*
   * Each slide occupies the entire hero
   */
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 1.2s ease-in-out,
      visibility 1.2s ease-in-out;
  }

  /*
   * Currently visible slide
   */
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  /*
   * Hero images
   */
  .hero__image,
  .hero__fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * Fallback background when no image exists
   */
  .hero__fallback {
    background:
      linear-gradient(
        135deg,
        #1f4d3f 0%,
        #2f6b57 42%,
        #8fb9a8 100%
      );
  }

  /*
   * Dark overlay
   */
  .hero__overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        180deg,
        rgba(12, 24, 20, 0.15) 0%,
        rgba(12, 24, 20, 0.62) 100%
      );

    z-index: 2;
    pointer-events: none;
  }

  /*
   * Hero text/content
   */
  .hero__content {
    position: relative;
    z-index: 3;

    padding-block: clamp(3rem, 8vw, 6rem);

    max-width: 42rem;
  }

  /*
   * Heading
   */
  .hero__heading {
    font-size: clamp(2.4rem, 6vw, 4.4rem);

    margin-bottom: 1rem;

    max-width: 12ch;
  }

  /*
   * Description
   */
  .hero__text {
    max-width: 34rem;

    font-size: 1.1rem;

    color: rgba(247, 250, 248, 0.88);

    margin-bottom: 1.6rem;
  }

  /*
   * Buttons
   */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__button-secondary {
    border-color: rgba(247, 250, 248, 0.45);
    color: #f7faf8;
  }

  .hero__button-secondary:hover {
    border-color: #f7faf8;
    color: #f7faf8;
  }

  /*
   * Eyebrow
   */
  .hero .eyebrow {
    color: #c9e6d8;
  }

{% endstylesheet %}


{% javascript %}

  /*
   * Automatic hero slideshow
   *
   * Changes image every 5 seconds.
   * Uses a smooth fade transition through CSS.
   */

  (() => {

    const initHeroSlider = () => {

      const heroes = document.querySelectorAll('.hero');

      heroes.forEach((hero) => {

        const slides = hero.querySelectorAll('.hero__slide');

        /*
         * Don't run slider if there are zero or one images.
         */
        if (slides.length <= 1) {
          return;
        }

        let currentSlide = 0;

        setInterval(() => {

          /*
           * Hide current slide
           */
          slides[currentSlide].classList.remove('is-active');

          /*
           * Move to next slide
           */
          currentSlide = (currentSlide + 1) % slides.length;

          /*
           * Show next slide
           */
          slides[currentSlide].classList.add('is-active');

        }, 5000);

      });

    };

    /*
     * Run when page loads
     */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }

  })();

{% endjavascript %}


