<section class="hero full-width" style="--hero-min-height: {{ section.settings.height }}vh; --hero-fade-end: {{ section.settings.overlay_opacity | minus: 18 | at_least: 24 | at_most: 46 }}%;">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% liquid
        if forloop.first
          assign image_loading = 'eager'
          assign image_fetchpriority = 'high'
        else
          assign image_loading = 'lazy'
          assign image_fetchpriority = 'auto'
        endif

        assign show_primary_cta = false
        if block.settings.button_label != blank and block.settings.button_link != blank
          assign show_primary_cta = true
        endif

        assign show_secondary_cta = false
        if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank
          assign show_secondary_cta = true
        endif

        assign has_copy = false
        if block.settings.subtitle != blank or block.settings.title != blank or block.settings.banner_description != blank or show_primary_cta or show_secondary_cta
          assign has_copy = true
        endif

        if has_copy
          assign image_sizes = '(max-width: 749px) 100vw, 70vw'
        else
          assign image_sizes = '100vw'
        endif
      %}

      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}{% unless has_copy %} hero__slide--full-image{% endunless %}"
        data-hero-slide
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'hero__image',
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: image_sizes,
                loading: image_loading,
                fetchpriority: image_fetchpriority,
                alt: block.settings.title,
                style: 'object-position: 68% center;'
            }}
          {% else %}
            <div class="hero__fallback" aria-hidden="true"></div>
          {% endif %}
        </div>

        {% if has_copy %}
          <div class="hero__overlay"></div>

          <div class="hero__content">
            {% if block.settings.subtitle != blank %}
              <p class="eyebrow">{{ block.settings.subtitle }}</p>
            {% endif %}

            {% if block.settings.title != blank %}
              {% if forloop.first %}
                <h1 class="hero__heading">{{ block.settings.title }}</h1>
              {% else %}
                <h2 class="hero__heading">{{ block.settings.title }}</h2>
              {% endif %}
            {% endif %}

            {% if block.settings.banner_description != blank %}
              <p class="hero__text">{{ block.settings.banner_description }}</p>
            {% endif %}

            {% if show_primary_cta or show_secondary_cta %}
              <div class="hero__actions">
                {% if show_primary_cta %}
                  <a class="button" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}

                {% if show_secondary_cta %}
                  <a
                    class="button button--secondary hero__button-secondary"
                    href="{{ block.settings.button_link_2 }}"
                  >
                    {{ block.settings.button_label_2 }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  {% else %}
    <div class="hero__slide is-active hero__slide--full-image">
      <div class="hero__media">
        <div class="hero__fallback" aria-hidden="true"></div>
      </div>
    </div>
  {% endif %}
</section>

{% stylesheet %}
.hero {
  --hero-mask:
    linear-gradient(
      90deg,
      transparent 0%,
      rgb(0 0 0 / 0.06) 7%,
      rgb(0 0 0 / 0.28) 16%,
      rgb(0 0 0 / 0.62) calc(var(--hero-fade-end, 34%) - 8%),
      #000 var(--hero-fade-end, 34%),
      #000 100%
    ),
    radial-gradient(
      ellipse 42% 58% at 10% 14%,
      rgb(0 0 0 / 0.42) 0%,
      transparent 74%
    ),
    radial-gradient(
      ellipse 36% 64% at 2% 46%,
      rgb(0 0 0 / 0.34) 0%,
      transparent 72%
    ),
    radial-gradient(
      ellipse 48% 52% at 14% 78%,
      rgb(0 0 0 / 0.4) 0%,
      transparent 76%
    ),
    radial-gradient(
      ellipse 30% 40% at 6% 96%,
      rgb(0 0 0 / 0.28) 0%,
      transparent 70%
    );

  position: relative;
  display: grid;
  grid-template-rows: minmax(var(--hero-min-height), auto);
  color: var(--color-foreground);
  overflow: hidden;
  background: var(--color-surface);
}

.hero__slide {
  grid-area: 1 / 1;
  position: relative;
  display: grid;
  align-items: center;
  width: 100%;
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 1.2s ease-in-out,
    visibility 1.2s ease-in-out;
}

.hero__slide.is-active {
  opacity: 1;
  visibility: visible;
  z-index: 1;
}

/* =========================
   DESKTOP IMAGE
========================= */

.hero__media {
  position: absolute;
  inset: 0 0 0 30%;
  overflow: hidden;

  -webkit-mask-image: var(--hero-mask);
  -webkit-mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: 0 0;

  mask-image: var(--hero-mask);
  mask-size: 100% 100%;
  mask-repeat: no-repeat;
  mask-position: 0 0;
  mask-mode: alpha;
  mask-composite: add;
}

.hero__media::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      color-mix(
        in srgb,
        var(--color-accent) 12%,
        var(--color-surface)
      ) 0%,
      color-mix(
        in srgb,
        var(--color-surface) 38%,
        transparent
      ) 22%,
      transparent 48%
    );
}

.hero__slide--full-image .hero__media {
  left: 0;
  -webkit-mask-image: none;
  mask-image: none;
}

.hero__slide--full-image .hero__media::before {
  display: none;
}

.hero__image,
.hero__fallback {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 68% center;
}

.hero__fallback {
  background:
    linear-gradient(
      135deg,
      color-mix(
        in srgb,
        var(--color-foreground) 70%,
        var(--color-accent)
      ) 0%,
      var(--color-accent) 42%,
      color-mix(
        in srgb,
        var(--color-accent) 55%,
        var(--color-surface)
      ) 100%
    );
}

/* =========================
   DESKTOP WHITE FADE
========================= */

.hero__overlay {
  position: absolute;
  inset: 0 auto 0 0;
  width: min(46%, 38rem);
  z-index: 2;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      var(--color-surface) 0%,
      var(--color-surface) 62%,
      color-mix(
        in srgb,
        var(--color-accent) 6%,
        var(--color-surface)
      ) 84%,
      transparent 100%
    );
}

/* =========================
   CONTENT
========================= */

.hero__content {
  position: relative;
  z-index: 3;

  width: min(38rem, 46%);

  margin-left:
    max(
      1.25rem,
      calc(
        (100% - min(var(--page-width), 100% - 3rem)) / 2
      )
    );

  padding-block: clamp(3rem, 8vw, 6rem);

  color: var(--color-foreground);
}

.hero__heading {
  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.02em;

  font-size: clamp(2.4rem, 6vw, 4.4rem);

  margin: 0 0 1rem;
  max-width: 12ch;

  color: var(--color-foreground);
}

.hero__text {
  max-width: 34rem;

  font-size: 1.1rem;
  line-height: 1.5;

  color: var(--color-muted);

  margin: 0 0 1.6rem;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.hero__button-secondary {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.hero__button-secondary:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);

  background:
    color-mix(
      in srgb,
      var(--color-accent) 8%,
      var(--color-surface)
    );
}

.hero .eyebrow {
  color: var(--color-accent);
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1099px) {

  .hero {
    --hero-mask: none;

    /*
      Keeps the hero compact instead of allowing the
      image to create a huge vertical section.
    */
    grid-template-rows: minmax(
      clamp(32rem, 72vw, 42rem),
      auto
    );
  }

  .hero__slide {
    align-items: end;
  }

  /* Full image area */
  .hero__media {
    inset: 0;
    left: 0;

    -webkit-mask-image: none;
    mask-image: none;

    background:
      linear-gradient(
        160deg,
        color-mix(
          in srgb,
          var(--color-accent) 6%,
          var(--color-surface)
        ) 0%,
        var(--color-surface) 60%
      );
  }

  /*
    IMPORTANT:
    Keep the image large enough to look premium.
    contain prevents important product areas from
    being cropped.
  */
  .hero__image {
    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center top;
  }

  .hero__fallback {
    height: 100%;
  }

  /*
    WHITE FADE ON MOBILE

    Instead of removing the desktop overlay,
    recreate the fade vertically.

    This gives:
    image
       ↓
    soft fade
       ↓
    white
       ↓
    text
  */
  .hero__overlay {
    inset: auto 0 0 0;

    top: 38%;

    width: 100%;
    max-width: none;

    background:
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(
          in srgb,
          var(--color-surface) 12%,
          transparent
        ) 18%,
        color-mix(
          in srgb,
          var(--color-surface) 45%,
          transparent
        ) 34%,
        color-mix(
          in srgb,
          var(--color-surface) 78%,
          transparent
        ) 50%,
        var(--color-surface) 68%,
        var(--color-surface) 100%
      );
  }

  /*
    CONTENT
  */
  .hero__content {
    width: min(
      40rem,
      calc(100% - 2.5rem)
    );

    margin-left: 1.25rem;
    margin-right: 1.25rem;

    /*
      Reduced top padding.
      Most of the mobile vertical space
      should belong to the image.
    */
    padding-block: 0.75rem 1.75rem;
  }

  .hero .eyebrow {
    font-size: 0.78rem;
    line-height: 1.2;
    margin-bottom: 0.45rem;
  }

  .hero__heading {
    max-width: 18ch;

    font-size: clamp(
      1.75rem,
      5.8vw,
      2.5rem
    );

    line-height: 1.12;

    margin-bottom: 0.55rem;
  }

  .hero__text {
    max-width: 32rem;

    font-size: 0.9rem;
    line-height: 1.4;

    margin-bottom: 1rem;
  }

  /*
    RESPONSIVE BUTTONS
  */
  .hero__actions {
    width: 100%;

    display: flex;
    flex-wrap: nowrap;

    gap: 0.6rem;
  }

  .hero__actions .button {
    flex: 1 1 0;

    min-width: 0;

    padding:
      0.55rem
      clamp(0.65rem, 3vw, 1rem);

    font-size: 0.8rem;
    line-height: 1.2;

    white-space: nowrap;

    text-align: center;
  }
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 767px) {

  .hero {
    /*
      More compact mobile hero.
      Adjust these values if your product images
      are particularly tall.
    */
    grid-template-rows: minmax(
      clamp(28rem, 105vw, 36rem),
      auto
    );
  }

  .hero__slide {
    align-items: end;
  }

  .hero__media {
    inset: 0;
  }

  .hero__image {
    object-fit: contain;
    object-position: center top;
  }

  /*
    Stronger white fade closer to the content.
    This is the important part for mobile.
  */
  .hero__overlay {
    top: 30%;

    background:
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(
          in srgb,
          var(--color-surface) 10%,
          transparent
        ) 12%,
        color-mix(
          in srgb,
          var(--color-surface) 38%,
          transparent
        ) 27%,
        color-mix(
          in srgb,
          var(--color-surface) 72%,
          transparent
        ) 43%,
        var(--color-surface) 60%,
        var(--color-surface) 100%
      );
  }

  .hero__content {
    width: calc(100% - 2rem);

    margin-left: 1rem;
    margin-right: 1rem;

    /*
      Very little top padding.
    */
    padding:
      0.35rem
      0
      1.25rem;
  }

  .hero .eyebrow {
    font-size: 0.7rem;
    line-height: 1.2;

    margin-bottom: 0.3rem;
  }

  .hero__heading {
    max-width: 19ch;

    font-size: clamp(
      1.45rem,
      7vw,
      1.9rem
    );

    line-height: 1.12;
    letter-spacing: -0.015em;

    margin-bottom: 0.4rem;
  }

  .hero__text {
    max-width: 100%;

    font-size: 0.78rem;
    line-height: 1.35;

    margin-bottom: 0.75rem;
  }

  .hero__actions {
    gap: 0.45rem;
  }

  .hero__actions .button {
    flex: 1 1 0;

    min-height: 34px;

    padding:
      0.45rem
      0.55rem;

    font-size: 0.7rem;
    line-height: 1.1;

    white-space: nowrap;
  }
}


/* =====================================================
   SMALL PHONES
===================================================== */

@media (max-width: 480px) {

  .hero {
    /*
      Keeps the section from becoming unnecessarily tall
      on phones such as iPhone SE / small Android devices.
    */
    grid-template-rows: minmax(
      clamp(25rem, 110vw, 32rem),
      auto
    );
  }

  .hero__overlay {
    top: 27%;

    background:
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(
          in srgb,
          var(--color-surface) 22%,
          transparent
        ) 17%,
        color-mix(
          in srgb,
          var(--color-surface) 65%,
          transparent
        ) 38%,
        var(--color-surface) 58%,
        var(--color-surface) 100%
      );
  }

  .hero__content {
    width: calc(100% - 1.5rem);

    margin-left: 0.75rem;
    margin-right: 0.75rem;

    padding-bottom: 1rem;
  }

  .hero .eyebrow {
    font-size: 0.65rem;
  }

  .hero__heading {
    font-size: clamp(
      1.3rem,
      6.8vw,
      1.7rem
    );

    margin-bottom: 0.35rem;
  }

  .hero__text {
    font-size: 0.72rem;
    line-height: 1.3;

    margin-bottom: 0.65rem;
  }

  .hero__actions {
    gap: 0.4rem;
  }

  .hero__actions .button {
    min-height: 32px;

    padding:
      0.4rem
      0.45rem;

    font-size: 0.66rem;
  }
}


/* =====================================================
   VERY SMALL PHONES
===================================================== */

@media (max-width: 360px) {

  .hero {
    grid-template-rows: minmax(24rem, 115vw);
  }

  .hero__content {
    padding-bottom: 0.8rem;
  }

  .hero__heading {
    font-size: 1.25rem;
  }

  .hero__text {
    font-size: 0.68rem;
  }

  .hero__actions .button {
    font-size: 0.62rem;
    padding-inline: 0.35rem;
  }
}
@media (max-width: 767px) {
  .hero__image {
    object-fit: contain;
    object-position: center top;
    transform: translateY(-30px);
  }
}

@media (max-width: 480px) {
  .hero__image {
    transform: translateY(-40px);
  }
}

@media (max-width: 360px) {
  .hero__image {
    transform: translateY(-45px);
  }
}
{% endstylesheet %}

{% javascript %}
  (() => {
    const SLIDE_MS = 5000;

    const getSlides = (hero) => hero.querySelectorAll('[data-hero-slide]');

    const showSlide = (hero, index) => {
      const slides = getSlides(hero);
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === index);
      });
      hero.dataset.heroIndex = String(index);
    };

    const stopSlider = (hero) => {
      if (hero.heroTimer) {
        clearInterval(hero.heroTimer);
        hero.heroTimer = null;
      }
    };

    const startSlider = (hero) => {
      const slides = getSlides(hero);
      if (slides.length <= 1) {
        return;
      }

      stopSlider(hero);

      hero.heroTimer = setInterval(() => {
        const slidesNow = getSlides(hero);
        const current = Number(hero.dataset.heroIndex || 0);
        showSlide(hero, (current + 1) % slidesNow.length);
      }, SLIDE_MS);
    };

    const initHero = (hero) => {
      if (!hero || hero.dataset.heroReady === 'true') {
        return;
      }

      hero.dataset.heroReady = 'true';
      hero.dataset.heroIndex = '0';
      startSlider(hero);
    };

    const initHeroSlider = () => {
      document.querySelectorAll('.hero').forEach(initHero);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }

    if (window.__heroSliderEventsBound) {
      return;
    }

    window.__heroSliderEventsBound = true;

    document.addEventListener('shopify:section:load', (event) => {
      event.target.querySelectorAll('.hero').forEach((hero) => {
        hero.dataset.heroReady = 'false';
        initHero(hero);
      });
    });

    document.addEventListener('shopify:section:unload', (event) => {
      event.target.querySelectorAll('.hero').forEach(stopSlider);
    });

    document.addEventListener('shopify:block:select', (event) => {
      const slide = event.target.closest('[data-hero-slide]');
      if (!slide) {
        return;
      }

      const hero = slide.closest('.hero');
      const slides = [...getSlides(hero)];
      const index = slides.indexOf(slide);
      if (index < 0) {
        return;
      }

      stopSlider(hero);
      showSlide(hero, index);
    });

    document.addEventListener('shopify:block:deselect', (event) => {
      const slide = event.target.closest('[data-hero-slide]');
      if (!slide) {
        return;
      }

      startSlider(slide.closest('.hero'));
    });
  })();
{% endjavascript %}

{% schema %}
