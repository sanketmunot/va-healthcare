<section class="hero full-width" style="--hero-min-height: {{ section.settings.height }}vh;">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'hero__image',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% else %}
      <div class="hero__fallback" aria-hidden="true"></div>
    {% endif %}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="hero__content page-width animate-in">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="hero__text">{{ section.settings.text }}</p>
    {% endif %}
    <div class="hero__actions">
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
      {% if section.settings.button_label_2 != blank %}
        <a class="button button--secondary hero__button-secondary" href="{{ section.settings.button_link_2 }}">
          {{ section.settings.button_label_2 }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    min-height: var(--hero-min-height);
    display: grid;
    align-items: end;
    color: #f7faf8;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image,
  .hero__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__fallback {
    background:
      linear-gradient(135deg, #1f4d3f 0%, #2f6b57 42%, #8fb9a8 100%);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 24, 20, 0.15) 0%, rgba(12, 24, 20, 0.62) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 8vw, 6rem);
    max-width: 42rem;
  }

  .hero__heading {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin-bottom: 1rem;
    max-width: 12ch;
  }

  .hero__text {
    max-width: 34rem;
    font-size: 1.1rem;
    color: rgba(247, 250, 248, 0.88);
    margin-bottom: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__button-secondary {
    border-color: rgba(247, 250, 248, 0.45);
    color: #f7faf8;
  }

  .hero__button-secondary:hover {
    border-color: #f7faf8;
    color: #f7faf8;
  }

  .hero .eyebrow {
    color: #c9e6d8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 55,
      "max": 95,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wellness rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Care that feels calm"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover mindful essentials for recovery, sleep, and everyday balance — designed for a quieter kind of health."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
