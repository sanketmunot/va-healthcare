      "label": "Heading",
      "default": "Care that feels calm"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover mindful essentials for recovery, sleep, and everyday balance — designed for a quieter kind of health."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Our story"
    },
    {
      "type": "url",
