<section class="hero full-width" style="--hero-min-height: {{ section.settings.height }}vh; --hero-fade-end: {{ section.settings.overlay_opacity | minus: 18 | at_least: 24 | at_most: 46 }}%;">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% liquid
        if forloop.first
          assign image_loading = 'eager'
          assign image_fetchpriority = 'high'
        else
          assign image_loading = 'lazy'
          assign image_fetchpriority = 'auto'
        endif

        assign show_primary_cta = false
        if block.settings.button_label != blank and block.settings.button_link != blank
          assign show_primary_cta = true
        endif

        assign show_secondary_cta = false
        if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank
          assign show_secondary_cta = true
        endif

        assign has_copy = false
        if block.settings.subtitle != blank or block.settings.title != blank or block.settings.banner_description != blank or show_primary_cta or show_secondary_cta
          assign has_copy = true
        endif

        if has_copy
          assign image_sizes = '(max-width: 749px) 100vw, 70vw'
        else
          assign image_sizes = '100vw'
        endif
      %}

      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}{% unless has_copy %} hero__slide--full-image{% endunless %}"
        data-hero-slide
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'hero__image',
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: image_sizes,
                loading: image_loading,
                fetchpriority: image_fetchpriority,
                alt: block.settings.title,
                style: 'object-position: 68% center;'
            }}
          {% else %}
            <div class="hero__fallback" aria-hidden="true"></div>
          {% endif %}
        </div>

        {% if has_copy %}
          <div class="hero__overlay"></div>

          <div class="hero__content">
            {% if block.settings.subtitle != blank %}
              <p class="eyebrow">{{ block.settings.subtitle }}</p>
            {% endif %}

            {% if block.settings.title != blank %}
              {% if forloop.first %}
                <h1 class="hero__heading">{{ block.settings.title }}</h1>
              {% else %}
                <h2 class="hero__heading">{{ block.settings.title }}</h2>
              {% endif %}
            {% endif %}

            {% if block.settings.banner_description != blank %}
              <p class="hero__text">{{ block.settings.banner_description }}</p>
            {% endif %}

            {% if show_primary_cta or show_secondary_cta %}
              <div class="hero__actions">
                {% if show_primary_cta %}
                  <a class="button" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}

                {% if show_secondary_cta %}
                  <a
                    class="button button--secondary hero__button-secondary"
                    href="{{ block.settings.button_link_2 }}"
                  >
                    {{ block.settings.button_label_2 }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  {% else %}
    <div class="hero__slide is-active hero__slide--full-image">
      <div class="hero__media">
        <div class="hero__fallback" aria-hidden="true"></div>
      </div>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .hero {
    --hero-mask:
      linear-gradient(
        90deg,
        transparent 0%,
        rgb(0 0 0 / 0.06) 7%,
        rgb(0 0 0 / 0.28) 16%,
        rgb(0 0 0 / 0.62) calc(var(--hero-fade-end, 34%) - 8%),
        #000 var(--hero-fade-end, 34%),
        #000 100%
      ),
      radial-gradient(ellipse 42% 58% at 10% 14%, rgb(0 0 0 / 0.42) 0%, transparent 74%),
      radial-gradient(ellipse 36% 64% at 2% 46%, rgb(0 0 0 / 0.34) 0%, transparent 72%),
      radial-gradient(ellipse 48% 52% at 14% 78%, rgb(0 0 0 / 0.4) 0%, transparent 76%),
      radial-gradient(ellipse 30% 40% at 6% 96%, rgb(0 0 0 / 0.28) 0%, transparent 70%);
    position: relative;
    min-height: var(--hero-min-height);
    color: var(--color-foreground);
    overflow: hidden;
    background: var(--color-surface);
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease-in-out,
      visibility 1.2s ease-in-out;
  }

  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .hero__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 30%;
    overflow: hidden;
    -webkit-mask-image: var(--hero-mask);
    -webkit-mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: 0 0;
    -webkit-mask-composite: source-over;
    mask-image: var(--hero-mask);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    mask-position: 0 0;
    mask-mode: alpha;
    mask-composite: add;
  }

  .hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-accent) 12%, var(--color-surface)) 0%,
        color-mix(in srgb, var(--color-surface) 38%, transparent) 22%,
        transparent 48%
      );
  }

  .hero__slide--full-image .hero__media {
    left: 0;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .hero__slide--full-image .hero__media::before {
    display: none;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(46%, 38rem);
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        var(--color-surface) 0%,
        var(--color-surface) 62%,
        color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)) 84%,
        transparent 100%
      );
  }

  .hero__image,
  .hero__fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% center;
  }

  .hero__fallback {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-foreground) 70%, var(--color-accent)) 0%,
        var(--color-accent) 42%,
        color-mix(in srgb, var(--color-accent) 55%, var(--color-surface)) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    width: min(38rem, 46%);
    margin-left: max(1.25rem, calc((100% - min(var(--page-width), 100% - 3rem)) / 2));
    padding-block: clamp(3rem, 8vw, 6rem);
    color: var(--color-foreground);
  }

  .hero__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin: 0 0 1rem;
    max-width: 12ch;
    color: var(--color-foreground);
  }

  .hero__text {
    max-width: 34rem;
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-bottom: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__button-secondary {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero__button-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }

  .hero .eyebrow {
    color: var(--color-accent);
  }

  @media (max-width: 1099px) {
    .hero {
      --hero-mask: none;
    }

    .hero__slide {
      align-items: end;
    }

    .hero__media {
      inset: 0;
      left: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero__media::before {
      display: none;
    }

    .hero__overlay {
      inset: 0;
      width: 100%;
      max-width: none;
      background:
        linear-gradient(
          to top,
          var(--color-surface) 0%,
          color-mix(in srgb, var(--color-accent) 8%, var(--color-surface)) 22%,
          color-mix(in srgb, var(--color-surface) 55%, transparent) 52%,
          transparent 78%
        );
    }

    .hero__content {
      width: min(40rem, calc(100% - 2.5rem));
      margin-left: 1.25rem;
      margin-right: 1.25rem;
      padding-block: 1.5rem 2rem;
    }

    .hero__heading {
      max-width: none;
    }

    .hero__image {
      object-position: center;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const SLIDE_MS = 5000;

    const getSlides = (hero) => hero.querySelectorAll('[data-hero-slide]');

    const showSlide = (hero, index) => {
      const slides = getSlides(hero);
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === index);
      });
      hero.dataset.heroIndex = String(index);
    };

    const stopSlider = (hero) => {
      if (hero.heroTimer) {
        clearInterval(hero.heroTimer);
        hero.heroTimer = null;
      }
    };

    const startSlider = (hero) => {
      const slides = getSlides(hero);
      if (slides.length <= 1) {
        return;
      }

      stopSlider(hero);

      hero.heroTimer = setInterval(() => {
        const slidesNow = getSlides(hero);
        const current = Number(hero.dataset.heroIndex || 0);
        showSlide(hero, (current + 1) % slidesNow.length);
      }, SLIDE_MS);
    };

    const initHero = (hero) => {
      if (!hero || hero.dataset.heroReady === 'true') {
        return;
      }

      hero.dataset.heroReady = 'true';
      hero.dataset.heroIndex = '0';
      startSlider(hero);
    };

    const initHeroSlider = () => {
      document.querySelectorAll('.hero').forEach(initHero);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }

    if (window.__heroSliderEventsBound) {
      return;
    }

    window.__heroSliderEventsBound = true;

    document.addEventListener('shopify:section:load', (event) => {
      event.target.querySelectorAll('.hero').forEach((hero) => {
        hero.dataset.heroReady = 'false';
        initHero(hero);
      });
    });

    document.addEventListener('shopify:section:unload', (event) => {
      event.target.querySelectorAll('.hero').forEach(stopSlider);
    });

    document.addEventListener('shopify:block:select', (event) => {
      const slide = event.target.closest('[data-hero-slide]');
      if (!slide) {
        return;
      }

      const hero = slide.closest('.hero');
      const slides = [...getSlides(hero)];
      const index = slides.indexOf(slide);
      if (index < 0) {
        return;
      }

      stopSlider(hero);
      showSlide(hero, index);
    });

    document.addEventListener('shopify:block:deselect', (event) => {
      const slide = event.target.closest('[data-hero-slide]');
      if (!slide) {
        return;
      }

      startSlider(slide.closest('.hero'));
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "min": 55,
      "max": 95,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image reveal",
      "info": "How much of the photo shows through the left gradient.",
      "default": 55
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "This slide only"
        },
        {
          "type": "paragraph",
          "content": "Subtitle, title, description, and buttons apply only to this image."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Wellness rituals"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Care that feels calm"
        },
        {
          "type": "textarea",
          "id": "banner_description",
          "label": "Banner description",
          "default": "Discover mindful essentials for recovery, sleep, and everyday balance — designed for a quieter kind of health."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary CTA text",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary CTA link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary CTA text",
          "default": "Our story"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
