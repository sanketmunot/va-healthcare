{% if section.settings.text != blank %}
  <div
    class="announcement-bar full-width"
    style="--announcement-bg: var(--color-accent); --announcement-fg: var(--color-accent-contrast);"
  >
    <div class="announcement-bar__inner page-width">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {% else %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    background: var(--announcement-bg);
    color: var(--announcement-fg);
    font-size: 0.9rem;
  }

  .announcement-bar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 2.4rem;
    text-align: center;
  }

  .announcement-bar a {
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on wellness essentials over $75"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
