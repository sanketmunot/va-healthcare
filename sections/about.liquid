{% liquid
  assign about_page = false
  assign page_handle = page.handle | default: '' | downcase
  assign page_title_down = page.title | default: '' | downcase
  if template.suffix == 'about'
    assign about_page = true
  endif
  if page_handle contains 'about'
    assign about_page = true
  endif
  if page_title_down contains 'about'
    assign about_page = true
  endif

  assign heading = section.settings.heading | default: page.title
  if heading == blank
    assign heading = page.title
  endif
%}

{% if about_page %}
<section class="about full-width">
  <div
    class="about__hero"
    style="--about-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --about-min-height: {{ section.settings.height }}vh;"
  >
    <div class="about__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'about__image',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: heading
        }}
      {% else %}
        <div class="about__fallback" aria-hidden="true"></div>
      {% endif %}
      <div class="about__overlay"></div>
    </div>

    <div class="about__hero-content page-width animate-in">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow about__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="about__heading">{{ heading }}</h1>

      {% if section.settings.intro != blank %}
        <p class="about__intro">{{ section.settings.intro }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="button about__cta" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="about__body page-width" style="padding-block: {{ section.settings.padding }}px;">
    {% if section.settings.show_page_content and page.content != blank %}
      <div class="about__page-content rte">
        {{ page.content }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="about__stats" role="list">
        {% for block in section.blocks %}
          <li class="about__stat" {{ block.shopify_attributes }}>
            {% if block.settings.number != blank %}
              <p class="about__stat-number">{{ block.settings.number }}</p>
            {% endif %}
            {% if block.settings.label != blank %}
              <p class="about__stat-label">{{ block.settings.label }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
{% endif %}

{% stylesheet %}
  .about__hero {
    position: relative;
    min-height: var(--about-min-height, 50vh);
    display: grid;
    align-items: end;
    color: #f7faf8;
    overflow: hidden;
  }

  .about__media {
    position: absolute;
    inset: 0;
  }

  .about__image,
  .about__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__fallback {
    background:
      linear-gradient(160deg, #1c2b26 0%, #2f6b57 55%, #8fb9a8 100%);
  }

  .about__overlay {
    position: absolute;
    inset: 0;
    background: #0f1d18;
    opacity: var(--about-overlay, 0.55);
  }

  .about__hero-content {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 8vw, 5.5rem);
    max-width: 42rem;
  }

  .about__eyebrow {
    color: rgba(247, 250, 248, 0.82);
  }

  .about__heading {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 0.85rem;
  }

  .about__intro {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .about__cta {
    background: #ffffff;
    color: #1c2b26;
  }

  .about__cta:hover {
    background: #f4f7f5;
    color: #1c2b26;
  }

  .about__page-content {
    max-width: 46rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about__stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 10px);
    padding: 1.35rem 1.25rem;
    box-shadow: var(--shadow-soft);
  }

  .about__stat-number {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .about__stat-label {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 749px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about .animate-in {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 80,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "VA Wellness creates calm, thoughtful care for recovery, sleep, and everyday balance — without the clinical coldness."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show page content from the Shopify admin",
      "default": true
    },
    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "10k+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Customers cared for"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
