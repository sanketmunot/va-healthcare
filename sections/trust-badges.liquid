        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Thoughtfully sourced formulas made for sensitive routines."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "Free shipping",
            "text": "On orders over $75 within the contiguous US."
