<section
  class="trust-badges"
  style="--tb-pad: {{ section.settings.padding }}px; padding-block: clamp(1.5rem, 5vw, var(--tb-pad));"
>
  {% if section.settings.heading != blank %}
    <h2 class="section-heading trust-badges__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="trust-badges__grid">
    {% for block in section.blocks %}
      <article
        class="trust-badges__item"
        style="--delay: {{ forloop.index0 | times: 90 }}ms;"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.icon != blank %}
          {{
            block.settings.icon
            | image_url: width: 120
            | image_tag: loading: 'lazy', class: 'trust-badges__icon', widths: '60, 90, 120', sizes: '48px'
          }}
        {% else %}
          <span class="trust-badges__mark" aria-hidden="true"></span>
        {% endif %}
        {% if block.settings.title != blank %}
          <h3>{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.text != blank %}
          <p>{{ block.settings.text }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .trust-badges {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 10px);
    padding-inline: 1.25rem;
    overflow-x: clip;
  }

  .trust-badges__heading {
    text-align: center;
    margin-bottom: 1.5rem;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    opacity: 0;
    animation: trust-badges-rise 0.6s ease forwards;
  }

  .trust-badges__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .trust-badges__item {
    text-align: center;
    padding: 0.75rem;
    opacity: 0;
    transform: translateY(18px);
  }

  /* Scroll-triggered reveal (class added by the observer below) */
  .trust-badges__item.is-visible {
    animation: trust-badges-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes trust-badges-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .trust-badges__icon {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    margin: 0 auto 0.85rem;
    transition: transform 0.35s ease;
  }

  .trust-badges__item:hover .trust-badges__icon,
  .trust-badges__item:hover .trust-badges__mark {
    transform: scale(1.08);
  }

  .trust-badges__mark {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 auto 0.85rem;
    border-radius: 999px;
    background:
      radial-gradient(circle at 30% 30%, #c9e6d8, #2f6b57);
    transition: transform 0.35s ease;
  }

  .trust-badges__item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .trust-badges__item p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .trust-badges__heading,
    .trust-badges__item {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 899px) {
    .trust-badges {
      padding-inline: 1rem;
      border-radius: calc(var(--radius) + 6px);
    }

    .trust-badges__heading {
      margin-bottom: 1.15rem;
    }

    .trust-badges__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .trust-badges__item {
      padding: 0.55rem 0.35rem 0.7rem;
    }

    .trust-badges__item h3 {
      font-size: 0.95rem;
    }

    .trust-badges__item p {
      font-size: 0.85rem;
    }

    .trust-badges__icon,
    .trust-badges__mark {
      width: 2.25rem;
      height: 2.25rem;
      margin-bottom: 0.65rem;
    }
  }

  @media (max-width: 420px) {
    .trust-badges {
      padding-inline: 0.75rem;
    }

    .trust-badges__grid {
      gap: 0.65rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var items = document.querySelectorAll('.trust-badges__item');
    if (!items.length) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      items.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }

    if (!('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -40px 0px' }
    );

    items.forEach(function (el) { observer.observe(el); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shoppers trust us"
