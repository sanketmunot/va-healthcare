    {
      "type": "range",
      "id": "padding",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
