<footer class="site-footer full-width">
  <div class="site-footer__inner page-width">
    <div class="site-footer__brand">
      <p class="site-footer__logo">{{ shop.name }}</p>
      {% if section.settings.blurb != blank %}
        <p class="site-footer__blurb">{{ section.settings.blurb }}</p>
      {% endif %}
    </div>

    <div class="site-footer__columns">
      {% for block in section.blocks %}
        <div class="site-footer__column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.menu != blank %}
            <ul class="site-footer__links">
              {% for link in block.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="site-footer__bottom page-width">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {% if section.settings.show_payment_icons %}
      <div class="site-footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    margin-top: 6rem;
    padding: 5rem 0 2rem;
    background: linear-gradient(180deg, #152720 0%, #0f1d18 100%);
    color: #ffffff;
  }

  .site-footer .page-width {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .site-footer__inner {
    display: grid;
    gap: 4rem;
  }

  .site-footer__logo {
    margin-bottom: 1rem;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .site-footer__blurb {
    max-width: 32rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.8;
    font-size: 0.95rem;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2.5rem;
  }

  .site-footer__heading {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .site-footer__links li {
    margin: 0;
  }

  .site-footer__links a {
    position: relative;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .site-footer__links a:hover {
    color: #ffffff;
    padding-left: 0.35rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .site-footer__payment svg {
    width: 2.75rem;
    height: auto;
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .site-footer__payment svg:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  @media (min-width: 900px) {
    .site-footer__inner {
      grid-template-columns: 1.3fr 2fr;
      align-items: start;
    }
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 4rem 0 2rem;
    }

    .site-footer__columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .site-footer__columns {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Thoughtful wellness essentials for calm routines, recovery, and everyday care."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu",
        "settings": {
          "heading": "Shop",
          "menu": "main-menu"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "Support",
          "menu": "footer"
        }
      }
    ]
  }
}
{% endschema %}
