<footer class="site-footer full-width">
  <div class="site-footer__inner page-width">
    <div class="site-footer__brand">
      <p class="site-footer__logo">{{ shop.name }}</p>
      {% if section.settings.blurb != blank %}
        <p class="site-footer__blurb">{{ section.settings.blurb }}</p>
      {% endif %}
    </div>

    <div class="site-footer__columns">
      {% for block in section.blocks %}
        <div class="site-footer__column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.menu != blank %}
            <ul class="site-footer__links">
              {% for link in block.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="site-footer__bottom page-width">
    <div class="site-footer__legal">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <a href="/pages/data-sharing-opt-out">{{ 'footer.privacy_policy' | t }}</a>
    </div>
    {% if section.settings.show_payment_icons %}
      <div class="site-footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}

.site-footer {
  padding: 4rem 0 1.5rem;

  background:
    linear-gradient(
      180deg,
      var(--color-footer-bg) 0%,
      var(--color-footer-bg-deep) 100%
    );

  color: var(--color-on-dark);

  overflow-x: clip;
}


/* =========================================================
   WIDTH
========================================================= */

.site-footer .page-width {
  width: min(
    calc(100% - 40px),
    1280px
  );

  max-width: 1280px;

  margin-inline: auto;

  padding: 0;
}


/* =========================================================
   MAIN FOOTER
========================================================= */

.site-footer__inner {
  display: grid;

  grid-template-columns:
    minmax(240px, .9fr)
    minmax(0, 2fr);

  gap: clamp(
    3rem,
    7vw,
    6rem
  );

  align-items: start;
}


/* =========================================================
   BRAND
========================================================= */

.site-footer__brand {
  min-width: 0;
}

.site-footer__logo {
  margin: 0 0 12px;

  font-size: 1.7rem;
  line-height: 1.2;

  font-weight: 700;

  letter-spacing: -.035em;

  color: var(--color-on-dark);
}

.site-footer__blurb {
  max-width: 340px;

  margin: 0;

  color: var(--color-on-dark-muted);

  font-size: .92rem;

  line-height: 1.65;
}


/* =========================================================
   MENU COLUMNS
========================================================= */

.site-footer__columns {
  display: grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(150px, 1fr)
    );

  gap: 2rem;
}

.site-footer__column {
  min-width: 0;
}

.site-footer__heading {
  margin: 0 0 14px;

  color: var(--color-on-dark);

  font-size: .78rem;

  font-weight: 700;

  letter-spacing: .11em;

  line-height: 1.3;

  text-transform: uppercase;
}

.site-footer__links {
  display: grid;

  gap: 7px;

  margin: 0;
  padding: 0;

  list-style: none;
}

.site-footer__links li {
  margin: 0;
}

.site-footer__links a {
  display: inline-block;

  padding: 3px 0;

  color: var(--color-on-dark-muted);

  font-size: .9rem;

  line-height: 1.4;

  text-decoration: none;

  transition:
    color .2s ease,
    transform .2s ease;
}

.site-footer__links a:hover {
  color: var(--color-on-dark);

  transform: translateX(3px);
}


/* =========================================================
   BOTTOM
========================================================= */

.site-footer__bottom {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 1.5rem;

  margin-top: 3rem;

  padding-top: 1.25rem;

  border-top: 1px solid var(--color-on-dark-border);

  color: var(--color-on-dark-subtle);

  font-size: .8rem;
}

.site-footer__bottom p {
  margin: 0;
}

.site-footer__legal {
  display: flex;

  align-items: center;
  flex-wrap: wrap;

  gap: .5rem 1.25rem;
}

.site-footer__legal a {
  color: inherit;

  text-decoration: none;

  transition: color .2s ease;
}

.site-footer__legal a:hover {
  color: var(--color-on-dark);
}


/* =========================================================
   PAYMENT ICONS
========================================================= */

.site-footer__payment {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  flex-wrap: wrap;

  gap: 7px;
}

.site-footer__payment svg {
  display: block;

  width: 40px;
  height: auto;

  opacity: .7;

  transition:
    opacity .2s ease,
    transform .2s ease;
}

.site-footer__payment svg:hover {
  opacity: 1;

  transform: translateY(-1px);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 899px) {

  .site-footer {
    padding: 3rem 0 1.25rem;
  }

  .site-footer .page-width {
    width: min(
      calc(100% - 32px),
      700px
    );
  }

  .site-footer__inner {
    grid-template-columns: 1fr;

    gap: 2.25rem;
  }

  .site-footer__brand {
    max-width: 600px;
  }

  .site-footer__blurb {
    max-width: 580px;
  }

  .site-footer__columns {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 1.75rem 2rem;
  }

  .site-footer__bottom {
    margin-top: 2.25rem;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .site-footer {
    padding: 2.25rem 0 1rem;
  }

  .site-footer .page-width {
    width: calc(100% - 28px);

    max-width: none;
  }


  /* -----------------------------------------
     BRAND
  ----------------------------------------- */

  .site-footer__inner {
    gap: 1.6rem;
  }

  .site-footer__logo {
    margin-bottom: 7px;

    font-size: 1.35rem;
  }

  .site-footer__blurb {
    max-width: 100%;

    font-size: .82rem;

    line-height: 1.5;
  }


  /* -----------------------------------------
     MENUS
  ----------------------------------------- */

  .site-footer__columns {

    /*
     * Two compact columns instead of
     * stacking every menu vertically.
     */

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 1.35rem 1rem;
  }

  .site-footer__heading {
    margin-bottom: 8px;

    font-size: .68rem;

    letter-spacing: .09em;
  }

  .site-footer__links {
    gap: 2px;
  }

  .site-footer__links a {
    padding: 2px 0;

    font-size: .78rem;

    line-height: 1.35;
  }


  /* -----------------------------------------
     BOTTOM
  ----------------------------------------- */

  .site-footer__bottom {

    /*
     * Keep copyright + payment icons
     * compact rather than creating another
     * large vertical section.
     */

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 10px;

    margin-top: 1.6rem;

    padding-top: .9rem;

    font-size: .7rem;
  }


  /* -----------------------------------------
     PAYMENT
  ----------------------------------------- */

  .site-footer__payment {
    justify-content: flex-start;

    gap: 5px;
  }

  .site-footer__payment svg {
    width: 34px;
  }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

  .site-footer {
    padding-top: 2rem;
  }

  .site-footer .page-width {
    width: calc(100% - 24px);
  }

  .site-footer__inner {
    gap: 1.4rem;
  }

  .site-footer__columns {
    gap: 1.2rem .75rem;
  }

  .site-footer__links a {
    font-size: .74rem;
  }

  .site-footer__payment svg {
    width: 31px;
  }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .site-footer * {
    transition: none !important;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Thoughtful wellness essentials for calm routines, recovery, and everyday care."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu",
        "settings": {
          "heading": "Shop",
          "menu": "main-menu"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "Support",
          "menu": "footer"
        }
      }
    ]
  }
}
{% endschema %}
