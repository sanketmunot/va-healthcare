{% doc %}
  Renders a product card for collection grids and featured collections.

  @param {product} product - Product to render
  @param {boolean} [show_vendor] - Show vendor name
  @param {boolean} [show_quick_add] - Show quick add button

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign show_vendor = show_vendor | default: settings.product_card_show_vendor
  assign show_quick_add = show_quick_add | default: settings.product_card_show_quick_add
  assign featured = product.featured_media.preview_image | default: product.featured_image
  assign discount_percentage = 0
  if product.compare_at_price > product.price
    assign discount_percentage = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
  endif
%}

<article
  class="product-card"
  data-price="{{ product.price }}"
  data-compare="{{ product.compare_at_price | default: 0 }}"
>
  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}" data-product-card-image-swap>
    {% if product.images.size > 0 %}
      {% for image in product.images limit: 3 %}
        {% liquid
          assign image_class = 'product-card__image'
          if forloop.first
            assign image_class = image_class | append: ' is-visible'
          endif
        %}
        {{
          image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '320, 480, 640, 900',
            sizes: '(min-width: 990px) 25vw, 50vw',
            class: image_class
        }}
      {% endfor %}
    {% elsif featured != blank %}
      {{
        featured
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          widths: '320, 480, 640, 900',
          sizes: '(min-width: 990px) 25vw, 50vw',
          class: 'product-card__image is-visible'
      }}
    {% else %}
      <div class="product-card__placeholder" aria-hidden="true"></div>
    {% endif %}
    {% unless product.available %}
      <span class="product-card__badge">Sold out</span>
    {% endunless %}
  </a>

  <div class="product-card__body">
    {% if show_vendor and product.vendor != blank %}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {% endif %}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <p class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <s>{{ product.compare_at_price | money }}</s>
      {% endif %}
      <span>{{ product.price | money }}</span>
      {% if product.available and discount_percentage > 0 %}
        <small class="product-card__discount">{{ discount_percentage }}% off</small>
      {% endif %}
    </p>

    {% if show_quick_add and product.available %}
      {% form 'product', product, class: 'product-card__form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="button button--secondary product-card__quick-add">
          Quick add
        </button>
      {% endform %}
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    transition:
      transform var(--transition),
      box-shadow var(--transition),
      border-color var(--transition);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
  }

  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background: #fff;
    overflow: hidden;
    text-decoration: none;
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    object-fit: contain;
    opacity: 0;
    transition: opacity 450ms ease;
  }

  .product-card__image.is-visible {
    opacity: 1;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    background:
      var(--color-image-tint-soft),
      var(--color-surface);
  }

  .product-card__badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-surface);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.05rem 1.15rem;
    flex: 1;
  }

  .product-card__vendor {
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product-card__title {
    font-size: clamp(0.86rem, 1.7vw, 1.05rem);
    font-weight: 600;
  }

  .product-card__title a {
    text-decoration: none;
  }

  .product-card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--color-muted);
    font-weight: 600;
  }

  .product-card__price s {
    opacity: 0.7;
    font-weight: 500;
  }

  .product-card__price span {
    color: var(--color-foreground);
  }

  .product-card__discount {
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  @media screen and (max-width: 480px) {
    .product-card {
      background: #fff;
      border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, var(--color-border));
      box-shadow: 0 2px 8px color-mix(in srgb, var(--color-foreground) 7%, transparent);
    }

    .product-card__title {
      font-size: clamp(0.72rem, 3.2vw, 0.84rem);
    }

    .product-card__body {
      padding-inline: 0.8rem;
    }

    .product-card__price {
      column-gap: 0.35rem;
      row-gap: 0.2rem;
    }

    .product-card__discount {
      font-size: 0.68rem;
    }
  }

  .product-card__form {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .product-card__quick-add {
    width: 100%;
    min-height: 2.5rem;
    font-size: 0.9rem;
  }

  .product-card__quick-add:hover {
    border-color: var(--color-foreground);
    color: var(--color-background);
    background: var(--color-foreground);
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const refreshHeaderCartCount = async () => {
      const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
      if (!response.ok) return;

      const cart = await response.json();
      const cartLinks = document.querySelectorAll('.site-header__cart');

      cartLinks.forEach((cartLink) => {
        let count = cartLink.querySelector('.site-header__cart-count');

        if (cart.item_count > 0 && !count) {
          count = document.createElement('span');
          count.className = 'site-header__cart-count';
          cartLink.appendChild(count);
        }

        if (!count) return;

        count.textContent = cart.item_count;
        count.hidden = cart.item_count === 0;
      });

      window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
    };

    document.addEventListener('submit', async (event) => {
      const form = event.target.closest('.product-card__form');
      if (!form || form.dataset.quickAddSubmitting === 'true') return;

      event.preventDefault();
      form.dataset.quickAddSubmitting = 'true';

      const button = form.querySelector('.product-card__quick-add');
      const originalLabel = button?.textContent;

      if (button) {
        button.disabled = true;
        button.textContent = 'Adding...';
      }

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form)
        });

        if (!response.ok) throw new Error('Unable to add product');

        await refreshHeaderCartCount();

        if (button) button.textContent = 'Added';
      } catch (error) {
        if (button) button.textContent = 'Try again';
      } finally {
        window.setTimeout(() => {
          form.dataset.quickAddSubmitting = 'false';
          if (button) {
            button.disabled = false;
            button.textContent = originalLabel;
          }
        }, 1400);
      }
    });

    const initializeProductCardSwaps = (root = document) => {
      root.querySelectorAll('[data-product-card-image-swap]').forEach((media) => {
        if (media.dataset.imageSwapReady === 'true') return;
        media.dataset.imageSwapReady = 'true';

        const images = Array.from(media.querySelectorAll('.product-card__image'));
        if (images.length < 2) return;

        let hoverTimers = [];

        const setActive = (index) => {
          images.forEach((image, imageIndex) => {
            image.classList.toggle('is-visible', imageIndex === index);
          });
        };

        const clearHoverTimers = () => {
          hoverTimers.forEach((timer) => window.clearTimeout(timer));
          hoverTimers = [];
        };

        media.addEventListener('mouseenter', () => {
          if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
          clearHoverTimers();
          setActive(1);
          if (images.length > 2) {
            hoverTimers.push(window.setTimeout(() => setActive(2), 1000));
          }
        });

        media.addEventListener('mouseleave', () => {
          clearHoverTimers();
          setActive(0);
        });
      });
    };

    initializeProductCardSwaps();

    const observer = new MutationObserver(() => initializeProductCardSwaps());
    observer.observe(document.body, { childList: true, subtree: true });
  })();
{% endjavascript %}
