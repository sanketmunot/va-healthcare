{% doc %}
  Shared social icons used on the contact page and the homepage sticky rail.

  @param {string} [instagram] - Instagram URL
  @param {string} [twitter] - Twitter / X URL
  @param {string} [facebook] - Facebook URL
  @param {string} [whatsapp] - WhatsApp number, digits only with country code
  @param {boolean} [sticky] - Fixed left rail on the homepage
{% enddoc %}

{% liquid
  assign instagram_url = instagram | default: 'https://instagram.com/vahealthcare'
  assign twitter_url = twitter | default: 'https://twitter.com/vahealthcare'
  assign facebook_url = facebook | default: 'https://facebook.com/vahealthcare'
  assign whatsapp_number = whatsapp | default: '919876543210'
  assign socials_class = 'vah-socials'
  if sticky
    assign socials_class = socials_class | append: ' vah-socials--sticky'
  endif
%}

<div class="{{ socials_class }}">
  <span class="vah-socials__label">Follow us</span>

  <div class="vah-socials__list">
    <a
      class="vah-social vah-social--instagram"
      href="{{ instagram_url }}"
      target="_blank"
      rel="noopener"
      aria-label="Instagram"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/>
      </svg>
    </a>

    <a
      class="vah-social vah-social--twitter"
      href="{{ twitter_url }}"
      target="_blank"
      rel="noopener"
      aria-label="Twitter / X"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
        <path d="M4 4l7.3 9.4L4.4 20H7l5.2-5.6L16.5 20H20l-7.7-9.9L19.4 4H17l-4.8 5.1L8.5 4H4z" fill="currentColor"/>
      </svg>
    </a>

    <a
      class="vah-social vah-social--facebook"
      href="{{ facebook_url }}"
      target="_blank"
      rel="noopener"
      aria-label="Facebook"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
        <path d="M14 21v-7h2.5l.5-3H14V9c0-.9.3-1.5 1.7-1.5H17V4.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V11H8.5v3H11v7h3z" fill="currentColor"/>
      </svg>
    </a>

    <a
      class="vah-social vah-social--whatsapp"
      href="https://wa.me/{{ whatsapp_number }}"
      target="_blank"
      rel="noopener"
      aria-label="WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
        <path d="M12 3a9 9 0 00-7.7 13.6L3 21l4.5-1.3A9 9 0 1012 3z" stroke="currentColor" stroke-width="1.5"/>
        <path d="M8.5 8.7c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .5.4.2.5.6 1.6.6 1.7.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.2.4-.2.6-.1.2.1 1.5.7 1.8.8.3.2.5.2.5.4 0 .2 0 1-.4 1.4-.4.4-1.3.9-2.4.5-1.9-.7-3.6-1.9-5-3.5-1.1-1.2-1.8-2.5-2-3-.3-.6-.6-1.4 0-2.1z" fill="currentColor"/>
      </svg>
    </a>
  </div>
</div>
