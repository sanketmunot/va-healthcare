{% doc %}
  Renders the store logo as the browser tab icon.

  @example
  {% render 'favicon' %}
{% enddoc %}

{%- if settings.logo != blank -%}
  <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.logo | image_url: width: 32, height: 32 }}">
  <link rel="apple-touch-icon" href="{{ settings.logo | image_url: width: 180, height: 180 }}">
{%- endif -%}
