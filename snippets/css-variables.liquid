{% style %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-contrast: {{ settings.accent_contrast }};
    --color-surface: {{ settings.surface_color }};
    --color-muted: {{ settings.muted_color }};
    --color-border: {{ settings.border_color }};
    --color-surface-hover: color-mix(
      in srgb,
      {{ settings.accent_color }} 8%,
      {{ settings.surface_color }}
    );
    --color-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 12%,
      transparent
    );
    --color-footer-bg: {{ settings.foreground_color }};
    --color-footer-bg-deep: color-mix(
      in srgb,
      {{ settings.foreground_color }} 82%,
      {{ settings.accent_color }}
    );
    --color-on-dark: {{ settings.surface_color }};
    --color-on-dark-muted: color-mix(
      in srgb,
      {{ settings.surface_color }} 64%,
      transparent
    );
    --color-on-dark-subtle: color-mix(
      in srgb,
      {{ settings.surface_color }} 52%,
      transparent
    );
    --color-on-dark-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 10%,
      transparent
    );
    --color-body-glow: color-mix(
      in srgb,
      {{ settings.accent_color }} 12%,
      transparent
    );
    --color-body-glow-alt: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-bg-start: color-mix(
      in srgb,
      {{ settings.foreground_color }} 88%,
      {{ settings.accent_color }}
    );
    --color-newsletter-bg-mid: color-mix(
      in srgb,
      {{ settings.foreground_color }} 45%,
      {{ settings.accent_color }}
    );
    --color-newsletter-bg-end: {{ settings.accent_color }};
    --color-newsletter-text: {{ settings.surface_color }};
    --color-newsletter-text-muted: color-mix(
      in srgb,
      {{ settings.surface_color }} 78%,
      transparent
    );
    --color-newsletter-text-soft: color-mix(
      in srgb,
      {{ settings.surface_color }} 82%,
      transparent
    );
    --color-newsletter-text-faint: color-mix(
      in srgb,
      {{ settings.surface_color }} 62%,
      transparent
    );
    --color-newsletter-text-subtle: color-mix(
      in srgb,
      {{ settings.surface_color }} 52%,
      transparent
    );
    --color-newsletter-text-strong: color-mix(
      in srgb,
      {{ settings.surface_color }} 86%,
      transparent
    );
    --color-newsletter-eyebrow: color-mix(
      in srgb,
      {{ settings.surface_color }} 75%,
      {{ settings.accent_color }}
    );
    --color-newsletter-accent-glow: color-mix(
      in srgb,
      {{ settings.accent_color }} 22%,
      transparent
    );
    --color-newsletter-glow-one: color-mix(
      in srgb,
      {{ settings.accent_color }} 12%,
      transparent
    );
    --color-newsletter-glow-two: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-grid-line: color-mix(
      in srgb,
      {{ settings.surface_color }} 8%,
      transparent
    );
    --color-newsletter-mask: color-mix(
      in srgb,
      {{ settings.foreground_color }} 80%,
      transparent
    );
    --color-newsletter-glass-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 18%,
      transparent
    );
    --color-newsletter-glass-border-soft: color-mix(
      in srgb,
      {{ settings.surface_color }} 14%,
      transparent
    );
    --color-newsletter-glass-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 8%,
      transparent
    );
    --color-newsletter-glass-bg-medium: color-mix(
      in srgb,
      {{ settings.surface_color }} 10%,
      transparent
    );
    --color-newsletter-glass-bg-strong: color-mix(
      in srgb,
      {{ settings.surface_color }} 12%,
      transparent
    );
    --color-newsletter-glass-bg-focus: color-mix(
      in srgb,
      {{ settings.surface_color }} 14%,
      transparent
    );
    --color-newsletter-glass-inset: color-mix(
      in srgb,
      {{ settings.surface_color }} 10%,
      transparent
    );
    --color-newsletter-icon-stroke: color-mix(
      in srgb,
      {{ settings.surface_color }} 85%,
      {{ settings.accent_color }}
    );
    --color-newsletter-input-icon: color-mix(
      in srgb,
      {{ settings.surface_color }} 55%,
      transparent
    );
    --color-newsletter-focus-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 65%,
      {{ settings.accent_color }}
    );
    --color-newsletter-focus-ring: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-card-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 20%,
      transparent
    );
    --color-newsletter-btn-bg: {{ settings.surface_color }};
    --color-newsletter-btn-text: color-mix(
      in srgb,
      {{ settings.foreground_color }} 85%,
      {{ settings.accent_color }}
    );
    --color-newsletter-btn-hover: color-mix(
      in srgb,
      {{ settings.surface_color }} 92%,
      {{ settings.accent_color }}
    );
    --color-newsletter-btn-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 22%,
      transparent
    );
    --color-newsletter-bulk-btn-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 96%,
      {{ settings.accent_color }}
    );
    --color-newsletter-bulk-btn-text: color-mix(
      in srgb,
      {{ settings.foreground_color }} 90%,
      {{ settings.accent_color }}
    );
    --color-newsletter-success-text: color-mix(
      in srgb,
      {{ settings.surface_color }} 84%,
      {{ settings.accent_color }}
    );
    --color-newsletter-success-bg: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-success-border: color-mix(
      in srgb,
      {{ settings.accent_color }} 18%,
      transparent
    );
    --color-newsletter-error-text: color-mix(
      in srgb,
      {{ settings.surface_color }} 88%,
      {{ settings.accent_contrast }}
    );
    --color-newsletter-error-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 8%,
      transparent
    );
    --color-newsletter-error-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 15%,
      transparent
    );
    --color-accent-light: color-mix(
      in srgb,
      {{ settings.accent_color }} 55%,
      {{ settings.surface_color }}
    );
    --color-accent-soft: color-mix(
      in srgb,
      {{ settings.accent_color }} 40%,
      {{ settings.surface_color }}
    );
    --color-accent-deep: color-mix(
      in srgb,
      {{ settings.foreground_color }} 75%,
      {{ settings.accent_color }}
    );
    --color-accent-hover: color-mix(
      in srgb,
      {{ settings.foreground_color }} 85%,
      {{ settings.accent_color }}
    );
    --color-overlay-light: color-mix(
      in srgb,
      {{ settings.foreground_color }} 15%,
      transparent
    );
    --color-overlay-medium: color-mix(
      in srgb,
      {{ settings.foreground_color }} 35%,
      transparent
    );
    --color-overlay-dark: color-mix(
      in srgb,
      {{ settings.foreground_color }} 62%,
      transparent
    );
    --color-overlay-deep: color-mix(
      in srgb,
      {{ settings.foreground_color }} 78%,
      transparent
    );
    --color-overlay-gradient: linear-gradient(
      180deg,
      color-mix(in srgb, {{ settings.foreground_color }} 15%, transparent) 0%,
      color-mix(in srgb, {{ settings.foreground_color }} 62%, transparent) 100%
    );
    --color-shadow-medium: color-mix(
      in srgb,
      {{ settings.foreground_color }} 20%,
      transparent
    );
    --color-shadow-strong: color-mix(
      in srgb,
      {{ settings.foreground_color }} 35%,
      transparent
    );
    --color-shadow-heavy: color-mix(
      in srgb,
      {{ settings.foreground_color }} 45%,
      transparent
    );
    --color-border-strong: color-mix(
      in srgb,
      {{ settings.foreground_color }} 45%,
      transparent
    );
    --color-border-input: color-mix(
      in srgb,
      {{ settings.foreground_color }} 14%,
      transparent
    );
    --color-border-input-focus: color-mix(
      in srgb,
      {{ settings.foreground_color }} 16%,
      transparent
    );
    --color-placeholder: color-mix(
      in srgb,
      {{ settings.foreground_color }} 42%,
      transparent
    );
    --color-input-bg: {{ settings.background_color }};
    --color-input-bg-subtle: color-mix(
      in srgb,
      {{ settings.foreground_color }} 6%,
      {{ settings.background_color }}
    );
    --color-input-bg-muted: color-mix(
      in srgb,
      {{ settings.foreground_color }} 8%,
      {{ settings.background_color }}
    );
    --color-hero-bg-fallback: linear-gradient(
      135deg,
      color-mix(in srgb, {{ settings.foreground_color }} 70%, {{ settings.accent_color }}) 0%,
      {{ settings.accent_color }} 42%,
      color-mix(in srgb, {{ settings.accent_color }} 55%, {{ settings.surface_color }}) 100%
    );
    --color-hero-accent-text: color-mix(
      in srgb,
      {{ settings.surface_color }} 80%,
      {{ settings.accent_color }}
    );
    --color-hero-btn-outline: color-mix(
      in srgb,
      {{ settings.surface_color }} 45%,
      transparent
    );
    --color-about-fallback: linear-gradient(
      160deg,
      {{ settings.foreground_color }} 0%,
      {{ settings.accent_color }} 55%,
      color-mix(in srgb, {{ settings.accent_color }} 55%, {{ settings.surface_color }}) 100%
    );
    --color-about-overlay: color-mix(
      in srgb,
      {{ settings.foreground_color }} 92%,
      {{ settings.accent_color }}
    );
    --color-promo-bg: color-mix(
      in srgb,
      {{ settings.foreground_color }} 92%,
      {{ settings.accent_color }}
    );
    --color-promo-fallback: linear-gradient(
      145deg,
      color-mix(in srgb, {{ settings.foreground_color }} 50%, {{ settings.accent_color }}),
      color-mix(in srgb, {{ settings.accent_color }} 55%, {{ settings.surface_color }})
    );
    --color-promo-overlay: linear-gradient(
      90deg,
      color-mix(in srgb, {{ settings.foreground_color }} 35%, transparent),
      color-mix(in srgb, {{ settings.foreground_color }} 8%, transparent) 42%
    ),
    linear-gradient(
      180deg,
      color-mix(in srgb, {{ settings.foreground_color }} 35%, transparent) 0%,
      color-mix(in srgb, {{ settings.foreground_color }} 8%, transparent) 32%,
      color-mix(in srgb, {{ settings.foreground_color }} 78%, transparent) 100%
    );
    --color-promo-kicker: color-mix(
      in srgb,
      {{ settings.surface_color }} 75%,
      {{ settings.accent_color }}
    );
    --color-promo-icon-mark: radial-gradient(
      circle at 30% 30%,
      color-mix(in srgb, {{ settings.surface_color }} 80%, {{ settings.accent_color }}),
      {{ settings.accent_color }}
    );
    --color-promo-cta-text: color-mix(
      in srgb,
      {{ settings.foreground_color }} 90%,
      {{ settings.accent_color }}
    );
    --color-image-tint: linear-gradient(
      160deg,
      color-mix(in srgb, {{ settings.accent_color }} 28%, transparent),
      color-mix(in srgb, {{ settings.accent_color }} 40%, {{ settings.surface_color }})
    );
    --color-image-tint-soft: linear-gradient(
      145deg,
      color-mix(in srgb, {{ settings.accent_color }} 18%, transparent),
      transparent 55%
    );
    --color-star: color-mix(
      in srgb,
      {{ settings.accent_color }} 30%,
      {{ settings.foreground_color }}
    );
    --color-glass-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 35%,
      transparent
    );
    --color-glass-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 12%,
      transparent
    );
    --color-glass-glow: color-mix(
      in srgb,
      {{ settings.surface_color }} 18%,
      transparent
    );
    --color-focus-ring: color-mix(
      in srgb,
      {{ settings.foreground_color }} 18%,
      transparent
    );
    --color-focus-outline: color-mix(
      in srgb,
      {{ settings.foreground_color }} 8%,
      transparent
    );
    --color-cta-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 25%,
      transparent
    );
    --color-success-bg: color-mix(
      in srgb,
      {{ settings.foreground_color }} 6%,
      transparent
    );
    --color-success-border: color-mix(
      in srgb,
      {{ settings.foreground_color }} 14%,
      transparent
    );
    --color-error-bg: color-mix(
      in srgb,
      {{ settings.foreground_color }} 6%,
      transparent
    );
    --color-error-border: color-mix(
      in srgb,
      {{ settings.foreground_color }} 16%,
      transparent
    );
    --color-accent-tint-12: color-mix(
      in srgb,
      {{ settings.accent_color }} 12%,
      transparent
    );
    --color-accent-tint-35: color-mix(
      in srgb,
      {{ settings.accent_color }} 35%,
      transparent
    );
    --color-social-hover: {{ settings.accent_color }};
    --color-social-hover-contrast: {{ settings.accent_contrast }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --radius: {{ settings.input_corner_radius }}px;
    --shadow-soft: 0 12px 40px color-mix(
      in srgb,
      {{ settings.foreground_color }} 8%,
      transparent
    );
    --transition: 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
{% endstyle %}
