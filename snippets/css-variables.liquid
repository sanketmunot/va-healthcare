{% style %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-contrast: {{ settings.accent_contrast }};
    --color-surface: {{ settings.surface_color }};
    --color-muted: {{ settings.muted_color }};
    --color-border: {{ settings.border_color }};
    --color-surface-hover: color-mix(
      in srgb,
      {{ settings.accent_color }} 8%,
      {{ settings.surface_color }}
    );
    --color-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 12%,
      transparent
    );
    --color-footer-bg: {{ settings.foreground_color }};
    --color-footer-bg-deep: color-mix(
      in srgb,
      {{ settings.foreground_color }} 82%,
      {{ settings.accent_color }}
    );
    --color-on-dark: {{ settings.surface_color }};
    --color-on-dark-muted: color-mix(
      in srgb,
      {{ settings.surface_color }} 64%,
      transparent
    );
    --color-on-dark-subtle: color-mix(
      in srgb,
      {{ settings.surface_color }} 52%,
      transparent
    );
    --color-on-dark-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 10%,
      transparent
    );
    --color-body-glow: color-mix(
      in srgb,
      {{ settings.accent_color }} 12%,
      transparent
    );
    --color-body-glow-alt: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-bg-start: color-mix(
      in srgb,
      {{ settings.foreground_color }} 88%,
      {{ settings.accent_color }}
    );
    --color-newsletter-bg-mid: color-mix(
      in srgb,
      {{ settings.foreground_color }} 45%,
      {{ settings.accent_color }}
    );
    --color-newsletter-bg-end: {{ settings.accent_color }};
    --color-newsletter-text: {{ settings.surface_color }};
    --color-newsletter-text-muted: color-mix(
      in srgb,
      {{ settings.surface_color }} 78%,
      transparent
    );
    --color-newsletter-text-soft: color-mix(
      in srgb,
      {{ settings.surface_color }} 82%,
      transparent
    );
    --color-newsletter-text-faint: color-mix(
      in srgb,
      {{ settings.surface_color }} 62%,
      transparent
    );
    --color-newsletter-text-subtle: color-mix(
      in srgb,
      {{ settings.surface_color }} 52%,
      transparent
    );
    --color-newsletter-text-strong: color-mix(
      in srgb,
      {{ settings.surface_color }} 86%,
      transparent
    );
    --color-newsletter-eyebrow: color-mix(
      in srgb,
      {{ settings.surface_color }} 75%,
      {{ settings.accent_color }}
    );
    --color-newsletter-accent-glow: color-mix(
      in srgb,
      {{ settings.accent_color }} 22%,
      transparent
    );
    --color-newsletter-glow-one: color-mix(
      in srgb,
      {{ settings.accent_color }} 12%,
      transparent
    );
    --color-newsletter-glow-two: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-grid-line: color-mix(
      in srgb,
      {{ settings.surface_color }} 8%,
      transparent
    );
    --color-newsletter-mask: color-mix(
      in srgb,
      {{ settings.foreground_color }} 80%,
      transparent
    );
    --color-newsletter-glass-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 18%,
      transparent
    );
    --color-newsletter-glass-border-soft: color-mix(
      in srgb,
      {{ settings.surface_color }} 14%,
      transparent
    );
    --color-newsletter-glass-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 8%,
      transparent
    );
    --color-newsletter-glass-bg-medium: color-mix(
      in srgb,
      {{ settings.surface_color }} 10%,
      transparent
    );
    --color-newsletter-glass-bg-strong: color-mix(
      in srgb,
      {{ settings.surface_color }} 12%,
      transparent
    );
    --color-newsletter-glass-bg-focus: color-mix(
      in srgb,
      {{ settings.surface_color }} 14%,
      transparent
    );
    --color-newsletter-glass-inset: color-mix(
      in srgb,
      {{ settings.surface_color }} 10%,
      transparent
    );
    --color-newsletter-icon-stroke: color-mix(
      in srgb,
      {{ settings.surface_color }} 85%,
      {{ settings.accent_color }}
    );
    --color-newsletter-input-icon: color-mix(
      in srgb,
      {{ settings.surface_color }} 55%,
      transparent
    );
    --color-newsletter-focus-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 65%,
      {{ settings.accent_color }}
    );
    --color-newsletter-focus-ring: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-card-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 20%,
      transparent
    );
    --color-newsletter-btn-bg: {{ settings.surface_color }};
    --color-newsletter-btn-text: color-mix(
      in srgb,
      {{ settings.foreground_color }} 85%,
      {{ settings.accent_color }}
    );
    --color-newsletter-btn-hover: color-mix(
      in srgb,
      {{ settings.surface_color }} 92%,
      {{ settings.accent_color }}
    );
    --color-newsletter-btn-shadow: color-mix(
      in srgb,
      {{ settings.foreground_color }} 22%,
      transparent
    );
    --color-newsletter-bulk-btn-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 96%,
      {{ settings.accent_color }}
    );
    --color-newsletter-bulk-btn-text: color-mix(
      in srgb,
      {{ settings.foreground_color }} 90%,
      {{ settings.accent_color }}
    );
    --color-newsletter-success-text: color-mix(
      in srgb,
      {{ settings.surface_color }} 84%,
      {{ settings.accent_color }}
    );
    --color-newsletter-success-bg: color-mix(
      in srgb,
      {{ settings.accent_color }} 10%,
      transparent
    );
    --color-newsletter-success-border: color-mix(
      in srgb,
      {{ settings.accent_color }} 18%,
      transparent
    );
    --color-newsletter-error-text: color-mix(
      in srgb,
      {{ settings.surface_color }} 88%,
      {{ settings.accent_contrast }}
    );
    --color-newsletter-error-bg: color-mix(
      in srgb,
      {{ settings.surface_color }} 8%,
      transparent
    );
    --color-newsletter-error-border: color-mix(
      in srgb,
      {{ settings.surface_color }} 15%,
      transparent
    );
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --radius: {{ settings.input_corner_radius }}px;
    --shadow-soft: 0 12px 40px color-mix(
      in srgb,
      {{ settings.foreground_color }} 8%,
      transparent
    );
    --transition: 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
{% endstyle %}
