[
  {
    "name": "theme_info",
    "theme_name": "VA Wellness",
    "theme_version": "1.0.0",
    "theme_author": "VA Healthcare",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "assistant_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "domine_n4",
        "label": "Heading font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "72rem", "label": "Narrow" },
          { "value": "80rem", "label": "Standard" },
          { "value": "90rem", "label": "Wide" }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Page margin",
        "default": 24
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F4F7F5",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1C2B26",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#2F6B57",
        "label": "Accent"
      },
      {
        "type": "color",
        "id": "accent_contrast",
        "default": "#FFFFFF",
        "label": "Accent contrast"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#FFFFFF",
        "label": "Surface"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#5E736A",
        "label": "Muted text"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#D5E0DA",
        "label": "Border"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 10
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_card_show_quick_add",
        "label": "Show quick add",
        "default": true
      }
    ]
  }
]
